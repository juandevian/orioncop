<src:ClsFormInterface x:Class="WinClientes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    Title="WinClientes" Height="600" Width="800" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Window.Resources>
        <!--Menues Contextuales-->
        <ContextMenu x:Key="RecMnuPrediosClienteMC">
            <MenuItem x:Name="MnuAbrirPredioC" Header="Abrir Predio" 
        		Click="MnuContextual_Click"
        		Style="{StaticResource RecMnuItemSec}"/>
        </ContextMenu>
    </Window.Resources>
    <Grid x:Name="grdPpal" ButtonBase.Click="OnBotonClic" LostFocus="OnPierdeFoco" 
		GotFocus="OnCogerFoco" Selector.SelectionChanged="OnCboCambio">
        <Grid.RowDefinitions>
            <RowDefinition Height="95"  x:Name="rwdControl"/>
            <RowDefinition MinHeight="200" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel x:Name="PanelControl" Grid.Row="0" MenuItem.Click="OnMenuClic">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones y Titulo-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
				VerticalAlignment="Center" IsTabStop="False"/>
        </DockPanel>
        <Grid Grid.Row="1" Button.Click="OnBotonClic" >
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="500*"/>
            </Grid.RowDefinitions>
            <GridSplitter Grid.Row="1"  Background="Gray" HorizontalAlignment="Stretch" 
				IsTabStop="False" VerticalAlignment="Top"
				Height="2" Opacity=".5"/>
            <Canvas x:Name="Encabezado" Grid.Row="0">
                <Label x:Name="lblNroDoc" Content="Número de Documento" Canvas.Left="30" 
                       Canvas.Top="3" Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                <TextBox x:Name="txtNroDoc" Canvas.Left="30" Canvas.Top="20" Width="120" 
					TabIndex="1"/>
                <Label x:Name="lblTipoDoc" Content="Tipo de Documento" Canvas.Left="170" Canvas.Top="3" 
					Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                <ComboBox x:Name="cboTipoDoc" Canvas.Left="170" Canvas.Top="20" Width="170"  
                          Padding="6,1,1,1" TabIndex="2" />
                <Label x:Name="lblDigitoVerificacion" Content="D.V." Canvas.Left="360" 
                       Canvas.Top="3" Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                <TextBox x:Name="txtDigVer" Canvas.Left="360" Canvas.Top="20" 
                         Width="15" TabIndex="3"/>
                <Label x:Name="lblTipoTercero" Content="Tipo Tercero" 
                               Canvas.Left="400" Canvas.Top="3" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                <ComboBox x:Name="cboTipoTercero" Canvas.Left="400" 
                                          Canvas.Top="20" Width="170" TabIndex="4" 
                                          Padding="6,1,1,1" />
                <Label x:Name="lblMedPagoPreferido" Canvas.Left="600" Canvas.Top="3" 
                               Content="Medio de Pago Preferido" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                <ComboBox x:Name="cboMedPagoPref" Canvas.Left="600" Canvas.Top="20" Width="160"  
                                  Padding="6,1,1,1" ItemsSource="{Binding}" TabIndex="5"/>
                <Label x:Name="lblNomCompleto" Content="Nombre Completo" Canvas.Left="30" 
                       Canvas.Top="46" Style="{StaticResource RecFuenteNormal}"
					    Padding="0"/>
                <Label x:Name="txtNombreCompleto" Canvas.Left="170" Canvas.Top="45"
                       Width="460" Style="{StaticResource RecTxtSoloLectura}"/>
            </Canvas>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="300"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TabControl x:Name="tbcTerceros" Grid.Column="0" Style="{StaticResource RecTabCtrl}"
                            IsTabStop="True" TabIndex="6" Margin="5,10,5,5" >
                    <TabItem x:Name="tbiId" Header="Datos Generales" IsTabStop="True"
                         Style="{StaticResource RecTabItem}" Width="200" TabIndex="7">
                        <Canvas x:Name="cnvId" Grid.Row="1">
                            <GroupBox x:Name="grbDatosPersonas" Header="Conformación Nombre" 
                                      Width="280" Height="160" Canvas.Left="20" Canvas.Top="10"
                                      IsTabStop="False" Style="{StaticResource RecFuenteNormal}">
                                <Canvas>
                                    <Label x:Name="lblApellido1" Content="Primer Apellido" 
                                       Canvas.Left="10" Canvas.Top="16" Padding="0"/>
                                    <TextBox x:Name="txtApellido1" Canvas.Left="130" 
                                         Width="130" Canvas.Top="15" TabIndex="10" />
                                    <Label x:Name="lblApellido2" Content="Segundo Apellido" 
                                       Canvas.Left="10" Canvas.Top="46" Padding="0"/>
                                    <TextBox x:Name="txtApellido2" Canvas.Left="130" 
                                         Width="130" Canvas.Top="45" TabIndex="11"/>
                                    <Label x:Name="lblNombre1" Content="Primer Nombre" 
                                       Canvas.Left="10" Canvas.Top="76" Padding="0"/>
                                    <TextBox x:Name="txtNombre1" Canvas.Left="130" 
                                         Canvas.Top="75" Width="130" TabIndex="12" />
                                    <Label x:Name="lblNombre2" Content="Segundo Nombre" 
                                       Canvas.Left="10" Canvas.Top="106" Padding="0"/>
                                    <TextBox x:Name="txtNombre2" Canvas.Left="130" 
                                         Canvas.Top="105" Width="130" TabIndex="13"/>
                                </Canvas>
                            </GroupBox>
                            <GroupBox x:Name="grbDatosEmpresas" Header="Datos Empresa" 
                                  Width="280" Height="160" Canvas.Left="20" 
                                  Canvas.Top="10" IsTabStop="False" 
                                  Style="{StaticResource RecFuenteNormal}" d:IsHidden="True">
                                <Canvas>
                                    <Label x:Name="lblRazonSocial" Content="Razón Social" 
                                       Canvas.Left="10" Canvas.Top="20" Padding="0"/>
                                    <TextBox x:Name="txtRazonSocial" Canvas.Left="10" 
                                         Canvas.Top="40" Width="250" Height="72" 
                                         HorizontalAlignment="Left" TextAlignment="Justify" 
                                         TextWrapping="Wrap" TabIndex="10"/>
                                </Canvas>
                            </GroupBox>
                            <CheckBox x:Name="chkFacturarSer" Content="Facturar porServicio" 
                                      Canvas.Left="330"  Canvas.Top="20" Padding="10,0,0,0" 
                                      Style="{StaticResource RecFuenteNormal}" TabIndex="15" />
                            <Label x:Name="lblComentario" Content="Comentario" 
                                   Canvas.Left="330" Canvas.Top="41" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}" />
                            <TextBox x:Name="txtComentario" Width="230" Canvas.Left="330" 
                                     Canvas.Top="60" Height="77" TextAlignment="Justify" 
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource RecFuenteNormal}" TabIndex="16"/>
                            <Label x:Name="lblRegimenVentas" Content="Régimen _Ventas (IVA)" 
                                   Canvas.Left="20" Canvas.Top="182" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <ComboBox x:Name="cboRegimenVentas" Width="160" 
                                      Canvas.Left="145" Canvas.Top="180" 
                                      Padding="6,1,1,1" ItemsSource="{Binding}" TabIndex="17"/>
                            <CheckBox x:Name="chkGranCont" Content="Gran Contribuyente" 
                                      Canvas.Left="20" Canvas.Top="210"  Padding="10,0,0,0" 
                                      Style="{StaticResource RecFuenteNormal}" TabIndex="19"/>
                            <CheckBox x:Name="chkAutoRet" Content="Autorretenedor" 
                                      Canvas.Left="20" Canvas.Top="235"  Padding="10,0,0,0" 
                                      Style="{StaticResource RecFuenteNormal}" TabIndex="20"/>
                            <CheckBox x:Name="chkAgenteRetIca" Content="Agente de retención de Industria Y Comercio" 
                                      Style="{StaticResource RecFuenteNormal}" 
                                      Canvas.Left="20" Canvas.Top="260" Padding="10,0,0,0" 
                                      TabIndex="20" Height="22"/>
                            <CheckBox x:Name="chkRegSimpleTri" Content="Régimen simple de tributación" 
                                      Style="{StaticResource RecFuenteNormal}" 
                                      Canvas.Left="330" Canvas.Top="180" Padding="10,0,0,0" 
                                      TabIndex="18"/>
                            <CheckBox x:Name="chkAgenteRetFte" Content="Agente de retención en la Fuente" 
                                      Canvas.Left="330" Canvas.Top="235"  Padding="10,0,0,0" 
                                      Style="{StaticResource RecFuenteNormal}" TabIndex="21"/>
                            <CheckBox x:Name="chkRetieneIva" Content="Agente de retención IVA" 
                                      Style="{StaticResource RecFuenteNormal}" 
                                      Canvas.Left="330" Canvas.Top="260" Padding="10,0,0,0" 
                                      TabIndex="23"/>
                        </Canvas>
                    </TabItem>
                    <TabItem x:Name="tbiLocaliza" Header="Localización" 
                         Style="{StaticResource RecTabItem}" Width="200" TabIndex="25">
                        <Canvas x:Name="cnvLocaliza" Grid.Row="1">
                            <Label x:Name="lblDireccion1" Content="Dirección 1" Canvas.Left="20" 
                               Canvas.Top="132" Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtDireccion1" Canvas.Left="112" Canvas.Top="130" 
                                 Width="448" TabIndex="5"/>
                            <Label x:Name="lblDireccion2" Content="Dirección 2" Canvas.Left="20" 
                               Canvas.Top="162" Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtDireccion2" Canvas.Left="112" Canvas.Top="160" Width="448" 
                                 TabIndex="6"/>
                            <Label x:Name="lblPaisDir" Content="País" Canvas.Left="20" Canvas.Top="13" 
                               Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                            <ComboBox x:Name="cboPaisDir" Canvas.Left="110" Canvas.Top="10" Width="160"
                                  Padding="6,1,1,1" TabIndex="1"/>
                            <Label x:Name="lblDptoDir" Content="Departamento" Canvas.Left="20" 
                               Canvas.Top="43" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                            <ComboBox x:Name="cboDptoDir" Canvas.Left="110" Canvas.Top="40" 
                                  Width="160" Padding="6,1,1,1" TabIndex="2"/>
                            <Label x:Name="lblCiudadDir" Content="Ciudad" Canvas.Left="20" 
                               Canvas.Top="73" Padding="0" 
                               Style="{StaticResource RecFuenteNormal}"/>
                            <ComboBox x:Name="cboCiudadDir" Canvas.Left="110" Canvas.Top="70" 
                                  Width="160" Padding="6,1,1,1" TabIndex="3"/>
                            <Label x:Name="lblCodPostal" Content="Código Postal" Canvas.Left="20" 
                               Canvas.Top="103" Padding="0" 
                               Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtCodPostal" Canvas.Left="110" Canvas.Top="101" Width="160" 
                                     Height="20" TabIndex="4"/>
                            <Label x:Name="lblMovil" Content="Telefono Celular 1" Canvas.Left="340" 
                                   Canvas.Top="13" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtMovil" Canvas.Left="450" Canvas.Top="10" Width="110"  
                                 TabIndex="7" />
                            <Label x:Name="lblMovil2" Content="Telefono Celular 2" Canvas.Left="340" 
                               Canvas.Top="43" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtMovil2" Canvas.Left="450" Canvas.Top="40" Width="110"  
                                 TabIndex="8"/>
                            <Label x:Name="lblTelefono1" Content="Telefono Fijo 1" 
                               Canvas.Left="340" Canvas.Top="72" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtTelefono1" Canvas.Left="450" Canvas.Top="70" 
                                 Width="110"  TabIndex="9"/>
                            <Label x:Name="lblTelefono2" Content="Telefono Fijo 2" 
                               Canvas.Left="340" Canvas.Top="102" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtTelefono2" Canvas.Left="450" Canvas.Top="100" 
                                 Width="110" TabIndex="10"/>
                            <Label x:Name="lblEmail" Content="Cuenta eMail" Canvas.Left="20" 
                               Canvas.Top="193" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtEmail" Canvas.Left="110" Canvas.Top="190" 
                                 Width="450" TabIndex="11"/>
                            <CheckBox x:Name="chkRecibeDocsEmail" Canvas.Left="20"  Canvas.Top="235"
                                      Content="Acepta recibir Documentos vía Correo Electrónico" 
                                      Padding="10,0,0,0"
                                      Style="{StaticResource RecFuenteNormal}" TabIndex="12"/>
                            <Label x:Name="lblOutlook" Canvas.Top="211" Canvas.Left="112" Padding="0"
                               Content="@outlook.com" Style="{StaticResource RecFuenteNormal}"
                               ToolTip="Doble clic aqui para agregar servidor"/>
                            <Label x:Name="lblGmail" Canvas.Top="211" Canvas.Left="222" Padding="0"
                               Content="@gmail.com" Style="{StaticResource RecFuenteNormal}"
                               ToolTip="Doble clic aqui para agregar servidor"/>
                            <Label x:Name="lblHotmail" Canvas.Top="211" Canvas.Left="327" Padding="0"
                               Content="@hotmail.com" Style="{StaticResource RecFuenteNormal}"
                               ToolTip="Doble clic aqui para agregar servidor"/>
                            <Label x:Name="lblYahoo" Canvas.Top="211" Canvas.Left="449" Padding="0"
                               Content="@yahoo.com" Style="{StaticResource RecFuenteNormal}"
                               ToolTip="Doble clic aqui para agregar servidor"/>
                            <Label x:Name="lblPaginaWeb" Content="Página Web" Canvas.Left="20" 
                               Canvas.Top="267" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtPaginaWeb" Canvas.Left="110" Canvas.Top="265" 
                                 Width="450" TabIndex="13"/>
                        </Canvas>
                    </TabItem>
                </TabControl>
                <Canvas Grid.Column="1">
                    <Label x:Name="lblPrediosDelCliente" Content="Predios del Cliente" Canvas.Left="10"
                           Canvas.Top="21" Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                    <ListBox x:Name="lsbPrediosDelCliente" Canvas.Left="10"  Canvas.Top="37"
                             Width="175" Height="161" SelectionMode="Single" Background="Transparent"
                             ToolTip="Para abrir un predio, seleccionelo y luego de Clic Derecho!"
                             TabIndex="20">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="FontWeight" Value="ExtraBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Label x:Name="lblFechaIngreso" Content="Fecha de Ingreso" 
                           Canvas.Left="10" Canvas.Top="210" Padding="0"
                           Style="{StaticResource RecFuenteNormal}"/>
                    <Label x:Name="txtFechaIngreso" Width="175" Canvas.Left="10" Canvas.Top="225" 
                           Style="{StaticResource RecTxtSoloLectura}" />
                    <Label x:Name="lblEstadoActualDeuda" Content="Estado Actual de la Deuda" 
                           Canvas.Left="10" Canvas.Top="250" Padding="0"
                           Style="{StaticResource RecFuenteNormal}"/>
                    <ComboBox x:Name="cboEstadoActualDeuda" Width="175" Canvas.Left="10" 
                              Canvas.Top="265" Padding="6,1,1,1" ItemsSource="{Binding}" 
                              TabIndex="24"/>
                    <Label x:Name="lblEstadoSugeridoDeuda" Content="Estado Sugerido de la Deuda" 
                           Canvas.Left="10" Canvas.Top="290" Padding="0"
                           Style="{StaticResource RecFuenteNormal}"/>
                    <Label x:Name="txtEstadoSugeridoDeuda" Style="{StaticResource RecTxtSoloLectura}" 
                           Width="175" Canvas.Left="10" Canvas.Top="305" Padding="6,1,1,1"/>
                </Canvas>
            </Grid>
        </Grid>
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
			IsTabStop="False" HorizontalAlignment="Stretch"  
			Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvBotones" Grid.Row="0">
                <Button x:Name="bttAbrirCuenta" Canvas.Left="40"   Canvas.Top="6" 
					Padding="0" Margin="0" Width="225" Height="22" TabIndex="51"
					ToolTip="Abre la Cuenta del Cliente a quien se le esta facturando.">
                    <DockPanel Width="225">
                        <Image Source="RecImagenes/IrA.png" Width="17" Height="17" 
							HorizontalAlignment="Left" DockPanel.Dock="Left" Margin="3,0,0,0"/>
                        <Label Content="Consultar la Cuenta del Cliente" Background="Transparent" 
							Padding="0" DockPanel.Dock="Right" Margin="5,0,0,0"
							VerticalContentAlignment="Center" IsTabStop="False"/>
                    </DockPanel>
                </Button>
                <Button x:Name="bttAbrirTer" Canvas.Left="300" Canvas.Top="5" Padding="0" Margin="0"
					Width="170" Height="22" TabIndex="50" Visibility="Hidden">
                    <DockPanel Width="170">
                        <Image Source="RecImagenes/IrA.png" Width="18" Height="18" 
							HorizontalAlignment="Left" DockPanel.Dock="Left" Margin="3,0,0,0"/>
                        <Label Content="Abrir Ventana Tercero" Background="Transparent" Padding="0" 
							DockPanel.Dock="Right" Margin="5,0,0,0"
							VerticalContentAlignment="Center" IsTabStop="False"/>
                    </DockPanel>
                </Button>
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
