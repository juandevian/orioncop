<src:ClsFormInterface x:Class="WinIntegridad"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="Verifica Integridad" Height="480" Width="460" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid Name="grdPpal" Control.LostFocus="OnPierdeFoco" Button.Click="OnBotonClic"
          Control.GotFocus="OnCogerFoco">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" Name="rwdControl"/>
            <RowDefinition MinHeight="120"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  VerticalAlignment="Center" 
                        TabIndex="1"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Canvas Grid.Row="0">
                <Label x:Name="lblTitulo" Canvas.Left="40" Canvas.Top="10" Padding="0" 
                       Content="Verifica Integridad de los Datos ..." IsTabStop="False"
                       Background="Transparent" Foreground="Gray" FontSize="18" FontStyle="Italic"/>
                <Label x:Name="lblFechaDesde" Canvas.Left="83" Canvas.Top="49" 
						Content="Verificar Integridad entre el" Padding="0"/>
                <DatePicker x:Name="dtpFechaDesde" Canvas.Left="253" Canvas.Top="45" 
						Width="130" TabIndex="1"/>
                <Label x:Name="lblFechaHasta" Canvas.Left="209" Canvas.Top="79" 
						Content="y el" Padding="0"/>
                <DatePicker x:Name="dtpFechaHasta" Canvas.Left="253" Canvas.Top="75" 
						Width="130" TabIndex="2"/>
                <Label Canvas.Left="40" Canvas.Top="106" 
						Content="Incluir los siguientes Documentos:" Padding="0"/>
                <CheckBox x:Name="chkFac" Content="Facturas" Canvas.Left="50" Canvas.Top="125"  
                          Padding="10,0,0,0" Style="{StaticResource RecFuenteNormal}" 
                          TabIndex="3"/>
                <CheckBox x:Name="chkRec" Content="Recibos de Caja" Canvas.Left="187" Canvas.Top="125"  
                          Padding="10,0,0,0" Style="{StaticResource RecFuenteNormal}" 
                          TabIndex="4"/>
                <CheckBox x:Name="chkNCr" Content="Notas Crédito" Canvas.Left="310" Canvas.Top="125"  
                          Padding="10,0,0,0" Style="{StaticResource RecFuenteNormal}" 
                          TabIndex="5"/>
                <CheckBox x:Name="chkNdb" Content="Notas de Intereses" Canvas.Left="50" 
                          Canvas.Top="145"  Padding="10,0,0,0" 
                          Style="{StaticResource RecFuenteNormal}" TabIndex="6"/>
                <CheckBox x:Name="chkNco" Content="Notas de Aplicación de Anticipos" Canvas.Left="187" Canvas.Top="145"  
                          Padding="10,0,0,0" Style="{StaticResource RecFuenteNormal}" 
                          TabIndex="7"/>
                <CheckBox x:Name="chkAnt" Content="Anticipos" Canvas.Left="50" Canvas.Top="165"  
                          Padding="10,0,0,0" Style="{StaticResource RecFuenteNormal}" 
                          TabIndex="8"/>
                <CheckBox x:Name="chkNRRC" Content="Nota Rev. Cr" Canvas.Left="187" Canvas.Top="165"  
                          Padding="10,0,0,0" Style="{StaticResource RecFuenteNormal}" 
                          TabIndex="9"/>
                <CheckBox x:Name="chkEstadosCta" Content="Estados Cuenta" Canvas.Left="310" Canvas.Top="165"  
                          Padding="10,0,0,0" Style="{StaticResource RecFuenteNormal}" 
                          TabIndex="10"/>
                <CheckBox x:Name="chkTodos" Content="Todos" Canvas.Left="50" Canvas.Top="185"  
                          Padding="10,0,0,0" Style="{StaticResource RecFuenteNormal}" 
                          TabIndex="11"/>
                <Label Content="Proceso" Canvas.Left="40" Canvas.Top="211" Padding="0"/>
                <Label x:Name="txtProceso" Canvas.Left="160" Canvas.Top="210" Width="260" 
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                       HorizontalContentAlignment="Center"/>
                <ProgressBar x:Name="pgbAvance" Canvas.Left="40" Canvas.Top="235" Width="380" 
                             Height="15"/>
                <Label x:Name="lblAvance" Canvas.Left="40" Canvas.Top="250"
                       Width="380" Padding="0" Content="Elementos Procesados: 0 de 0" 
                       HorizontalContentAlignment="Left"/>
            </Canvas>

        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
