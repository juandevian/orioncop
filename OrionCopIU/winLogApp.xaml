<src:ClsFormInterface x:Class="WinLogApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="winLogApp" Height="580" Width="1100" WindowStyle="SingleBorderWindow" 
            WindowStartupLocation="CenterScreen" WindowState="Maximized" 
            Icon="RecImagenes/OrionLogo24.png">
    <Window.Resources>

    </Window.Resources>
    <Grid Name="grdPpal"
          Control.GotFocus="OnCogerFoco">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  VerticalAlignment="Center" 
                        TabIndex="1"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Grid x:Name="grdLog" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border  BorderThickness="3" BorderBrush="Gray" CornerRadius="10">
                    <Canvas Grid.Row="0" x:Name="cnvFiltros" >
                        <Label Canvas.Left="5" Canvas.Top="3" Content="Filtros" Padding="0"/>
                        <CheckBox x:Name="chkFechas" Canvas.Top="15" Canvas.Left="111" 
                                  Content="Filtrar por Fecha" Padding="10,0,0,0"
                                  TabIndex="2"/>
                        <Label Canvas.Left="10" Canvas.Top="40" Content="Desde" Padding="0"/>
                        <DatePicker x:Name="dtpDesde" Canvas.Left="50" Canvas.Top="40" 
                                    Width="100" Background="Transparent" Padding="0"
                                    TabIndex="3"/>
                        <Label Canvas.Left="160" Canvas.Top="40" Content="Hasta" Padding="0"/>
                        <DatePicker x:Name="dtpHasta" Canvas.Left="195" Canvas.Top="40" 
                                    Width="100" Background="Transparent" Padding="0"
                                    TabIndex="4"/>
                        <Rectangle Fill="Gray" Height="74" Canvas.Left="307" Stroke="Black" Canvas.Top="0" Width="1"/>
                        <CheckBox x:Name="chkTipo" Canvas.Top="15" Canvas.Left="316" 
                                  Content="Filtrar por Tipo Log" Padding="10,0,0,0"
                                  TabIndex="5"/>
                        <ComboBox x:Name="cboTipoLog" Canvas.Left="320" Canvas.Top="40" 
                                  Width="120" Background="Transparent" Padding="0"
                                  TabIndex="6"/>
                        <Rectangle Fill="Gray" Height="74" Canvas.Left="452" Stroke="Black" Canvas.Top="0" Width="1"/>
                        <CheckBox x:Name="chkClase" Canvas.Top="15" Canvas.Left="470" 
                                  Content="Filtrar por Clase" Padding="10,0,0,0"/>
                        <ComboBox x:Name="cboNombreClase" Canvas.Left="465" Canvas.Top="40" 
                                  Width="120" Background="Transparent" Padding="0"
                                  TabIndex="7"/>
                        <Rectangle Fill="Gray" Height="74" Canvas.Left="597" Stroke="Black" Canvas.Top="0" Width="1"/>
                        <CheckBox x:Name="chkDato" Canvas.Top="15" Canvas.Left="616" 
                                  Content="Filtrar por Dato" Padding="10,0,0,0" 
                                  ToolTip="Filtra por la columna Propiedad / Acción" TabIndex="8"/>
                        <ComboBox x:Name="cboNombreDato" Canvas.Left="610" Canvas.Top="40" 
                                  Width="120" Background="Transparent" Padding="0"
                                  TabIndex="9"/>
                        <Rectangle Fill="Gray" Height="74" Canvas.Left="743" Stroke="Black" Canvas.Top="0" Width="1"/>
                        <CheckBox x:Name="chkIdObjeto" Canvas.Top="15" Canvas.Left="758" 
                                  Content="Filtrar por Objeto" Padding="10,0,0,0"
                                  TabIndex="10"/>
                        <TextBox x:Name="txtIdObjeto" Canvas.Left="756" Canvas.Top="40" 
                                  Width="120" Background="Transparent" Padding="0"
                                 TabIndex="11"/>
                        <Rectangle Fill="Gray" Height="74" Canvas.Left="889" Stroke="Black" Canvas.Top="0" Width="1"/>
                        <CheckBox x:Name="chkUsuario" Canvas.Top="15" Canvas.Left="900" 
                                  Content="Filtrar por Usuario" Padding="10,0,0,0"
                                  TabIndex="12"/>
                        <ComboBox x:Name="cboUsuario" Canvas.Left="900" Canvas.Top="40" 
                                  Width="120" Background="Transparent" Padding="0"
                                  TabIndex="13"/>
                    </Canvas>
                </Border>
                <DataGrid Grid.Row="1" x:Name="dgrLogApp" AutoGenerateColumns="False"
                          VerticalScrollBarVisibility="Auto" IsEnabled="True"
                          HorizontalScrollBarVisibility="Auto" IsReadOnly="True" IsTabStop="True"
                          IsSynchronizedWithCurrentItem="True" 
                          SelectionMode="Single"  SelectionUnit="FullRow"
                          Background="Transparent" ItemsSource="{Binding}">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="LightGray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Fecha"  Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" 
                                             Text="{Binding Path=FechaCreacion,  StringFormat={}{0:dd/MM/yyyy hh:mm:ss}}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ordinal" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" IsReadOnly="True"
                                             Text="{Binding Path=IdLogApp}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Tipo Log" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" Text="{Binding Path=Dato}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Clase" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" Text="{Binding Path=NombreClase}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Propiedad / Acción" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" Text="{Binding Path=Nombre}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Objeto" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" Text="{Binding Path=IdObjeto}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Usuario" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                             Text="{Binding Path=IdUsuario}" 
                                             HorizontalAlignment="Left"  
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vlr. Anterior" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                             Text="{Binding Path=ValorAnterior}" 
                                             HorizontalAlignment="Right"  
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vlr. Nuevo" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                             Text="{Binding Path=ValorNuevo, StringFormat={}{0:c}}" 
                                             HorizontalAlignment="Right"  
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</src:ClsFormInterface>
