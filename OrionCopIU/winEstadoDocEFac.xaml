<Window x:Class="WinEstadoDocEFac"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12"
        Title="Estado de Documento de eFactura" Height="505" Width="740" Loaded="Window_Loaded">
    <Grid Name="grdPpal">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" Name="rwdControl"/>
            <RowDefinition MinHeight="120"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <Canvas Grid.Row="0">
            <Label x:Name="lblTipoDoc" Content="TIPO DE DOCUMENTO: " Canvas.Left="20" Canvas.Top="30" 
                   Padding="0" FontWeight="DemiBold"/>
        </Canvas>
        <Canvas Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="260"/>
                    <RowDefinition MinHeight="140"/>
                </Grid.RowDefinitions>
                <Canvas Grid.Row="0" x:Name="cnvFact" Visibility="Visible">
                    <Label Content="Número de la Factura:" Canvas.Left="80" Canvas.Top="21" Padding="0"/>
                    <Label x:Name="txtNroFac" Canvas.Left="250" Canvas.Top="20" Width="100"
                     Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Content="Id. Cliente" Canvas.Left="80" Canvas.Top="51" Padding="0"/>
                    <Label x:Name="txtIdCliente" Canvas.Left="250" Canvas.Top="50" Width="100"
                     Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Content="Nombre del Cliente:" Canvas.Left="80" Canvas.Top="81" Padding="0"/>
                    <Label x:Name="txtNombreCliente" Canvas.Left="250" Canvas.Top="80" Width="400"
                     Style="{StaticResource RecTxtSoloLectura}" />
                    <Label Content="Id. único de Documento:" Canvas.Left="80" Canvas.Top="111" Padding="0"/>
                    <Label x:Name="txtIdDocEFac" Canvas.Left="250" Canvas.Top="110" Width="400"
                     Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label x:Name="lblCodUni" Content="CUFE:" Canvas.Left="80" Canvas.Top="141" Padding="0"/>
                    <Label x:Name="txtCUFE" Canvas.Left="250" Canvas.Top="140" Width="400"
                   Style="{StaticResource RecTxtSoloLectura}"
                   FontSize="12"/>
                    <Label Content="Fecha del Estado:" Canvas.Left="80" Canvas.Top="171" Padding="0"/>
                    <Label x:Name="txtFechaEst" Canvas.Left="250" Canvas.Top="170" Width="160"
                     Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Content="Estado en API:" Canvas.Left="80" Canvas.Top="201" Padding="0"/>
                    <Label x:Name="txtEstadoEnAPI" Canvas.Left="250" Canvas.Top="200" Width="160"
                     Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Content="Estado en Aplicación:" Canvas.Left="80" Canvas.Top="231" Padding="0"/>
                    <Label x:Name="txtEstadoEnApp" Canvas.Left="250" Canvas.Top="230" Width="160"
                   Style="{StaticResource RecTxtSoloLectura}"/>
                </Canvas>
                <Canvas Grid.Row="0" x:Name="cnvNota" Visibility="Hidden">
                    <Label Content="Número de la Nota:" Canvas.Left="80" Canvas.Top="6" Padding="0"/>
                    <Label x:Name="txtNroNot" Canvas.Left="250" Canvas.Top="5" Width="100"
                     Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Content="Id. Cliente" Canvas.Left="80" Canvas.Top="31" Padding="0"/>
                    <Label x:Name="txtIdClienteNot" Canvas.Left="250" Canvas.Top="30" Width="100"
                     Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Content="Nombre del Cliente" Canvas.Left="80" Canvas.Top="56" Padding="0"/>
                    <Label x:Name="txtNombClienteNot" Canvas.Left="250" Canvas.Top="55" Width="400"
                     Style="{StaticResource RecTxtSoloLectura}" />
                    <Label Content="Id. único de Documento:" Canvas.Left="80" Canvas.Top="81" Padding="0"/>
                    <Label x:Name="txtIdDocENot" Canvas.Left="250" Canvas.Top="80" Width="400"
                     Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Content="CUDE:" Canvas.Left="80" Canvas.Top="106" Padding="0"/>
                    <Label x:Name="txtCUDE" Canvas.Left="250" Canvas.Top="105" Width="400"
                   Style="{StaticResource RecTxtSoloLectura}"
                   FontSize="12"/>
                    <Label Content="Numero de Factura Base:" Canvas.Left="80" Canvas.Top="131" Padding="0"/>
                    <Label x:Name="txtIdFacturaBase" Canvas.Left="250" Canvas.Top="130" Width="100"
                   Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Content="CUFE Factura Base:" Canvas.Left="80" Canvas.Top="156" Padding="0"/>
                    <Label x:Name="txtCUFEFacBase" Canvas.Left="250" Canvas.Top="155" Width="400"
                   Style="{StaticResource RecTxtSoloLectura}"
                   FontSize="12"/>
                    <Label Content="Fecha del Estado:" Canvas.Left="80" Canvas.Top="181" Padding="0"/>
                    <Label x:Name="txtFechaEstNot" Canvas.Left="250" Canvas.Top="180" Width="160"
                     Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Content="Estado en API:" Canvas.Left="80" Canvas.Top="206" Padding="0"/>
                    <Label x:Name="txtEstadoEnAPINot" Canvas.Left="250" Canvas.Top="205" Width="160"
                     Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Content="Estado en Aplicación:" Canvas.Left="80" Canvas.Top="231" Padding="0"/>
                    <Label x:Name="txtEstadoEnAppNot" Canvas.Left="250" Canvas.Top="230" Width="160"
                   Style="{StaticResource RecTxtSoloLectura}"/>
                </Canvas>
                <Canvas Grid.Row="1">
                    <Label Canvas.Left="5" Content="Listado Validaciones de la DIAN"
                           FontWeight="Bold"/>
                    <DataGrid  x:Name="dgrErroresDian" Canvas.Top="25"
                               IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                               ItemsSource="{Binding}" SelectionMode="Extended" 
                               SelectionUnit="FullRow" Background="Transparent"
                               IsReadOnly="True" TabIndex="5"
                               ScrollViewer.VerticalScrollBarVisibility="Visible"
                               ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                               Canvas.Left="5" Width="718" Height="100">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="LightGray"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Id." Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" 
                                                 IsTabStop="False" 
                                                 HorizontalAlignment="Left" 
                                                 Text="{Binding Id}" IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Código" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" 
                                                 IsTabStop="False" HorizontalAlignment="Left" 
                                                 Text="{Binding CodError}" IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Descripción" Width="600">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" 
                                                 IsTabStop="False" 
                                                 Text="{Binding Descripcion}" 
                                                 HorizontalAlignment="Left" IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Canvas>
            </Grid>
        </Canvas>
        <Canvas Grid.Row="2">
            <Button x:Name="bttCerrar" Content="_Cerrar" Style="{StaticResource RecBttAceCan}"
						Canvas.Right="40" Canvas.Top="8" TabIndex="200" />
        </Canvas>
    </Grid>
</Window>
