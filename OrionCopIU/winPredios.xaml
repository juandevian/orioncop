<src:ClsFormInterface x:Class="WinPredios"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    Title="Predios" Height="570" Width="800" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Window.Resources>
        <!--Menues Contextuales-->
        <ContextMenu x:Key="RecMnuPrediosAgruMC">
            <MenuItem x:Name="MnuAbrirPredioC" Header="Abrir Predio" Click="MnuContextual_Click"
        		Style="{StaticResource RecMnuItemSec}"/>
        </ContextMenu>
    </Window.Resources>
    <Grid x:Name="grdPpal" MenuItem.Click="OnMenuClic" ButtonBase.Click="OnBotonClic">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" x:Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel x:Name="PanelControl" Grid.Row="0">
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
                  VerticalAlignment="Center"/>
        </DockPanel>
        <Grid  Grid.Row="1" LostFocus="OnPierdeFoco" GotFocus="OnCogerFoco" 
               ComboBox.SelectionChanged="OnCboCambio">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition MinHeight="160"/>
            </Grid.RowDefinitions>
            <GridSplitter Grid.Row="1" Background="Gray" VerticalAlignment="Top"
                          IsTabStop="False" HorizontalAlignment="Stretch"
                          Height="2" Opacity=".5"/>
            <Canvas Grid.Row="0" x:Name="cnvGenerales">
                <Label x:Name="lblIdPredio" Canvas.Left="10" Canvas.Top="7"
                       Content="Id. Predio" Padding="0"/>
                <TextBox x:Name="txtIdPredio" Canvas.Left="100" Canvas.Top="5" Width="100"
                         TabIndex="1"/>
                <Label x:Name="lblNombrePredio" Canvas.Left="220" Canvas.Top="7"
                       Content="Nombre del Predio" Padding="0"/>
                <TextBox x:Name="txtNombrePredio" Canvas.Left="330" Canvas.Top="5" Width="200"
                         TabIndex="2" Height="19"/>
                <Label x:Name="lblPredioAgrupador" Canvas.Left="552" Canvas.Top="7"
                                   Content="Predio Agrupador" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                <TextBox x:Name="txtIdPredioAgr" Canvas.Left="660" Canvas.Top="5" 
                                 Width="110" TabIndex="3" Height="19"/>
                <Label x:Name="lblAliasCont" Canvas.Left="10" Canvas.Top="31" Content="Alias Contable"
                               Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                <TextBox x:Name="txtAliasCont" Canvas.Left="100" Canvas.Top="30" Width="100" 
                                 TabIndex="6" Height="18"/>
                <Label x:Name="lblRefPago" Canvas.Left="220" Canvas.Top="31" 
                       Content="Referencia pago" Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                <TextBox x:Name="txtRefPago" Canvas.Right="20" Canvas.Top="30" Width="120"
                         Canvas.Left="330" TabIndex="7"/>
                <Label x:Name="lblFichaCatastral"  Canvas.Left="10" Canvas.Top="56" 
                       Content="Ficha Catastral" Padding="0"/>
                <TextBox x:Name="txtFichaCatastral" Canvas.Left="100" Canvas.Top="55" Width="160"
                         TabIndex="8" Height="19"/>
                <Label x:Name="lblMatInmobiliaria" Canvas.Left="531" Canvas.Top="31" 
                       Content="Matricula Inmobiliaria" Padding="0"/>
                <TextBox x:Name="txtMatInmobiliaria" Canvas.Right="20" Canvas.Top="30" Width="110"
                         Canvas.Left="660" TabIndex="9"/>
            </Canvas>
            <Grid Grid.Row="1">
                <TabControl x:Name="tbcPredios" Grid.Row="1" Style="{StaticResource RecTabCtrl}" 
                            Margin="0,10,0,0">
                    <TabItem x:Name="tbiPropietarios" Header="Propietarios" 
                             Style="{StaticResource RecTabItem}" Width="180"
                             TabIndex="30" Margin="0,1,0,-0.667">
                        <Grid x:Name="grdPropietarios">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition MinHeight="80"/>
                            </Grid.RowDefinitions>
                            <Canvas Grid.Row="0">
                                <Label x:Name="lblPropietrios" Canvas.Left="320" 
                                       Canvas.Top="20" Padding="0" Content="Propietarios"/>
                            </Canvas>
                            <DataGrid Grid.Row="1" x:Name="dgrPropietarios"
                                      AutoGenerateColumns="False" Margin="95,0,100,5"
                                      VerticalScrollBarVisibility="Visible"
                                      IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding}"
                                      IsReadOnly="True" Background="Transparent" 
                                      Style="{StaticResource RecFuenteNormal}"
                                      IsTabStop="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Nro. Identificación" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" 
                                                         BorderThickness="0" IsReadOnly="True"
                                                         Text="{Binding IdTerceroPropietario}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Nombre" Width="340">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" 
                                                         BorderThickness="0" IsReadOnly="True"
                                                         Text="{Binding NombreCompleto}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="% Propiedad" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0"
                                                         HorizontalContentAlignment="Right"
                                                         Text="{Binding PorcentajeParticipacion, StringFormat=\{0:p\}}"
                                                         IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.CellStyle>
                                    <Style TargetType="{x:Type DataGridCell}">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="LightGray"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                            </DataGrid>
                            <Canvas Grid.Row="2" Margin="0,0,0,0">
                                <Button x:Name="bttVincularProp" Canvas.Left="95" Canvas.Top="10" 
                                        Width="160" Style="{StaticResource RecEstiloBttGen}"
                                        Height="24" TabIndex="2" >
                                    <DockPanel Width="158">
                                        <Label Content="Nuevo Propietario" Background="Transparent" 
                                               Padding="0" Margin="20,0,0,0" DockPanel.Dock="Left"
                                               VerticalContentAlignment="Center" IsTabStop="False"
                                               Style="{StaticResource RecFuenteNormal}"/>
                                        <Image Source="RecImagenes/nuevo.png" Width="20" 
                                                   Height="20" HorizontalAlignment="Right" 
                                                   DockPanel.Dock="Right" Margin="0,0,5,0"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="bttModificarProp" Canvas.Left="312" Canvas.Top="10" 
                                        Width="160" Style="{StaticResource RecEstiloBttGen}"
                                        TabIndex="3" Height="24">
                                    <DockPanel Width="158">
                                        <Label Content="Modificar % Propiedad" Background="Transparent"
                                               Padding="0" Margin="5,0,0,0" DockPanel.Dock="Left"
                                               VerticalContentAlignment="Center" IsTabStop="False"
                                               Style="{StaticResource RecFuenteNormal}"/>
                                        <Image Source="RecImagenes/modificar.png" Width="20" Height="20" 
            					HorizontalAlignment="Right" DockPanel.Dock="Right" 
            					Margin="0,0,5,0"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="bttDesvincularProp" Canvas.Left="530" Canvas.Top="10" 
                                        Width="160" Style="{StaticResource RecEstiloBttGen}"
                                        TabIndex="4" Height="24">
                                    <DockPanel Width="158">
                                        <Label Content="Eliminar propietario" Background="Transparent" 
                                               Padding="0" Style="{StaticResource RecFuenteNormal}"
                                               Margin="15,0,0,0" DockPanel.Dock="Left"
                                               VerticalContentAlignment="Center" IsTabStop="False"/>
                                        <Image Source="RecImagenes/suprimir.png" Width="20" 
                                               Height="20" HorizontalAlignment="Right" 
                                               DockPanel.Dock="Right" Margin="0,0,5,0"/>
                                    </DockPanel>
                                </Button>
                                <Label x:Name="lblNotaProp" Canvas.Top="40" Canvas.Left="97" 
                                       Padding="0" Foreground="White" Background="DarkGray"
                                       Content="  LA MODIFICACIÓN DE PROPIETARIOS SOLO SE PUEDE HACER EN PREDIOS AGRUPADORES  "/>
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tbiPredio" Header="Datos del Predio" 
                             Style="{StaticResource RecTabItem}" Width="180"
                             TabIndex="30">
                        <Canvas x:Name="cnvDatosPredio">
                            <Label x:Name="lblArea" Canvas.Left="20" Canvas.Top="12" Content="Area"
                               Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtArea" Canvas.Left="60" Canvas.Top="10" Width="100" 
                                 TabIndex="31" Height="20"/>
                            <Label x:Name="lblFactorPond" Canvas.Left="185" Canvas.Top="12"
                                   Content="Factor de ponderación coeficiente propiedad" 
                                   Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtFactorPond" Canvas.Left="445" Canvas.Top="10" 
                                     Width="55" TabIndex="32" Height="20"/>
                            <Label x:Name="lblCoefPropiedad" Canvas.Left="520" Canvas.Top="12" 
                                   Content="Coeficiente Propiedad" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <Label x:Name="txtCoefPro" Canvas.Left="645" Canvas.Top="10" 
                                   Padding="0" Width="120" Height="20"
                                   Style="{StaticResource RecTxtSoloLectura}"/>
                            <CheckBox x:Name="chkFacturarSer" Content="Facturar por Servicio " 
                                  Canvas.Left="20"  Canvas.Top="42" Padding="20,0,0,0" TabIndex="33"
                                  Style="{StaticResource RecFuenteNormal}"/>
                            <Label x:Name="lblEstadoSugeridoDeuda" Canvas.Left="270" Canvas.Top="42" 
                                   Content="Estado Sugerido de la Deuda" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <Label x:Name="txtEstadoSugerido" Canvas.Left="445" Canvas.Top="40"
                                   Width="120" Style="{StaticResource RecTxtSoloLectura}" Height="20"/>
                            <CheckBox x:Name="chkNoConsItemsFac" Content="No consolidar Items en Factura" 
                                  Canvas.Left="20"  Canvas.Top="72" Padding="20,0,0,0" TabIndex="34"
                                  Style="{StaticResource RecFuenteNormal}"/>
                            <Label x:Name="lblEstadoActualDeuda" Content="Estado Actual de la Deuda" 
                                   Canvas.Left="270" Canvas.Top="72" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <ComboBox x:Name="cboEstadoActualDeuda" Width="120" Canvas.Left="445" 
                                      Canvas.Top="70" Padding="6,1,1,1" 
                                      ItemsSource="{Binding}" TabIndex="35"/>
                            <Label x:Name="lblValorServicioID" Canvas.Left="20" Canvas.Top="102"
                                   Content="Valor del Servicio de Identificación" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtValorServicioId" Canvas.Left="270" Canvas.Top="100" 
                                     Width="100" HorizontalContentAlignment="Right" Padding="0,0,10,0"
                                     TabIndex="36" Height="20"/>
                            <Label x:Name="lblDestFact" Canvas.Left="20" Canvas.Top="132"
                                   Content="Destinatario de la Facturación" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <ComboBox x:Name="cboDestFact" Canvas.Left="190" Canvas.Top="130" Width="180"  
                                  Padding="6,1,1,1" ItemsSource="{Binding}" TabIndex="37"/>
                            <Label x:Name="lblSector" Canvas.Left="20" Canvas.Top="162"
                                   Content="Sector del Predio" Padding="0" 
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <ComboBox x:Name="cboSectores" Canvas.Left="190" Canvas.Top="160" 
                                      Width="180" Padding="6,1,1,1" TabIndex="38"/>
                            <Label x:Name="lblEMail" Canvas.Left="20" Canvas.Top="192" 
                                   Content="Dir. Correo Electrónico" Padding="0" 
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtEMailAdi" Canvas.Left="190" Canvas.Top="190" 
                                     Width="350" Padding="0,0,10,0" TabIndex="39"/>
                            <Label x:Name="lblComentarios" Canvas.Left="20" Canvas.Top="220" 
                                   Content="Comentarios" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtComentarios" Canvas.Left="190" Canvas.Top="220"
                                     Width="350" Height="32" HorizontalAlignment="Left" 
                                     TextAlignment="Justify" TextWrapping="Wrap" TabIndex="40"/>
                            <Label x:Name="lblPrediosAgrupados" Content="Predios Agrupados"  
                                   Canvas.Left="595" Canvas.Top="40" Padding="0" 
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <ListBox x:Name="lsbPrediosAgrupados" Canvas.Left="595" Canvas.Top="57"
                                 Width="170" Height="195" SelectionMode="Single" Background="Transparent"
                                 ToolTip="Para abrir un predio, seleccionelo y luego de Clic Derecho!"
                                 TabIndex="41" Style="{StaticResource RecFuenteNormal}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="FontWeight" Value="ExtraBold"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Canvas>
                    </TabItem>
                    <TabItem x:Name="tbiArrendatario" Header="Datos del Arrendatario" 
                             Style="{StaticResource RecTabItem}" Width="180"
                             TabIndex="45">
                        <Canvas x:Name="cnvArrendatario">
                            <Label x:Name="lblIdArrendatario" Canvas.Left="20" Canvas.Top="40" 
                                   Content="Id. Arrendatario" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <Button x:Name="bttEncontrarArren" Canvas.Left="170" Canvas.Top="40"
                                    Visibility="Collapsed" 
                                    Style="{StaticResource RecEstiloBttEnc}"
                                    TabIndex="46" ToolTip="Clic aqui para buscar El Cliente."/>
                            <TextBox x:Name="txtIdArrendatario" Canvas.Left="185" Canvas.Top="40" 
                                     Width="100" TabIndex="47"/>
                            <Label x:Name="lblNombreArrendatario" Canvas.Left="300" Canvas.Top="40" 
                                   Content="Nombre" Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                            <Label x:Name="txtNombreArrendatario" Canvas.Left="355" Canvas.Top="40" 
                                   Style="{StaticResource RecTxtSoloLectura}"  Width="330" Height="21"/>
                            <Label x:Name="lblIdRepLegalArrendatario" Canvas.Left="20" Canvas.Top="80" 
                                   Content="Id. Rep Legal Arrendatario" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <Button x:Name="bttEncontrarRepL" Canvas.Left="170" Canvas.Top="80"
                                    Style="{StaticResource RecEstiloBttEnc}"
                                    Visibility="Collapsed" TabIndex="48"
                                    ToolTip="Clic aqui para buscar El Cliente."/>
                            <TextBox x:Name="txtIdRepLegalArrendatario" Canvas.Left="185" Canvas.Top="80" 
                                     Width="100" TabIndex="49"/>
                            <Label x:Name="lblRepLegalArrendatario" Canvas.Left="300" Canvas.Top="80" 
                                   Content="Nombre" Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                            <Label x:Name="txtNombreRepLegalArrendatario" Canvas.Left="355" 
                                   Canvas.Top="80" Width="330"
                                   Style="{StaticResource RecTxtSoloLectura}" Height="21"/>
                            <Label x:Name="lblIdAdministrador" Canvas.Left="20" Canvas.Top="120" 
                                   Content="Id. Administrador" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <Button x:Name="bttEncontrarAdmin" Canvas.Left="170" Canvas.Top="120"
                                    Style="{StaticResource RecEstiloBttEnc}"
                                    Visibility="Collapsed" TabIndex="50"
                                    ToolTip="Clic aqui para buscar El Cliente."/>
                            <TextBox x:Name="txtIdAdministrador" Canvas.Left="185" 
                                     Canvas.Top="120" Width="100" TabIndex="51"/>
                            <Label x:Name="lblNomAdministrador" Canvas.Left="300" Canvas.Top="120" 
                                   Content="Nombre" Padding="0" 
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <Label x:Name="txtNomAdministrador" Canvas.Left="355" 
                                   Canvas.Top="120" Width="330" 
                                   Style="{StaticResource RecTxtSoloLectura}" Height="21"/>
                            <Label x:Name="lblNombreComercial" Canvas.Left="22" Canvas.Top="160" 
                                   Content="Nombre Comercial" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtNombreComercial" Canvas.Left="185" 
                                     Canvas.Top="161" Width="200" TabIndex="52"/>
                            <Label x:Name="lblMatriculaMercantil" Canvas.Left="20" Canvas.Top="200" 
                                   Content="Matricula Mercantil" Padding="0"
                                   Style="{StaticResource RecFuenteNormal}"/>
                            <TextBox x:Name="txtMatriculaMercantil" Canvas.Left="185" 
                                     Canvas.Top="200" Width="200" TabIndex="53"/>
                        </Canvas>
                    </TabItem>
                    <TabItem x:Name="tbiFacturas" Header="Facturas" Style="{StaticResource RecTabItem}" 
                             Width="180" TabIndex="60">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition MinHeight="100"/>
                            </Grid.RowDefinitions>
                            <Canvas Grid.Row="0">
                                <RadioButton x:Name="rdbVencidas" Canvas.Left="25" Canvas.Top="20" 
                                             Background="Transparent" Content="Facturas Activas"
                                             Padding="10,0,0,0" IsChecked="True" TabIndex="61"
                                             Style="{StaticResource RecFuenteNormal}"/>
                                <RadioButton x:Name="rdbTodas" Canvas.Left="175" Canvas.Top="20" 
                                             Background="Transparent" Content="Todas las Facturas" 
                                             Padding="10,0,0,0" TabIndex="62"
                                             Style="{StaticResource RecFuenteNormal}"/>
                                <RadioButton x:Name="rdbCanceladas" Canvas.Left="325" Canvas.Top="20" 
                                             Background="Transparent" Content="Facturas Canceladas" 
                                             Padding="10,0,0,0" TabIndex="63"
                                             Style="{StaticResource RecFuenteNormal}"/>
                                <RadioButton x:Name="rdbAnuladas" Canvas.Left="495" Canvas.Top="20" 
                                             Background="Transparent" Content="Facturas Anuladas" 
                                             Padding="10,0,0,0" TabIndex="64"
                                             Style="{StaticResource RecFuenteNormal}"/>
                            </Canvas>
                            <DataGrid Grid.Row="1" x:Name="dgrFacturas" AutoGenerateColumns="False"
                                      VerticalScrollBarVisibility="Visible" IsEnabled="True"
                                      HorizontalScrollBarVisibility="Auto" IsReadOnly="True" 
                                      IsTabStop="True" IsSynchronizedWithCurrentItem="True" 
                                      SelectionMode="Single"  SelectionUnit="FullRow"
                                      Background="Transparent" ItemsSource="{Binding}"
                                      Style="{StaticResource RecFuenteNormal}"
                                      Margin="5,0,7,5">
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="LightGray"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Nro. Factura"  Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Left" 
                                                         Text="{Binding NroFact}"
                                                         IsReadOnly="True" 
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Fecha Factura" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Left" 
                                                         IsReadOnly="True"
                                                         Text="{Binding FechaFactura, StringFormat={}{0:dd/MM/yyyy}}"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Fecha Vence" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Left" 
                                                         Text="{Binding FechaVencimiento, StringFormat={}{0:dd/MM/yyyy}}"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Detalle" Width="280">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Left" 
                                                         Text="{Binding Detalle}" IsReadOnly="True"
                                                         FontSize="9" VerticalContentAlignment="Center"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Valor" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Right" 
                                                         Text="{Binding Valor, StringFormat={}{0:c}}"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Saldo" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Right" 
                                                         Text="{Binding Saldo, StringFormat={}{0:c}}"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
			IsTabStop="False" HorizontalAlignment="Stretch"  
			Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvBotones" Grid.Row="0">
                <Button x:Name="bttAbrirCliente" Canvas.Left="60" Canvas.Top="6" 
                            Padding="0" Margin="0" Width="180" Height="22" TabIndex="70"
                            ToolTip="Abre la Ficha del Cliente a quien se le esta facturando.">
                    <DockPanel Width="180">
                        <Image Source="RecImagenes/IrA.png" Width="17" Height="17" 
                                HorizontalAlignment="Left" DockPanel.Dock="Left" Margin="3,0,0,0"/>
                        <Label Content="Abrir la Ficha del Cliente" Background="Transparent" Padding="0" 
                                DockPanel.Dock="Right" Margin="5,0,0,0"
                                VerticalContentAlignment="Center" IsTabStop="False"/>
                    </DockPanel>
                </Button>
                <Button x:Name="bttAbrirCuenta" Canvas.Left="260"   Canvas.Top="6" 
                            Padding="0" Margin="0" Width="220" Height="22" TabIndex="71"
                            ToolTip="Abre la Cuenta del Cliente a quien se le esta facturando.">
                    <DockPanel Width="220">
                        <Image Source="RecImagenes/IrA.png" Width="17" Height="17" 
                                HorizontalAlignment="Left" DockPanel.Dock="Left" Margin="3,0,0,0"/>
                        <Label Content="Consultar la Cuenta del Predio" Background="Transparent" 
