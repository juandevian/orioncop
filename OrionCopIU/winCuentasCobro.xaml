<src:ClsFormInterface x:Class="WinCuentasCobro"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="Cuentas Cobro" Height="580" Width="900" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid Name="grdPpal" Control.LostFocus="OnPierdeFoco"
          Control.GotFocus="OnCogerFoco">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  VerticalAlignment="Center" 
                        TabIndex="1"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition MinHeight="100"/>
            </Grid.RowDefinitions>
            <Canvas Grid.Row="0" x:Name="cnvEncabezado">
                <Label x:Name="lblIdCtaCobro" Content="Cuenta de Cobro Nro." Padding="0"
					Canvas.Left="35" Canvas.Top="10"/>
                <TextBox x:Name="txtNroCtaCobro" Canvas.Left="155" Canvas.Top="10" Width="50" 
					TabIndex="2" HorizontalContentAlignment="Right"/>
                <Label x:Name="lblIdCliente" Content="Cliente" Padding="0"
					Canvas.Left="225" Canvas.Top="10"/>
                <Label x:Name="txtIdCliente" Canvas.Left="275" Canvas.Top="10" Width="100"
                       Style="{StaticResource RecTxtSoloLectura}" />
                <Label x:Name="txtNombreCliente" Canvas.Left="385" Canvas.Top="10" Width="340"
					Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblPredioAgru" Content="Predio Agrupador" Padding="0"
					Canvas.Left="35" Canvas.Top="40"/>
                <Label x:Name="txtPredioAgr" Canvas.Left="155" Canvas.Top="40"
                           Width="220" Style="{StaticResource RecTxtSoloLectura}"/>
                <CheckBox x:Name="chkImprimirDetallado" Content="Imprimir la Cuenta de Cobro Detallada"
                          Canvas.Top="40" Canvas.Left="495" Padding="10,0,0,0" IsChecked="True"
                          Background="Transparent" TabIndex="2"/>
            </Canvas>
            <Canvas Grid.Row="1" x:Name="cnvEstadoCuenta">
                <Label Content="ESTADO DE LA CUENTA AL MOMENTO DE LA FACTURACION" Canvas.Top="5" Canvas.Left="5" 
                           FontWeight="Bold"/>
                <Label x:Name="lblFechaEstado" Canvas.Top="40" Canvas.Left="20" 
                           Padding="0" Content="Fecha del Estado"/>
                <Label x:Name="txtFechaEstado" Canvas.Left="120" Canvas.Top="40"
                           Width="100" Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblDeudaCapital" Canvas.Top="70" Canvas.Left="20" 
                           Padding="0" Content="Deuda de Capital"/>
                <Label x:Name="txtDeudaCapital" Canvas.Left="120" Canvas.Top="70"
                           Width="100" HorizontalContentAlignment="Right" 
                           Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblDeudaMora" Canvas.Top="70" Canvas.Left="260" 
                           Padding="0" Content="Deuda Intereses Mora"/>
                <Label x:Name="txtDeudaMora" Canvas.Left="390" Canvas.Top="70"
                           Width="100" HorizontalContentAlignment="Right" 
                           Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblTotalDeuda" Canvas.Top="70" Canvas.Left="535" 
                           Padding="0" Content="Total de la Deuda"/>
                <Label x:Name="txtTotalDeuda" Canvas.Left="640" Canvas.Top="70"
                           Width="100" HorizontalContentAlignment="Right" 
                           Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblFacturas" Canvas.Top="100" Canvas.Left="40" 
                           Padding="0" Content="Detalle de las Facturas con Saldo a la Fecha"/>
                <DataGrid x:Name="dgrFacturasEstado" Canvas.Left="10" Canvas.Top="120" Height="195"
                          IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                          ItemsSource="{Binding}" SelectionMode="Extended" SelectionUnit="FullRow"
                          IsReadOnly="True" Background="Transparent" TabIndex="9"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="LightGray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Pre." Width="30">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" Text="{Binding PrefijoFactViva}"
                                                         IsReadOnly="True" FontSize="10"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Id.Fac." Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" Text="{Binding IdFacturaViva}" 
                                                         IsReadOnly="True" FontSize="10"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Fec. Fact." Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Left" 
                                                         Text="{Binding FechaFactura, StringFormat={}{0:dd/MM/yyyy}}"
                                                         IsReadOnly="True" FontSize="10"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Detalle" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" Text="{Binding Detalle}"
                                                         IsReadOnly="True" FontSize="10"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Agrupador" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" Text="{Binding AgruSer}"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource RecFuenteNormal}"
                                                         FontSize="10"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Vlr. Item" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Right" 
                                                         Text="{Binding ValorItem, StringFormat={}{0:c}}"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Int. Mora" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Right" 
                                                         Text="{Binding ValorIntMora, StringFormat={}{0:c}}"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Créditos" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Right" 
                                                         Text="{Binding Creditos, StringFormat={}{0:c}}"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Saldo Item" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalAlignment="Right" 
                                                         Text="{Binding SaldoItemFac, StringFormat={}{0:c}}"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Canvas>
            <GridSplitter Grid.Row="1" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
