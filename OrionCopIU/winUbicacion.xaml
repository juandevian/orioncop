<src:ClsFormInterface x:Class="WinUbicacion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="winUbicacion" Height="580" Width="730" WindowStyle="SingleBorderWindow" 
            WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png">
    <Window.Resources>
    </Window.Resources>
    <Grid Name="grdPpal" MenuItem.Click="OnMenuClic">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  VerticalAlignment="Center" 
                        TabIndex="1"/>
        </DockPanel>
        <Grid Grid.Row="1" Control.LostFocus="OnPierdeFoco" Control.GotFocus="OnCogerFoco">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="300*"/>
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Background="Gray" VerticalAlignment="Stretch" 
                          IsTabStop="False" HorizontalAlignment="Left"
                          Width="2" Opacity=".5"/>
            <Canvas Grid.Column="0" >
                <Label x:Name="lblPais" Content="País"  Canvas.Left="20" Canvas.Top="10" Padding="0" 
                       TabIndex="2"/>
                <Label x:Name="txtPais" Content="" Width="170" Canvas.Left="110" Canvas.Top="10" 
                       TabIndex="3" 
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblDpto" Content="Departamento" Canvas.Left="20" Canvas.Top="35" 
                       Padding="0" TabIndex="4"/>
                <Label x:Name="txtDpto" Content="" Width="170" Canvas.Left="110" Canvas.Top="35" TabIndex="5" 
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblCiudad" Content="Ciudad" Canvas.Left="20" Canvas.Top="60" Padding="0" 
                       TabIndex="6"/>
                <Label x:Name="txtCiudad" Content="" Width="170" Canvas.Left="110" Canvas.Top="60" 
                       TabIndex="7" 
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblEstadoWin" Content="Estado Ventana" Canvas.Left="110" Canvas.Top="160" Padding="0" 
                       TabIndex="10"/>
                <Label x:Name="txtEstadoWin" Content="Consultando" Width="200" Canvas.Left="50" Canvas.Top="180" 
                       HorizontalContentAlignment="Center" FontWeight="Bold" Foreground="Blue" TabIndex="11" 
                       Style="{StaticResource RecTxtSoloLectura}"/>
            </Canvas>
            <Canvas Grid.Column="1" >
                <TabControl x:Name="tbcUbicacion" Canvas.Left="20" Canvas.Top="10" Width="380" Height="415"
                            Background="Transparent" IsTabStop="False" >
                    <TabItem x:Name="tbiPais" Header="Paises" TabIndex="12">
                        <Grid>
                            <Grid.RowDefinitions >
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Canvas Grid.Row="0">
                                <Label x:Name="lblIdPais" Content="Id. País" Canvas.Left="10" Canvas.Top="10" Padding="0"
                                         TabIndex="13"/>
                                <TextBox x:Name="txtIdPais" Text="{Binding Path=IdPais}" Width="80" Canvas.Left="120" Canvas.Top="10"
                                         TabIndex="14"/>
                                <TextBox x:Name="txtIdPaisNuevo" Visibility="Collapsed" Width="80" Canvas.Left="120" Canvas.Top="10"
                                         TabIndex="15"/>
                                <Label x:Name="lblNombrePais" Content="Nombre" Canvas.Left="10" Canvas.Top="40" Padding="0"
                                         TabIndex="16"/>
                                <TextBox x:Name="txtNombrePais" Text="{Binding Path=Nombre}" Width="200" Canvas.Left="120" 
                                         Canvas.Top="40" TabIndex="17"/>
                                <TextBox x:Name="txtNombrePaisNuevo" Visibility="Collapsed" Width="200" Canvas.Left="120" 
                                         Canvas.Top="40" TabIndex="18"/>
                            </Canvas>
                            <Canvas Grid.Row="1" Height="Auto">
                                <DataGrid x:Name="dgrPaises" Height="310" Canvas.Left="10" 
                                          VerticalScrollBarVisibility="Auto" 
                                          IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding}" 
                                          TabIndex="19">
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="LightGray"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                </DataGrid>
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tbiDpto" Header="Departamentos" TabIndex="20">
                        <Grid>
                            <Grid.RowDefinitions >
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Canvas Grid.Row="0">
                                <Label x:Name="lblIdDpto" Content="Id. Departamento" Canvas.Left="10" Canvas.Top="10" 
                                       Padding="0" TabIndex="21"/>
                                <TextBox x:Name="txtIdDpto" Text="{Binding Path=IdDepartamento}" Width="80" Canvas.Left="120" 
                                       Canvas.Top="10" TabIndex="22"/>
                                <TextBox x:Name="txtIdDptoNuevo" Visibility="Collapsed" Width="80" Canvas.Left="120" 
                                       Canvas.Top="10" TabIndex="23"/>
                                <Label x:Name="lblNombreDpto" Content="Nombre" Canvas.Left="10" Canvas.Top="40" Padding="0"
                                       TabIndex="24"/>
                                <TextBox x:Name="txtNombreDpto" Text="{Binding Path=Nombre}" Width="200" Canvas.Left="120" 
                                       TabIndex="25"  Canvas.Top="40"/>
                                <TextBox x:Name="txtNombreDptoNuevo" Visibility="Collapsed" Width="200" Canvas.Left="120" 
                                       TabIndex="26" Canvas.Top="40"/>
                            </Canvas>
                            <Canvas Grid.Row="1" Height="Auto">
                                <DataGrid x:Name="dgrDptos" Height="310" 
                                          IsSynchronizedWithCurrentItem="True" TabIndex="27"
                                          VerticalScrollBarVisibility="Auto" Canvas.Left="10" 
                                          ItemsSource="{Binding}">
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="LightGray"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                </DataGrid>
                            </Canvas>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tbiCiudad" Header="Ciudades" TabIndex="28">
                        <Grid>
                            <Grid.RowDefinitions >
                                <RowDefinition Height="70"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Canvas Grid.Row="0">
                                <Label x:Name="lblIdCiudad" Content="Id. Ciudad" Canvas.Left="10" Canvas.Top="10" Padding="0"
                                       TabIndex="29"/>
                                <TextBox x:Name="txtIdCiudad" Text="{Binding Path=IdCiudad}" Width="80" Canvas.Left="120" 
                                       TabIndex="30" Canvas.Top="10"/>
                                <TextBox x:Name="txtIdCiudadNueva" Visibility="Collapsed" Width="80" Canvas.Left="120" 
                                       TabIndex="31" Canvas.Top="10"/>
                                <Label x:Name="lblNombreCiudad" Content="Nombre" Canvas.Left="10" Canvas.Top="40" Padding="0"
                                       TabIndex="32"/>
                                <TextBox x:Name="txtNombreCiudad" Text="{Binding Path=Nombre}" Width="200" Canvas.Left="120" 
                                        TabIndex="33" Canvas.Top="40"/>
                                <TextBox x:Name="txtNombreCiudadNueva" Visibility="Collapsed" Width="200" Canvas.Left="120" 
                                         TabIndex="34" Canvas.Top="40"/>
                            </Canvas>
                            <Canvas Grid.Row="1" Height="Auto">
                                <DataGrid x:Name="dgrCiudades" Height="310" 
                                          IsSynchronizedWithCurrentItem="True"
                                          VerticalScrollBarVisibility="Auto" Canvas.Left="10" 
                                          ItemsSource="{Binding}"
                                          TabIndex="35">
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="LightGray"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                </DataGrid>
                            </Canvas>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Canvas>
        </Grid>
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
        </Grid>
    </Grid>
</src:ClsFormInterface>
