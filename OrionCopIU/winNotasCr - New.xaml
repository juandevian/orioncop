<src:ClsFormInterface
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="WinNotasCr"
    Title="winNotasCr" Height="620" Width="880" WindowStyle="SingleBorderWindow"
            WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png">
    <Grid x:Name="grdPpal" LostFocus="OnPierdeFoco" ButtonBase.Click="OnBotonClic" 
          MenuItem.Click="OnMenuClic" GotFocus="OnCogerFoco" 
          Selector.SelectionChanged="OnCboCambio">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" x:Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel x:Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray" 
                  VerticalAlignment="Center"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition MinHeight="100"/>
            </Grid.RowDefinitions>
            <Canvas Grid.Row="0" x:Name="cnvEncabezado">
                <Label x:Name="lblIdNotaCr" Content="Id." Padding="0"
                		Canvas.Left="15" Canvas.Top="11"/>
                <Border Canvas.Left="60" Canvas.Top="7" BorderBrush="Gray" BorderThickness="1" 
                            CornerRadius="0" Width="214" Height="24">
                    <Canvas>
                        <Label x:Name="lblPref" Content="Pref." Padding="0"
                                   Canvas.Left="2" Canvas.Top="3" />
                        <ComboBox x:Name="cboPref" Canvas.Left="30" Canvas.Top="1" Width="58"
                                     TabIndex="1" Height="19"/>
                        <Label x:Name="lblIdNota" Content="Número" Padding="0"
                               Canvas.Left="100" Canvas.Top="3" />
                        <TextBox x:Name="txtIdNota" Canvas.Left="150" Canvas.Top="1" 
                                 Width="60" HorizontalContentAlignment="Right" TabIndex="2" />
                    </Canvas>
                </Border>
                <Label x:Name="lblFechaNotaCr" Content="Fecha" Padding="0"
					Canvas.Left="700" Canvas.Top="11" FontWeight="Bold"/>
                <DatePicker x:Name="dtpFechaNotaCr" Canvas.Left="745" Canvas.Top="7" 
                            Width="110" FontWeight="Bold" 
                            HorizontalContentAlignment="Right" TabIndex="3"/>
                <Label x:Name="lblIdCliente" Content="Cliente" Padding="0"
					Canvas.Left="15" Canvas.Top="41"/>
                <Button x:Name="bttEncontrarCliente" Canvas.Left="60" Canvas.Top="40"
                        Style="{StaticResource RecEstiloBttEnc}"
                        Visibility="Visible" TabIndex="4"
                        ToolTip="Clic aqui para buscar El Cliente."/>
                <TextBox x:Name="txtIdCliente" Canvas.Left="75" Canvas.Top="40" Width="80"
                         ToolTip="Digite el signo de interrogación (?) para buscar el Cliente!"
                         TabIndex="5"/>
                <Label x:Name="txtNombreCliente" Canvas.Left="160" Canvas.Top="40" Width="370
                       "
					Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblPredioAgru" Content="Predio Agrupador" Padding="0"
					Canvas.Left="20" Canvas.Top="71"/>
                <ComboBox x:Name="cboPredioAgru" Width="120" Canvas.Left="160" Canvas.Top="70" 
                          Padding="6,1,1,1"  TabIndex="6" Visibility="Collapsed" Height="21"/>
                <Label x:Name="txtPredioAgr" Width="120" Canvas.Left="160" Canvas.Top="70"
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblEstado" Canvas.Left="300" Canvas.Top="11"
                       Content="Estado" Padding="0" />
                <Label x:Name="txtEstado" Canvas.Left="345" Canvas.Top="10" Width="100"
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                       HorizontalContentAlignment="Center"/>
                <Label x:Name="lblIntPorCausar" Content="Intereses por causar" Padding="0" 
                       Canvas.Left="510" Canvas.Top="71" Visibility="Hidden"
                       HorizontalContentAlignment="Right"/>
                <Label x:Name="txtIntPorCausar" Canvas.Left="630" Canvas.Top="70" Width="90" 
                       HorizontalContentAlignment="Right" Visibility="Hidden"
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Button x:Name="bttCausarIntereses" Canvas.Left="735" Canvas.Top="68" 
                        Width="120" Visibility="Hidden" Style="{StaticResource RecEstiloBttGen}"
                        TabIndex="7">
                    <DockPanel Width="120">
                        <Label Content="Causar Intereses" Background="Transparent" Padding="0" 
							DockPanel.Dock="Left" Margin="5,0,0,0" HorizontalAlignment="Left"
							VerticalContentAlignment="Center" IsTabStop="False"/>
                        <Image Source="RecImagenes/IrA.png" Width="17" Height="17" 
							HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,5,0"/>
                    </DockPanel>
                </Button>
                <Label x:Name="lblNroNotaRCr" Content="Nro. Nota Reversión" Padding="0" 
                       Canvas.Top="11" Canvas.Left="470"/>
                <Label x:Name="txtNroNotaRCr" Width="80" 
                       HorizontalContentAlignment="Right" 
                       Style="{StaticResource RecTxtSoloLectura}" Canvas.Top="10" Canvas.Left="585"/>
                <Label x:Name="lblValorNotaCr" Content="Valor" Padding="0"
					Canvas.Left="700" FontWeight="Bold" Canvas.Top="41"/>
                <Label x:Name="txtValorNotaCr" Canvas.Left="745" Canvas.Top="40" Width="110"
					Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
					HorizontalContentAlignment="Right"/>
            </Canvas>
            <GridSplitter Grid.Row="1" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
            <Grid Grid.Row="1">
                <TabControl x:Name="tbcNotaCr"  Grid.Row="1"  Style="{StaticResource RecTabCtrl}"
                            Margin="0,0,0,0" IsTabStop="False">
                    <TabItem x:Name="tbiDetalles" Header="Detalles" IsTabStop="False" TabIndex="10"
                              Style="{StaticResource RecTabItem}" Width="200">
                        <Grid x:Name="grdDetalles">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="180"/>
                                <RowDefinition MinHeight="50"/>
                            </Grid.RowDefinitions>
                            <Canvas x:Name="cnvDescuentos" Grid.Row="0">
                                <Label x:Name="lblDescuentos" Content="DESCUENTOS Y RETENCIONES" 
                                       Canvas.Top="0" Canvas.Left="5" Padding="0"
                                       FontWeight="Bold"/>
                                <Label x:Name="lblIdFactura" Content="Número Documento" Padding="0"
                                       Canvas.Left="10" Canvas.Top="33"
                                       Style="{StaticResource RecFuenteNormal}"/>
                                <TextBox x:Name="txtNroFactura" Canvas.Left="125" 
                                         Canvas.Top="30" Width="100" 
                                         Text="{Binding NroFac}" Background="Transparent"/>
                                <Label x:Name="lblFacAnu" Content="Factura Anulada" Padding="0"
                                       Canvas.Left="230" Canvas.Top="30" Foreground="Blue"
                                       Style="{StaticResource RecFuenteNormal}" FontWeight="Bold"
                                       VerticalContentAlignment="Top"
                                       Visibility="Hidden" Height="22" Width="260"/>
                                <ComboBox x:Name="cboNroFactNuevo"  Canvas.Left="125" Canvas.Top="30" 
                                          Width="100" Padding="6,1,1,1" Visibility="Collapsed" 
                                          Style="{StaticResource RecFuenteNormal}" 
                                          TabIndex="11" Height="21"/>
                                <Label x:Name="lblItemFactura" Content="Item Factura" Padding="0"
                                       Canvas.Left="10" Canvas.Top="63"
                                       Style="{StaticResource RecFuenteNormal}"/>
                                <TextBox x:Name="txtItemFactura" Canvas.Left="125" Canvas.Top="60" 
                                         Width="380" Text="{Binding Detalle}" 
                                         Background="Transparent"/>
                                <ComboBox x:Name="cboItemFactNuevo"  Canvas.Left="125" Canvas.Top="60" 
                                          Width="380" Padding="6,1,1,1" Visibility="Collapsed" 
                                          TabIndex="12" Height="21"/>
                                <Label x:Name="lblDeudaCap" Content="Deuda Capital" Padding="0"
                                       Canvas.Left="510" Canvas.Top="40" 
                                       Style="{StaticResource RecFuenteNormal}" Height="18"/>
                                <Label x:Name="txtDeudaCap" Canvas.Left="510" Canvas.Top="60" Width="90" 
                                       Style="{StaticResource RecTxtSoloLectura}"
                                       HorizontalContentAlignment="Right" Height="22"/>
                                <Label x:Name="lblDeudaIva" Content="Deuda IVA" Padding="0"
                                       Canvas.Left="704" Canvas.Top="40"
                                       Style="{StaticResource RecFuenteNormal}" Height="18"/>
                                <Label x:Name="txtDeudaIva" Canvas.Left="704" Canvas.Top="60" Width="90"
                                       Style="{StaticResource RecTxtSoloLectura}"
                                       HorizontalContentAlignment="Right" Height="22"/>
                                <Label x:Name="lblDeudaMora" Content="Deuda Int. Mora" Padding="0"
                                       Canvas.Left="607" Canvas.Top="40"
                                       Style="{StaticResource RecFuenteNormal}" Height="18"/>
                                <Label x:Name="txtDeudaMora" Canvas.Left="607" Canvas.Top="60" Width="90"
                                       Style="{StaticResource RecTxtSoloLectura}"
                                       HorizontalContentAlignment="Right" Height="22"/>
                                <Label x:Name="lblTipoDcto" Content="Tipo de Descuento" Padding="0"
                                       Canvas.Left="10" Canvas.Top="93"
                                       Style="{StaticResource RecFuenteNormal}"/>
                                <TextBox x:Name="txtTipoDcto" Canvas.Left="125" Canvas.Top="90" 
                                         Width="220" Text="{Binding Dato}" 
                                         Background="Transparent"/>
                                <ComboBox x:Name="cboTipoDsctoNuevo"  Canvas.Left="125" Canvas.Top="90" 
                                          Width="220" Padding="6,1,1,1" Visibility="Collapsed" 
                                          TabIndex="13" Height="21"/>
                                <Label x:Name="lblValorDct" Content="Valor del Descuento" Padding="0"
                                       Canvas.Left="10" Canvas.Top="122"
                                       Style="{StaticResource RecFuenteNormal}"/>
                                <TextBox x:Name="txtValorDcto" Canvas.Left="125" Canvas.Top="120" 
                                         Width="90" Text="{Binding Valor, StringFormat=\{0:c\}}" 
                                         Background="Transparent" HorizontalContentAlignment="Right"/>
                                <TextBox x:Name="txtValorDctoNuevo" Canvas.Left="125" 
                                         Canvas.Top="120" Width="100" 
                                         HorizontalContentAlignment="Right"
                                         Visibility="Collapsed" TabIndex="14"/>
                                <Button x:Name="bttNuevoDscto" Canvas.Left="510" Canvas.Top="10
                                        " Width="140" 
                                        Style="{StaticResource RecEstiloBttGen}" TabIndex="9" >
                                    <DockPanel Width="140">
                                        <Label Content="Nuevo Descuento" Background="Transparent" Padding="0"
                                               Margin="5,0,0,0" DockPanel.Dock="Left"
                                               VerticalContentAlignment="Center"
                                               IsTabStop="False" Style="{StaticResource RecFuenteNormal}"/>
                                        <Image Source="RecImagenes/nuevo.png" Width="20" Height="20" 
                                               HorizontalAlignment="Right" DockPanel.Dock="Right" 
                                               Margin="0,0,5,0"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="bttAceptarDscto" Canvas.Left="510" Canvas.Top="119"
                                        Width="140" Style="{StaticResource RecEstiloBttGen}"
                                        TabIndex="15">
                                    <DockPanel Width="140">
                                        <Label Content="Aceptar Descuento" Background="Transparent" Padding="0" 
                                               Margin="5,0,0,0" DockPanel.Dock="Left"
                                               VerticalContentAlignment="Center"
                                               Style="{StaticResource RecFuenteNormal}"/>
                                        <Image Source="RecImagenes/guardar.png" Width="20" Height="20"
                                               HorizontalAlignment="Right" DockPanel.Dock="Right" 
                                               Margin="0,0,5,0"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="bttCancelarDscto" Canvas.Left="665" Canvas.Top="120" 
                                        Width="140" Style="{StaticResource RecEstiloBttGen}"
                                        TabIndex="16">
                                    <DockPanel Width="140">
                                        <Label Content="Cancelar Descuento" Background="Transparent" 
                                               Padding="0" Margin="5,0,0,0" DockPanel.Dock="Left"
                                               VerticalContentAlignment="Center"
                                               Style="{StaticResource RecFuenteNormal}"/>
                                        <Image Source="RecImagenes/suprimir.png" Width="20" Height="20"
                                               HorizontalAlignment="Right" DockPanel.Dock="Right" 
                                               Margin="0,0,5,0"/>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="bttEliminarDscto" Canvas.Left="665" Canvas.Top="120" Width="140" 
                                        Style="{StaticResource RecEstiloBttGen}"
                                        TabIndex="17" Visibility="Hidden">
                                    <DockPanel Width="140">
                                        <Label Content="Eliminar Descuento" Background="Transparent" 
                                               Padding="0" Margin="5,0,0,0" DockPanel.Dock="Left"
                                               VerticalContentAlignment="Center"
                                               Style="{StaticResource RecFuenteNormal}"/>
                                        <Image Source="RecImagenes/suprimir.png" Width="20" Height="20"
                                               HorizontalAlignment="Right" DockPanel.Dock="Right" 
                                               Margin="0,0,5,0"/>
                                    </DockPanel>
                                </Button>
                                <Label x:Name="lblComentario" Content="Comentario" Padding="0"
                                       Style="{StaticResource RecFuenteNormal}" Height="16" 
                                       Canvas.Left="10" Canvas.Top="153" Width="69"/>
                                <TextBox x:Name="txtComentario" TextAlignment="Justify" 
                                         VerticalScrollBarVisibility="Visible"
                                         TextWrapping="Wrap" TabIndex="18" Height="22" Canvas.Left="126" 
                                         Canvas.Top="150" Width="729"/>
                            </Canvas>
                            <DataGrid x:Name="dgrDescuentos" Grid.Row="1"
                                      AutoGenerateColumns="False" VerticalScrollBarVisibility="auto" 
                                      IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding}" 
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      IsReadOnly="True" Background="Transparent"
                                      Style="{StaticResource RecFuenteNormal}" Margin="15,5,15,5">
                                <DataGrid.CellStyle>
                                    <Style TargetType="{x:Type DataGridCell}">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="LightGray"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Nro Factura" Width="110" x:Name="dgtNroFac">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
											IsTabStop="False" 
											Text="{Binding NroFac}" 
											IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Item Fra." Width="250" x:Name="dgtItemFac">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" 
                                                         Text="{Binding Detalle}" 
                                                         IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Tipo de Descuento" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
											IsTabStop="False" 
											Text="{Binding Dato}" 
											IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Base" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
            								IsTabStop="False" HorizontalContentAlignment="Right"
            								Text="{Binding BaseDscto, StringFormat=\{0:c\}}" 
            								IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Tasa" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
            								IsTabStop="False" HorizontalContentAlignment="Right"
            								Text="{Binding TasaDscto, StringFormat=\{0:p\}}" 
            								IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Valor" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                         IsTabStop="False" HorizontalContentAlignment="Right"
                                                         Text="{Binding Valor, StringFormat=\{0:c\}}" 
                                                         IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tbiNovedades" Header="Movimiento Contable" 
                               Style="{StaticResource RecTabItem}" Width="200">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition MinHeight="50"/>
                            </Grid.RowDefinitions>
                            <Canvas Grid.Row="0">
                                <Label Content="MOVIMIENTO CONTABLE" Canvas.Top="5" Canvas.Left="5" 
                                       FontWeight="Bold" Padding="0"/>
                            </Canvas>
                            <DataGrid x:Name="dgrNovedades" Grid.Row="1"
                                      IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                                      ItemsSource="{Binding}" SelectionMode="Extended" 
                                      SelectionUnit="FullRow"
                                      IsReadOnly="True" Background="Transparent" 
                                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                                      Margin="35,0,40,5" Style="{StaticResource RecFuenteNormal}">
                                <DataGrid.CellStyle>
                                    <Style TargetType="{x:Type DataGridCell}">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="LightGray"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Número Factura" Width="110" x:Name="dgtNroFacMC">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											HorizontalAlignment="Left" IsReadOnly="True"
											Text="{Binding NroFac}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Item Fac." Width="60" x:Name="dgtItemFacMC">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											HorizontalAlignment="Left" IsReadOnly="True"
											Text="{Binding IdItemFactura}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Detalle" Width="290">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											HorizontalAlignment="Left" Text="{Binding ConceptoNovedad}"
											IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Cuenta Db" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
											Text="{Binding IdCuentaDb}" IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Cuenta Cr" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
											Text="{Binding IdCuentaCr}" IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Valor" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
											Text="{Binding Valor, StringFormat=\{0:c\}}" 
											HorizontalAlignment="Right"  
											IsReadOnly="True"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
			IsTabStop="False" HorizontalAlignment="Stretch"  
			Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvBotones" Grid.Row="0">
                <Label x:Name="lblUsuarioGenero" Content="Usuario generó Nota Cr" 
                           Canvas.Top="8" Canvas.Left="20"
                           Padding="0"/>
                <Label x:Name="txtUsuarioGenero" Canvas.Left="160" Canvas.Top="7" Width="120"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblUsuarioAnulo" Content="Usuario anuló Nota Cr" 
                           Canvas.Top="8" Canvas.Left="310"
                           Padding="0"/>
                <Label x:Name="txtUsuarioAnulo" Canvas.Left="440" Canvas.Top="7" Width="120"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>