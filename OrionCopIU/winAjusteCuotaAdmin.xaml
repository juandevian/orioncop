<src:ClsFormInterface x:Class="WinAjusteCuotaAdmin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="Genera Retroactivo Cuota de Administración" Height="415" Width="500" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid Name="grdPpal" Control.LostFocus="OnPierdeFoco"
          Control.GotFocus="OnCogerFoco">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" Name="rwdControl"/>
            <RowDefinition MinHeight="100"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel Name="PanelControl" Grid.Row="0" >
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
                  VerticalAlignment="Center"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Canvas>
                <Label x:Name="lblCantidadCuotas" Content="Cantidad de Cuotas en las que se cobrará el Retroactivo" 
                       Canvas.Left="50" Canvas.Top="21" 
                       Padding="0"/>
                <TextBox x:Name="txtCantCuotas" Canvas.Left="390" Canvas.Top="20" Width="40"
                         TabIndex="1" Background="Transparent" 
                         HorizontalContentAlignment="Right" Padding="0,0,5,0"/>
                <CheckBox x:Name="chkNoGenerarAjuste" Content="No generar Retroactivo" 
                          Canvas.Left="50" Canvas.Top="45" Padding="115,0,0,0" 
                           FlowDirection="RightToLeft" TabIndex="2"/>
                <Label x:Name="lblAdvertencia" Content="Advertencia" 
                           Canvas.Left="50" Canvas.Top="70" Padding="0" Foreground="Red"/>
                <TextBox x:Name="txtAdvertencia" Canvas.Left="50" Canvas.Top="90" 
                             Width="380" Height="50" VerticalContentAlignment="Top" 
                             TextWrapping="Wrap" Background="Transparent" Foreground="Red"
                             IsTabStop="False" IsReadOnly="True" TextAlignment="Justify"
                             Text="En este caso, el Presupuesto Anual de Ingresos por Cuotas de Administracion, no queda distribuido unformemente en los doce Meses de Año."/>
                <Label Content="Proceso" Canvas.Left="50" Canvas.Top="161" Padding="0"/>

                <Label x:Name="txtProceso" Canvas.Left="170" Canvas.Top="160" Width="260" 
                       Style="{StaticResource RecTxtSoloLectura}"
                       FontWeight="Bold" HorizontalContentAlignment="Center" />
                <ProgressBar x:Name="pgbAvance" Canvas.Left="50" Canvas.Top="185" Width="380" 
                             Height="15"/>
                <Label x:Name="lblAvance" Canvas.Left="50" Canvas.Top="200"
                       Width="380" Padding="0" Content="Facturas Procesadas: 0 de 0" 
                       HorizontalContentAlignment="Left"/>
            </Canvas>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
