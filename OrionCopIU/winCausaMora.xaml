<src:ClsFormInterface x:Class="WinCausaMora"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="Causa Intereses de Mora" Height="385" Width="540" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid Name="grdPpal">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" Name="rwdControl"/>
            <RowDefinition MinHeight="160"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel Name="PanelControl" Grid.Row="0" >
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
                  VerticalAlignment="Center"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Canvas Grid.Row="0">
                <Label x:Name="lblTitulo" Canvas.Left="40" Canvas.Top="20" Padding="0" 
                       Content="Causa Intereses de Mora ..." IsTabStop="False"
                       Background="Transparent" Foreground="Gray" FontSize="18" FontStyle="Italic"
                       ToolTip="Calcula y genera los intereses de mora a todas las Facturas Vencidas."/>
                <Label  Content="Fecha de Causación" Canvas.Left="60" Canvas.Top="61" Padding="0"/>
                <Label x:Name="txtFechaCausa" Canvas.Left="200" Canvas.Top="60" Width="280"
                       HorizontalContentAlignment="Center" Style="{StaticResource RecTxtSoloLectura}"/>
                <Label Content="Cierre de Mes ?" Canvas.Left="60" Canvas.Top="91" Padding="0"/>
                <Label x:Name="txtCierreMes" Canvas.Left="200" Canvas.Top="90" Width="280" 
                       HorizontalContentAlignment="Center" Style="{StaticResource RecTxtSoloLectura}"/>
                <Label Content="Proceso" Canvas.Left="60" Canvas.Top="121" Padding="0"/>
                <Label x:Name="txtProceso" Canvas.Left="200" Canvas.Top="120" Width="280" 
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                       HorizontalContentAlignment="Center"/>
                <ProgressBar x:Name="pgbCausacion" Canvas.Left="60" Canvas.Top="155" Width="420" 
                             Height="18"/>
                <Label x:Name="lblResultado" Canvas.Left="60" Canvas.Top="175"
                       Width="380" Padding="0" Content="Elementos Procesados: 0 de 0" 
                       HorizontalContentAlignment="Left"/>
            </Canvas>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
