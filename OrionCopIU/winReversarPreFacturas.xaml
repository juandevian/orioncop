<src:ClsFormInterface x:Class="WinReversarPreFacturas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="Reversar Pre-Facturas" Height="380" Width="540" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid Name="grdPpal">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" Name="rwdControl"/>
            <RowDefinition MinHeight="120"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel Name="PanelControl" Grid.Row="0" >
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  VerticalAlignment="Center" 
                        TabIndex="1"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Canvas Grid.Row="0">
                <Label x:Name="lblTitulo" Canvas.Left="40" Canvas.Top="10" Padding="0" 
                       Content="Reversar Pre-Facturas ..." IsTabStop="False"
                   Background="Transparent" Foreground="Gray" FontSize="18" FontStyle="Italic"
                   TabIndex="0"/>
                <Label x:Name="lblPeriodo" Content="Periodo de las Pre-Facturas" Canvas.Left="40" 
                       Canvas.Top="46" Padding="0"/>
                <Label x:Name="txtPeriodoFact" Canvas.Left="220" Canvas.Top="45" Width="200" 
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblFecha" Content="Fecha de las Pre-Facturas" Canvas.Left="40" Canvas.Top="76" Padding="0"/>
                <Label x:Name="txtFechaFacturas" Canvas.Left="220" Canvas.Top="75" Width="200" 
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Label Content="Proceso" Canvas.Left="40" Canvas.Top="106" Padding="0"/>
                <Label x:Name="txtProceso" Canvas.Left="220" Canvas.Top="105" Width="200" 
                       Style="{StaticResource RecTxtSoloLectura}"
                       FontWeight="Bold" HorizontalContentAlignment="Center" />
                <ProgressBar x:Name="pgbAvance" Canvas.Left="40" Canvas.Top="140" Width="380" 
                             Height="15"/>
                <Label x:Name="lblAvance" Canvas.Left="40" Canvas.Top="155"
                       Width="380" Padding="0" Content="Elementos procesados: 0 de 0" 
                       HorizontalContentAlignment="Left"/>
            </Canvas>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
