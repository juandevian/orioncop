<src:ClsFormInterface  x:Class="WinRevisarNovedades"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OPT.OrionP.OrionCopIU" FontSize="12"
        mc:Ignorable="d" Title="Revisar novedades" Height="220" Width="400">
    <Grid Name="grdPpal">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"  Name="rwdControl"/>
            <RowDefinition MinHeight="80" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel x:Name="PanelControl" Grid.Row="0" Margin="0,10,0,0">
            <!--Label Relleno-->
            <Label Height="10" DockPanel.Dock="Top"/>
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
        </DockPanel>
        <Canvas Grid.Row="1">
            <Label Canvas.Left="30" Canvas.Top="25" 
                Content="Fecha final de las novedades a revisar" Padding="0"/>
            <DatePicker x:Name="dtpFechaFinNovs" HorizontalAlignment="Left" VerticalAlignment="Top" 
                        Canvas.Top="20" Canvas.Left="240" Width="110"/>
        </Canvas>
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
        </Grid>
    </Grid>

</src:ClsFormInterface>
