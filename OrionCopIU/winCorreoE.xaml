<src:ClsFormInterface x:Class="WinCorreoE"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    Title="Correo Electrónico" Height="610" Width="800" WindowStyle="SingleBorderWindow" 
    WindowState="Normal" WindowStartupLocation="CenterScreen" FontSize="12"
    Icon="RecImagenes/orionLogo24.png" Closing="ClsFormInterface_Closing">
    <Grid x:Name="grdPpal" ButtonBase.Click="OnBotonClic" LostFocus="OnPierdeFoco"
          GotFocus="OnCogerFoco" ComboBox.SelectionChanged="OnCboCambio"
          MenuItem.Click="OnMenuClic">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" x:Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel x:Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  VerticalAlignment="Center" 
				TabIndex="1"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <TabControl Grid.Row="1" Background="Transparent" SelectionChanged="TabControl_SelectionChanged">
            <TabItem x:Name="tbiEnviar" Header="Enviar correo" 
                     Style="{StaticResource RecTabItem}" Width="200">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="95"/>
                        <RowDefinition MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <Canvas Grid.Row="0" d:IsHidden="False">
                        <Label Canvas.Left="20" Canvas.Top="5" Padding="0" 
                                Content="Enviar Correo Electrónico..." 
                                IsTabStop="False" Background="Transparent" 
                                Foreground="Gray" FontSize="18" FontStyle="Italic"/>
                        <Label Canvas.Left="320" Canvas.Top="5" Padding="0" 
                                Content="Puede seguir trabajando normalmente en Orión" 
                                IsTabStop="False" Background="Transparent" 
                                Foreground="Red" FontSize="18" FontStyle="Normal"
                               FontWeight="Bold"/>
                        <Label x:Name="lblTipoDoc" Canvas.Left="30" Canvas.Top="46" Padding="0"
                                Content="Seleccione el Tipo de Documento:"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <ComboBox x:Name="cboTipoCorreo" Width="220" Canvas.Left="370" Canvas.Top="45"
                                    Padding="6,1,1,1" TabIndex="1" Background="Transparent"
                                    Height="18"/>
                    </Canvas>
                    <Canvas x:Name="cnvArch" Grid.Row="1" d:IsHidden="True">
                        <Label x:Name="lblSelArch" Canvas.Left="50" Canvas.Top="11"
                                Content="Busque el Archivo a ser enviado:" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <Button x:Name="bttExaminar" Canvas.Left="67" Canvas.Top="38" 
                                Padding="0" Margin="0" Width="100" Height="22"
                                BorderThickness="2" TabIndex="2">
                            <DockPanel Width="100">
                                <Label Content="Examinar ..." Background="Transparent"
                                        Padding="0" DockPanel.Dock="Left" HorizontalAlignment="Center"
                                        VerticalContentAlignment="Center" IsTabStop="False"
                                        Style="{StaticResource RecFuenteNormal}"/>
                            </DockPanel>
                        </Button>
                        <TextBox x:Name="txtArchivo" Width="410" Canvas.Left="178" Canvas.Top="40"
                                    Background="Transparent" TabIndex="3"/>
                    </Canvas>
                    <Canvas x:Name="cnvCobroPer" Grid.Row="1" d:IsHidden="False">
                        <Label x:Name="lblDiasVen" Canvas.Left="55" Canvas.Top="52"  Padding="0" 
                               Content="Este mensaje será enviado a todos aquellos que tengan una cuenta con más de "
                               Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtDiasVen" Canvas.Left="485" Width="30"
                                 HorizontalContentAlignment="Right" Canvas.Top="50" 
                                 TabIndex="20" Style="{StaticResource RecFuenteNormal}"/>
                        <Label x:Name="lblComDias" Canvas.Left="520" Canvas.Top="51" 
                               Padding="0" Style="{StaticResource RecFuenteNormal}"
                               Content=" días de vencida."/>
                    </Canvas>
                    <Canvas x:Name="cnvDocs" Grid.Row="1" d:IsHidden="True">
                        <Label x:Name="lblCliente" Canvas.Left="50" Canvas.Top="6" 
                                Content="Cliente:" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <Button x:Name="bttEncontrarCli" Canvas.Left="195" Canvas.Top="5"
                                Style="{StaticResource RecEstiloBttEnc}"
                                TabIndex="10" ToolTip="Clic aqui para buscar El Cliente."/>
                        <TextBox x:Name="txtIdCliente" Canvas.Left="210" Canvas.Top="5"
                                    Width="100" Height="18" TabIndex="11"/>
                        <Label x:Name="txtNombreCliente" Canvas.Left="195" Canvas.Top="25"
                                Width="290" Height="18"
                                Style="{StaticResource RecTxtSoloLectura}"/>
                        <Label x:Name="lblPredioAgr" Canvas.Left="50" Canvas.Top="51" 
                                Content="Predio Agrupador:" Background="Transparent"
                                Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                        <ComboBox x:Name="cboPredioAgr" Width="220" Height="18"
                                    Canvas.Left="195" Canvas.Top="50" 
                                    Padding="6,1,1,1" TabIndex="12" />
                        <Label x:Name="lblDoc" Canvas.Left="50" Canvas.Top="76"
                                Content="Número de Documento:" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <ComboBox x:Name="cboNroDoc" Width="100" Height="18"
                                    Canvas.Left="195" Canvas.Top="75" 
                                    Padding="6,1,1,1" TabIndex="13"/>
                    </Canvas>
                    <Canvas x:Name="cnvFrasMes" Grid.Row="1" d:IsHidden="True">
                        <CheckBox x:Name="chkSeguro" Canvas.Left="50" Canvas.Top="20" IsChecked="False"
                                    Content="Estoy seguro de enviar por Correo las Facturas del presente Período !"
                                    Background="Transparent" Padding="10,0,0,0" TabIndex="16"
                                    Style="{StaticResource RecFuenteNormal}"/>
                    </Canvas>
                    <Canvas x:Name="cnvRecs" Grid.Row="1" d:IsHidden="True">
                        <Label x:Name="lblFecIni" Canvas.Left="55" Canvas.Top="24" 
                                Content="Fecha desde:" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <DatePicker x:Name="dtpFecIni" Canvas.Left="140" Canvas.Top="20"
                                    Style="{StaticResource RecFuenteNormal}"
                                    SelectedDate="01/01/1900"/>
                        <Label x:Name="lblFecFin" Canvas.Left="55" Canvas.Top="58" 
                                Content="Fecha hasta:" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <DatePicker x:Name="dtpFecFin" Canvas.Left="140" Canvas.Top="54"
                                    Style="{StaticResource RecFuenteNormal}"
                                    SelectedDate="01/01/1900"/>
                    </Canvas>
                    <Canvas x:Name="cnvMens" Grid.Row="2">
                        <Label x:Name="lblAsunto" Canvas.Left="55" Canvas.Top="2" Padding="0"
                                Content="Asunto:" Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtAsunto" Width="655" Canvas.Left="110" 
                                 Canvas.Top="0" Background="Transparent" TabIndex="21"/>
                        <Label x:Name="lblMensaje" Canvas.Left="55" Canvas.Top="30"
                                Content="Ingrese el Texto del mensaje" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtMensaje" Canvas.Left="50" Canvas.Top="50" 
                                    Width="715" Height="135" TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" MaxLength="500"
                                    AcceptsReturn="True" TabIndex="21"/>
                        <Label Canvas.Left="20" Canvas.Top="190" 
                            Content="Cliente:" x:Name="lblCuentaCorreoOri" 
                                FontWeight="SemiBold" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                    </Canvas>
                </Grid>
            </TabItem>
            <TabItem x:Name="tbiHistorico" Header="Histórico" 
                     Style="{StaticResource RecTabItem}" Width="200">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="421*"/>
                        <ColumnDefinition Width="29*"/>
                        <ColumnDefinition Width="350*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="65"/>
                        <RowDefinition MinHeight="70"/>
                    </Grid.RowDefinitions>
                    <Canvas Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,-0.333,0">
                        <Label Canvas.Left="20" Canvas.Top="10" 
                                Content="Correos enviados desde el::" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <DatePicker x:Name="dtpDesde" Canvas.Left="175" Canvas.Top="5" Width="110"
                                    Style="{StaticResource RecFuenteNormal}"
                                    HorizontalContentAlignment="Right" TabIndex="1"/>
                        <Label Canvas.Left="325" Canvas.Top="10" 
                                Content="hasta el::" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <DatePicker x:Name="dtpHasta" Canvas.Left="380" Canvas.Top="5" Width="110"
                                    Style="{StaticResource RecFuenteNormal}"
                                    HorizontalContentAlignment="Right" TabIndex="2"/>
                        <Label Canvas.Left="20" Canvas.Top="41" 
                                Content="Cliente:" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <Button x:Name="bttEncontrarCliHist" Canvas.Left="70" Canvas.Top="40"
                                Style="{StaticResource RecEstiloBttEnc}"
                                TabIndex="5" ToolTip="Clic aqui para buscar El Cliente."/>
                        <TextBox x:Name="txtIdClienteHis" Canvas.Left="85" Canvas.Top="40"
                                 Width="100" Height="18" Style="{StaticResource RecFuenteNormal}"
                                 TabIndex="6"/>
                        <Label x:Name="txtNombreClienteHist" Canvas.Left="195" Canvas.Top="40"
                                Width="290" Height="18"
                                Style="{StaticResource RecTxtSoloLectura}"/>
                        <Button x:Name="bttMostrarTodos" Canvas.Left="505" Canvas.Top="38"
                                    Width="110" Style="{StaticResource RecEstiloBttGen}"
                                    TabIndex="13">
                            <DockPanel Width="110">
                                <Label Content="Mostrar todos" Background="Transparent"
                                       Padding="0" DockPanel.Dock="Left" Margin="5,0,0,0" 
                                       HorizontalAlignment="Left" 
                                       Style="{StaticResource RecFuenteNormal}"
                                       VerticalContentAlignment="Center" IsTabStop="False"/>
                                <Image Source="RecImagenes/IrA.png" Width="17" Height="17" 
                                           HorizontalAlignment="Right" DockPanel.Dock="Right" 
                                           Margin="0,0,5,0"/>
                            </DockPanel>
                        </Button>
                    </Canvas>
                    <DataGrid x:Name="dgrHistorico" Grid.Row="1" Margin="5,5,4.667,4.333"
                                      IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                                      ItemsSource="{Binding}" SelectionMode="Extended" 
                                      SelectionUnit="FullRow" IsReadOnly="True" Background="Transparent" 
                                      IsTabStop="False" Style="{StaticResource RecFuenteNormal}"
                                      ScrollViewer.VerticalScrollBarVisibility="Visible" Grid.ColumnSpan="3">
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="LightGray"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Fecha envío" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" 
            								Text="{Binding FechaEnvio, StringFormat=\{0:dd/MM/yyyy\}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Id. Cliente" Width="Auto" 
                                                            CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											Text="{Binding IdTerceroCliente}"
											IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Asunto" Width="Auto" 
                                                            CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											Text="{Binding Asunto}"
											IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Tipo correo" Width="Auto" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
											Text="{Binding Tipo}" 
											IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Nro. Doc." Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											HorizontalAlignment="Right" 
											Text="{Binding NumeroDoc}"
											IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Mensaje" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											HorizontalAlignment="Left" 
											Text="{Binding Mensaje}"
											IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem x:Name="tbiHistoricoAsunto" Header="Histórico por Asunto" 
                     Style="{StaticResource RecTabItem}" Width="200">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="65"/>
                        <RowDefinition MinHeight="70"/>
                    </Grid.RowDefinitions>
                    <Canvas Grid.Row="0">
                        <Label Canvas.Left="20" Canvas.Top="10" 
                                Content="Correos enviados desde el::" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <DatePicker x:Name="dtpFechaDesde" Canvas.Left="175" Canvas.Top="5" 
                                    Width="110" Style="{StaticResource RecFuenteNormal}"
                                    HorizontalContentAlignment="Right" TabIndex="1"/>
                        <Label Canvas.Left="325" Canvas.Top="10" 
                                Content="hasta el::" Padding="0"
                                Style="{StaticResource RecFuenteNormal}"/>
                        <DatePicker x:Name="dtpFechaHasta" Canvas.Left="380" Canvas.Top="5" 
                                    Width="110" Style="{StaticResource RecFuenteNormal}"
                                    HorizontalContentAlignment="Right" TabIndex="2"/>
                        <Label Canvas.Left="20" Canvas.Top="43" Content="Tipo de Correo:" 
                               Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                        <ComboBox x:Name="cboTipoCorreoH" Canvas.Left="175" Canvas.Top="40"
                                  Width="220" Style="{StaticResource RecFuenteNormal}" />
                    </Canvas>
                    <DataGrid x:Name="dgrHistoricoAsunto" Grid.Row="1" Margin="5,5,4.666,5"
                                      IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                                      ItemsSource="{Binding}" SelectionMode="Extended" 
                                      SelectionUnit="FullRow" IsReadOnly="True" Background="Transparent" 
                                      IsTabStop="False" Style="{StaticResource RecFuenteNormal}"
                                      ScrollViewer.VerticalScrollBarVisibility="Visible" Grid.ColumnSpan="2">
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="LightGray"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Asunto" Width="Auto"  CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											Text="{Binding Asunto}"
											IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Fecha envío" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" 
            								Text="{Binding FechaEnvio, 
                                            StringFormat=\{0:dd/MM/yyyy\}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Nro. Doc." Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											HorizontalAlignment="Right" 
											Text="{Binding NumeroDoc}"
											IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Mensaje" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											HorizontalAlignment="Left" 
											Text="{Binding Mensaje}"
											IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
			IsTabStop="False" HorizontalAlignment="Stretch"  
			Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvBotones" Grid.Row="0">
                <ProgressBar x:Name="pgbCorreo" Canvas.Left="40" Canvas.Top="5" Width="420" 
                             Height="14"/>
                <Label x:Name="txtProceso" Canvas.Left="473" Canvas.Top="3"
                       Width="40" Padding="0"
                       HorizontalContentAlignment="Right"
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="txtNotifica" Canvas.Left="40" Canvas.Top="15"
                       FontWeight="Bold" FontSize="12" Foreground="Blue"/>
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
