<src:ClsFormInterface x:Class="WinProgramacionFacturas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d"
    Title="Programación de Cobros" Height="530" Width="850" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" 
    KeyDown="clsFormInterface_KeyDow" FontSize="12">
    <Window.Resources>
        <Style x:Key="RecTxtOrigen" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Foreground" Value="Blue"/>
        </Style>
        <Style x:Key="RecTxtOrigenSistema" TargetType="TextBox" BasedOn="{StaticResource RecTxtOrigen}">
            <Setter Property="Background" Value="LightGray"/>
        </Style>
        <Style x:Key="RecTxtOrigenUsuario" TargetType="TextBox" BasedOn="{StaticResource RecTxtOrigen}">
            <Setter Property="Background" Value="YellowGreen"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="grdPpal" LostFocus="OnPierdeFoco" GotFocus="OnCogerFoco"  MenuItem.Click="OnMenuClic">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" x:Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel x:Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
                  VerticalAlignment="Center" TabIndex="1"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid x:Name="grdProgramaFact" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition MinHeight="50"/>
                <RowDefinition Height="200*"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvGeneral" Grid.Row="0">
                <GroupBox Header="Tipo de Deudor" Canvas.Left="20" Canvas.Top="5" Height="40" 
					Width="200" Padding="0" VerticalAlignment="Center"
					IsTabStop="False" Background="Transparent">
                    <Canvas>
                        <RadioButton x:Name="rdbPredio" Content="Predio" Canvas.Left="20" Canvas.Top="0" 
							Padding="5,0,0,0" GroupName="Enlace" IsChecked="True"
							TabIndex="2"/>
                        <RadioButton x:Name="rdbCliente" Content="Cliente" Canvas.Left="120" 
							Canvas.Top="0" Padding="5,0,0,0" GroupName="Enlace" 
							TabIndex="3"/>
                    </Canvas>
                </GroupBox>
                <Label x:Name="lblIdDestinatario" Content="Id. Predio" Canvas.Left="260" Canvas.Top="20" 
					Padding="0"/>
                <TextBox x:Name="txtIdDestinatario" Canvas.Left="330" Canvas.Top="20" Width="100" 
					TabIndex="4"/>
                <Label x:Name="txtNombre" Canvas.Left="450" Canvas.Top="20" Width="360" 
                       Style="{StaticResource RecTxtSoloLectura}"/>
            </Canvas>
            <GridSplitter Grid.Row="1" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
            <Canvas x:Name="cnvDatosFactura" Grid.Row="1">
                <Label x:Name="lblServicio" Content="Servicio" Canvas.Left="30" Canvas.Top="11" 
                       Padding="0"/>
                <TextBox x:Name="txtServicio" Canvas.Left="89" Canvas.Top="10" Width="431"
                         IsTabStop="False" Text="{Binding NombreServicio}" 
                         Background="Transparent" HorizontalAlignment="Left" 
                         VerticalAlignment="Center" />
                <GroupBox x:Name="grbConsumo" Height="114" Width="260" Canvas.Left="552" 
                          Canvas.Top="3" Padding="0" Header="Consumo" HorizontalAlignment="Left" 
                          VerticalAlignment="Center">
                    <Canvas>
                        <Label x:Name="lblLecAnterior" Content="Lectura anterior" Canvas.Left="10" 
                               Canvas.Top="11"  Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtLecAnterior" Canvas.Left="140" Canvas.Top="10" 
                                 Width="90" Background="Transparent" Padding="0,0,0,0"  
                                 HorizontalContentAlignment="Right" HorizontalAlignment="Center" 
                                 VerticalAlignment="Center" TextAlignment="Right"/>
                        <Label x:Name="lblLecAActual" Content="Lectura actual" Canvas.Left="10" 
                               Canvas.Top="36"  Padding="0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <TextBox x:Name="txtLecActual" Canvas.Left="140" Canvas.Top="35" 
                                 Width="90" Background="Transparent" Padding="0,0,0,0"  
                                 HorizontalContentAlignment="Right" HorizontalAlignment="Left" 
                                 VerticalAlignment="Center" TextAlignment="Right"/>
                        <Label x:Name="lblVlrUnidad" Content="Valor unitario" Canvas.Left="10" 
                               Canvas.Top="61"  Padding="0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <TextBox x:Name="txtVlrUnidad" Canvas.Left="140" Canvas.Top="60" 
                                 Width="90" Background="Transparent" Padding="0,0,0,0"  
                                 HorizontalContentAlignment="Right" HorizontalAlignment="Left" 
                                 VerticalAlignment="Center" TextAlignment="Right"/>
                    </Canvas>
                </GroupBox>
                <ComboBox x:Name="cboServicioNuevo" Canvas.Left="90" Canvas.Top="10" Width="330" 
                          Padding="6,1,1,1" Visibility="Hidden" TabIndex="5"/>
                <Label x:Name="lblValorPerio" Content="Valor Período (IVA Incluido)" Canvas.Left="30" 
                       Canvas.Top="41" Padding="0"/>
                <TextBox x:Name="txtVlrPeri" Canvas.Left="195" Canvas.Top="40" Width="90"
                         IsTabStop="False" Text="{Binding ValorPeriodo, StringFormat={}{0:c}}" 
                         Background="Transparent" HorizontalContentAlignment="Right" Padding="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Right"/>
                <TextBox x:Name="txtVlrPeriNuevo" Canvas.Left="210" Canvas.Top="40" Width="90"
                         HorizontalContentAlignment="Right" Padding="0,0,5,0" Visibility="Hidden" 
                         TabIndex="6"/>
                <Label x:Name="lblTarifaIva" Canvas.Left="385" Canvas.Top="41" 
                           Content="Tarifa IVA" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label x:Name="txtTarifaIva" Canvas.Left="480" Canvas.Top="40" Width="50"
                       HorizontalContentAlignment="Right" Padding="0"
                       Style="{StaticResource RecTxtSoloLectura}" HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
                <Label x:Name="lblPeriodoIni" Content="Período Inicio Facturación" 
                       Canvas.Left="30" Canvas.Top="71" 
                       Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPeriodoIni" Canvas.Left="195" Canvas.Top="70" Width="90"
                         IsTabStop="False" Text="{Binding PeriodoInicioFact}"
                         Background="Transparent" HorizontalContentAlignment="Right"
                         Padding="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label x:Name="lblAnoPeriodo" Content="Año" 
                           Canvas.Left="195" Canvas.Top="71" Visibility="Hidden"
                           Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ComboBox x:Name="cboAnoPeriodoNuevo" Canvas.Left="225" Canvas.Top="70" 
                              Width="60" Padding="6,1,1,1"  Visibility="Hidden"
                              TabIndex="7" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label x:Name="lblMesPeriodo" Content="Mes" 
                           Canvas.Left="300" Canvas.Top="71"  Visibility="Hidden"
                           Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <ComboBox x:Name="cboMesPeriodoNuevo" Canvas.Left="330" Canvas.Top="70" 
                              Width="40" Padding="6,1,1,1"  Visibility="Hidden"
                              TabIndex="8" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label x:Name="lblCantidadPer" Content="Cantidad Períodos" Canvas.Left="385" 
                       Canvas.Top="70" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCantPeri" Canvas.Left="500" Canvas.Top="71" Width="30"
                         IsTabStop="False" Text="{Binding CantidadPeriodos}" Background="Transparent" 
                         HorizontalContentAlignment="Right" Padding="0,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCantPeriNuevo" Canvas.Left="500" Canvas.Top="71" Width="30"
                         Visibility="Hidden" HorizontalContentAlignment="Right" Padding="0,0,5,0" 
                         TabIndex="9"/>
                <Label x:Name="lblSaldo" Canvas.Left="30" Canvas.Top="101" 
                           Content="Saldo por Facturar" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Label x:Name="txtSaldo" Canvas.Left="195" Canvas.Top="100" Width="90"
                       HorizontalContentAlignment="Right"
                       Style="{StaticResource RecTxtSoloLectura}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label x:Name="lblAno" Content="Mostrar Servicios del Año" Canvas.Left="30" Canvas.Top="131" 
                       Padding="0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <ComboBox x:Name="cboAno" Canvas.Left="195" Canvas.Top="130" Width="90" 
                          Padding="6,1,1,1" SelectedItem="2088" TabIndex="11" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label x:Name="lblOrigen" Content="Origen" Canvas.Left="620" 
                       Canvas.Top="131" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <TextBox x:Name="txtOrigen" Canvas.Left="670" Canvas.Top="130" Width="140"
                         Padding="6,0,0,0" Text="{Binding NombreOrigen}" IsTabStop="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <DataGrid x:Name="dgrItemsProgramaFact" Canvas.Left="20" Canvas.Top="155" Height="130" 
                          AutoGenerateColumns="False" VerticalScrollBarVisibility="Auto" 
                          IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding}" 
                          SelectionMode="Extended" SelectionUnit="FullRow" Background="Transparent" 
                          IsReadOnly="True" TabIndex="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Año" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                 IsTabStop="False" 
                                                 Text="{Binding IdAno}" 
                                                 IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Id.Servicio" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                 IsTabStop="False" 
                                                 Text="{Binding IdServicio}" 
                                                 IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Nombre Servicio" Width="290">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                 IsTabStop="False" 
                                                 Text="{Binding NombreServicio}" 
                                                 IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Período Inicio" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                 IsTabStop="False" 
                                                 Text="{Binding PeriodoInicioFact}" 
                                                 IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Cant.Períodos" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                             HorizontalAlignment="Right" Text="{Binding CantidadPeriodos}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Valor Período" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Right" 
                                             Text="{Binding ValorPeriodo, StringFormat={}{0:c}}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Saldo" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Right" 
                                             Text="{Binding Saldo, StringFormat={}{0:c}}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="LightGray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
            </Canvas>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
			IsTabStop="False" HorizontalAlignment="Stretch"  
			Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>