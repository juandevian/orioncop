<src:ClsFormInterface x:Class="WinNotasDevAnt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin" 
    Title="Nota Reintegro de Anticipos" Height="425" Width="850" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid Name="grdPpal" Control.LostFocus="OnPierdeFoco" Button.Click="OnBotonClic"
          Control.GotFocus="OnCogerFoco"  Selector.SelectionChanged="OnCboCambio">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
                  VerticalAlignment="Center" />
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="200*"/>
            </Grid.RowDefinitions>
            <Canvas Grid.Row="0" x:Name="cnvEncabezado">
                <Label x:Name="lblIdNotaDev" Content="Id." Padding="0"
                		Canvas.Left="20" Canvas.Top="11"/>
                <Border Canvas.Left="140" Canvas.Top="7" BorderBrush="Gray" BorderThickness="1" 
                            CornerRadius="0" Width="214" Height="24">
                    <Canvas>
                        <Label x:Name="lblPref" Content="Pref." Padding="0"
                                   Canvas.Left="2" Canvas.Top="3" />
                        <ComboBox x:Name="cboPref" Canvas.Left="30" Canvas.Top="1" Width="58"
                                     TabIndex="1" Height="19"/>
                        <Label x:Name="lblIdNota" Content="Número" Padding="0"
                               Canvas.Left="100" Canvas.Top="3" />
                        <TextBox x:Name="txtIdNota" Canvas.Left="150" Canvas.Top="1" 
                                 Width="60" HorizontalContentAlignment="Right" TabIndex="2" />
                    </Canvas>
                </Border>
                <Label x:Name="lblEstado" Canvas.Left="431" Canvas.Bottom="30"
                    Content="Estado" Padding="0" Canvas.Top="11"/>
                <Label x:Name="txtEstado" Canvas.Left="485" Canvas.Bottom="10" Width="110"
                    Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                    HorizontalContentAlignment="Center" Canvas.Top="10"/>
                <Label x:Name="lblFechaDevAnt" Content="Fecha" FontWeight="Bold"
                        Canvas.Left="670" Canvas.Top="11" Padding="0"/>
                <DatePicker x:Name="dtpFechaDevAnt" Width="105" Canvas.Left="720" Canvas.Top="8" 
                            Padding="6,1,1,1" TabIndex="3" 
                            FontWeight="Bold" HorizontalContentAlignment="Right"/>
                <Label x:Name="lblIdCliente" Content="Cliente" Canvas.Left="20" Canvas.Top="41" 
                        Padding="0"/>
                <Button x:Name="bttEncontrarCliente" Canvas.Left="125" Canvas.Top="40"
                        Style="{StaticResource RecEstiloBttEnc}" Visibility="Hidden"
                        TabIndex="4"
                        ToolTip="Clic aqui para buscar El Cliente."/>
                <TextBox x:Name="txtIdCliente" Canvas.Left="140" Canvas.Top="40" 
                            Width="100" HorizontalContentAlignment="Right" TabIndex="5"/>
                <Label x:Name="txtNombreCliente" Canvas.Left="245" Canvas.Top="40"
                        Width="350" Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblValor" Content="Valor" Padding="0" Canvas.Left="670" Canvas.Top="41"
                           FontWeight="Bold"/>
                <Label x:Name="txtValorR" Canvas.Left="720" Canvas.Top="40" Width="105"
                           HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                           Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"/>
                <Label x:Name="lblIdPredioAgr" Content="Predio Agrupador" Canvas.Left="20" 
                        Canvas.Top="71" Padding="0"/>
                <ComboBox x:Name="cboPredioAgru" Canvas.Left="140" Canvas.Top="70" Width="140"  
                            Padding="6,1,1,1" Visibility="Hidden"
                            TabIndex="6"/>
                <TextBox x:Name="txtPredioAgr" Canvas.Left="140" Canvas.Top="70" Width="140"/>
                <Label x:Name="lblValorDev" Content="Valor" Canvas.Left="670" 
                       Canvas.Top="71" Padding="0"/>
                <TextBox x:Name="txtValorDev" Canvas.Left="722" Canvas.Top="70"
                        Width="104" HorizontalContentAlignment="Right"
                        TabIndex="7"/>
                <Label x:Name="lblIdAntSel" Content="Id. Anticipo" 
                    Canvas.Left="459" Canvas.Top="71" Padding="0"/>
                <Label x:Name="txtIdAntSeleccionado" Canvas.Left="535"
                    Canvas.Top="70" Width="60" HorizontalContentAlignment="Right"
                    Style="{StaticResource RecTxtSoloLectura}"/>
            </Canvas>
            <GridSplitter Grid.Row="1" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
            <Canvas Grid.Row="1" x:Name="cnvAnticipos">
                <Label x:Name="lblComentario" Content="Detalle" 
                       Canvas.Left="30" Canvas.Top="20" Padding="0"/>
                <TextBox x:Name="txtComentario" Canvas.Left="86" Canvas.Top="20"
                         Width="716" Height="18" HorizontalContentAlignment="Left"
                         TextAlignment="Justify" TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" TabIndex="8"/>
                <DataGrid x:Name="dgrAnticipos" Canvas.Left="150" Canvas.Top="50" Height="80"
                          IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                          ItemsSource="{Binding}" SelectionMode="Extended" SelectionUnit="FullRow"
                          IsReadOnly="True" Background="Transparent" TabIndex="9"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="LightGray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Id. Ant." Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                 Padding="0,0,5,0" IsReadOnly="True" 
                                                 Text="{Binding IdAnticipo}"
                                                 HorizontalContentAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Fecha Ant." Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                 Padding="5,0,0,0" IsReadOnly="True" 
                                                 Text="{Binding FechaAnticipo, StringFormat={}{0:dd/MM/yyyy}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Origen" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											Text="{Binding NroDocOriAnt}"
											IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Número Doc." Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                                 Text="{Binding NroDocOriAnt}"
                                                 ToolTip="Número del Documento que originó el anticipo."
                                                 IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Valor" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                 Padding="0,0,5,0" IsReadOnly="True" 
                                                 Text="{Binding ValorAnticipo, StringFormat=\{0:c\}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Débitos" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                             Padding="0,0,5,0" IsReadOnly="True" 
                                             Text="{Binding Debitos, StringFormat=\{0:c\}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Saldo" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             Padding="0,0,5,0"  HorizontalAlignment="Right" 
                                             Text="{Binding Saldo, StringFormat=\{0:c\}}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="dgrNovedades" Canvas.Left="120" Canvas.Top="50" Height="80"
                          IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                          ItemsSource="{Binding}" SelectionMode="Extended" SelectionUnit="FullRow"
                          IsReadOnly="True" Background="Transparent" TabIndex="10"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="LightGray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Id. Ant." Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                             Padding="0,0,5,0" IsReadOnly="True" 
                                             Text="{Binding IdAnticipo}"
                                             HorizontalContentAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Fecha Rein." Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                             Padding="5,0,0,0" IsReadOnly="True" 
                                             Text="{Binding FechaNovedad, StringFormat={}{0:dd/MM/yyyy}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Detalle" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             Text="{Binding ConceptoNovedad}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Nro. Cuenta Db." Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                             Text="{Binding IdCuentaDb}"
                                             ToolTip="Número del Documento que originó el anticipo."
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Nro. Cuenta Cr." Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                             Padding="0,0,5,0" IsReadOnly="True" 
                                             Text="{Binding IdCuentaCr}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Valor" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" 
                                             Padding="0,0,5,0" IsReadOnly="True" 
                                             Text="{Binding Valor, StringFormat=\{0:c\}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Canvas>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <Label x:Name="lblUsuarioGenero" Content="Usuario Generó Nota" 
                           Canvas.Top="8" Canvas.Left="30"
                           Padding="0"/>
                <Label x:Name="txtUsuarioGenero" Canvas.Left="160" Canvas.Top="7" Width="90"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblUsuarioAnulo" Content="Usuario Anuló Nota" 
                           Canvas.Top="8" Canvas.Left="300"
                           Padding="0"/>
                <Label x:Name="txtUsuarioAnulo" Canvas.Left="420" Canvas.Top="7" Width="90"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
