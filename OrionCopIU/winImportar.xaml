<src:ClsFormInterface  x:Class="WinImportar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    Title="winImportar" Height="600" Width="900" WindowStyle="SingleBorderWindow" 
            WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png">
    <Grid x:Name="grdPpal" Button.Click="OnBotonClic">
        <Grid.RowDefinitions>
            <RowDefinition Height="95"  x:Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel x:Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  VerticalAlignment="Center" 
				TabIndex="1"/>
        </DockPanel>
        <Grid Grid.Row="1" LostFocus="OnPierdeFoco" ComboBox.SelectionChanged="OnCboCambio"
              GotFocus="OnCogerFoco">
            <Canvas>
                <GroupBox Header="Origen de los Datos a Importar" Width="880" Height="120" Canvas.Left="5"
					Canvas.Top="5" IsTabStop="False" Background="Transparent" TabIndex="2">
                    <Canvas>
                        <Label x:Name="lblOrigenDatos" Content="Ruta y Nombre Archivo de Origen"
							Canvas.Left="10" Canvas.Top="10" 
							Padding="0" TabIndex="3"/>
                        <TextBox x:Name="txtOrigenDatos" Canvas.Left="210" Canvas.Top="10"
							Width="480" TabIndex="4"/>
                        <Button x:Name="bttExaminar" Canvas.Left="709" Canvas.Top="8" Padding="0" Margin="0"
                                Width="120" Height="22" BorderThickness="2" TabIndex="5">
                            <DockPanel Width="120">
                                <Label Content="Examinar ..." Background="Transparent" 
                                       Padding="0" DockPanel.Dock="Left" HorizontalAlignment="Center"
                                       VerticalContentAlignment="Center" IsTabStop="False"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="bttCargar" Canvas.Left="10" Canvas.Top="37.5" Padding="0" Margin="0"
                                Width="120" Height="22" BorderThickness="2" TabIndex="8">
                            <DockPanel Width="120">
                                <Label Content="Cargar Tablas" Background="Transparent" 
                                       Padding="0" DockPanel.Dock="Left" HorizontalAlignment="Center"
                                       VerticalContentAlignment="Center" IsTabStop="False"/>
                            </DockPanel>
                        </Button>
                        <Label x:Name="lblTablasCargadas" Content="Tablas Cargadas"
							Canvas.Left="210" Canvas.Top="40" 
							Padding="0" TabIndex="9"/>
                        <ComboBox x:Name="cboTablas" Canvas.Left="320" Canvas.Top="40" Width="370"  
							Padding="6,1,1,1" TabIndex="10" />
                        <Label x:Name="lblUltimaImportacion" Content="Origen Ultima importación"
							Canvas.Left="10" Canvas.Top="70" 
							Padding="0" TabIndex="11"/>
                        <Label x:Name="txtUltimaImportacion" Canvas.Left="210" Canvas.Top="70"
							Width="365" Style="{StaticResource RecTxtSoloLectura}" TabIndex="12"/>
                        <Label x:Name="lblTabla" Content="Tabla" Canvas.Left="595" Canvas.Top="71" 
							Padding="0" TabIndex="13"/>
                        <Label x:Name="txtTabla" Canvas.Left="629" Canvas.Top="70"
							Width="200" Style="{StaticResource RecTxtSoloLectura}" TabIndex="14"/>
                    </Canvas>
                </GroupBox>
                <Label x:Name="lblCamposRequeridos" Content="Campos Requeridos" Canvas.Left="20" Canvas.Top="140"
					Padding="0" TabIndex="15"/>
                <ListBox x:Name="lsbCamposRequeridos" Canvas.Left="10" Canvas.Top="160"
					Width="180" Height="200" Background="Transparent" SelectionMode="Single"
					TabIndex="16"/>
                <GroupBox Canvas.Left="200" Canvas.Top="160" Width="375" Height="270"
					Header="Relacionar Campos" IsTabStop="False"
					TabIndex="17">
                    <Canvas>
                        <Label x:Name="lblCamposDestino" Content="Campos de Destino" Canvas.Left="10" 
                               Canvas.Top="5" Padding="0" TabIndex="18"/>
                        <ListBox x:Name="lsbCamposDestino" Canvas.Left="0" Canvas.Top="25"
 							     Width="180" Height="190" Background="Transparent" SelectionMode="Single"
							     TabIndex="19">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Label x:Name="lblCamposOrigen" Content="Campos de Origen" Canvas.Right="40" Canvas.Top="5"
							Padding="0" TabIndex="20"/>
                        <ListBox x:Name="lsbCamposOrigen" Canvas.Right="0" Canvas.Top="25"
							Width="180" Height="190" Background="Transparent" SelectionMode="Single"
							TabIndex="21">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Button x:Name="bttRelacionar" Canvas.Left="80" Canvas.Bottom="0" Padding="0" Margin="0"
                                Width="200" Height="22" BorderThickness="2" TabIndex="22">
                            <DockPanel Width="200">
                                <Label Content="Relacionar Campos Seleccionados" Background="Transparent" 
                                       Padding="0" DockPanel.Dock="Left" HorizontalAlignment="Center"
                                       VerticalContentAlignment="Center" IsTabStop="False"/>
                            </DockPanel>
                        </Button>
                    </Canvas>
                </GroupBox>
                <Label x:Name="lblCamposRelacionados" Content="Campos Relacionados" 
					Canvas.Right="150" Canvas.Top="140"
					Padding="0" TabIndex="23" Canvas.Left="672"/>
                <ListBox x:Name="lsbCamposRelacionados" Canvas.Right="10" Canvas.Top="160"
 							     Width="300" Height="200" Background="Transparent" SelectionMode="Single"
							     TabIndex="24" Canvas.Left="583">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="ExtraBold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <CheckBox x:Name="chkExigeRequeridos" Content="? Exige Requeridos" Canvas.Top="403" 
					Canvas.Left="20" FlowDirection="RightToLeft" Padding="10,0,0,0" TabIndex="26"/>
                <Button x:Name="bttDeshacerRel" Canvas.Right="60" Canvas.Top="370" Padding="0" Margin="0"
                                Width="200" Height="22" BorderThickness="2" TabIndex="25" Canvas.Left="633">
                    <DockPanel Width="200">
                        <Label Content="Deshacer Relacion" Background="Transparent" 
                               Padding="0" DockPanel.Dock="Left" HorizontalAlignment="Center"
                               VerticalContentAlignment="Center" IsTabStop="False"/>
                    </DockPanel>
                </Button>
                <Label x:Name="lblValidar" Content="Validar Datos de la Tabla" 
                       Canvas.Right="150" Canvas.Top="403"
                       Padding="0" TabIndex="23" Canvas.Left="600"/>
                <Button x:Name="bttValidar" Canvas.Right="30" Canvas.Top="400" Padding="0" Margin="0"
                                Width="100" Height="22" BorderThickness="2" TabIndex="25" Canvas.Left="763">
                    <DockPanel Width="100">
                        <Label Content="Validar" Background="Transparent" 
                               Padding="0" DockPanel.Dock="Left" HorizontalAlignment="Center"
                               VerticalContentAlignment="Center" IsTabStop="False"/>
                    </DockPanel>
                </Button>
            </Canvas>
        </Grid>
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Canvas Name="cnvBotones" Grid.Row="0">
                <ProgressBar x:Name="pgbImportar" Canvas.Left="20" Canvas.Top="10" Width="280" Height="10"
					IsTabStop="False" TabIndex="27"/>
                <Label x:Name="lblResultado" Canvas.Left="310" Canvas.Top="7"
                       Width="220" Padding="0" Content="Registros Procesados: 0 de 0" 
                       HorizontalContentAlignment="Right" 
					TabIndex="28"/>
                <!--<Button Name="bttAceptar" Content="_Aceptar" Style="{StaticResource RecBttAceCan}"
                    Canvas.Right="140" Canvas.Top="5" TabIndex="200" />
                <Button Name="bttCancelar" Content="_Cerrar" Style="{StaticResource RecBttAceCan}" 
                    Canvas.Right="20" Canvas.Top="5" TabIndex="201"/>-->

                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
        </Grid>
    </Grid>
</src:ClsFormInterface>
