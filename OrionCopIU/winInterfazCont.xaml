<src:ClsFormInterface x:Class="WinInterfazCont"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="Interfaz Contable" Height="420" Width="540" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid Name="grdPpal" Control.LostFocus="OnPierdeFoco" Control.GotFocus="OnCogerFoco">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" Name="rwdControl"/>
            <RowDefinition MinHeight="180"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  VerticalAlignment="Center" 
                        TabIndex="1"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition MinHeight="100"/>
            </Grid.RowDefinitions>
            <Canvas Grid.Row="0">
                <Label x:Name="lblTitulo" Canvas.Left="20" Canvas.Top="15" Padding="0" 
                       Content="Genera Interfaz Contable ..." IsTabStop="False"
                       Background="Transparent" Foreground="Gray" FontSize="18" FontStyle="Italic"
                       ToolTip="Genera la interfaz contable entre las fechas seleccionadas."/>
                <Label Canvas.Left="60" Canvas.Top="50" Content="Aplicación Contable" Padding="0"/>
                <Label x:Name="txtAppContable" Canvas.Left="200" Canvas.Top="50" Width="280"
                       Style="{StaticResource RecTxtSoloLectura}"/>
            </Canvas>
            <Canvas Grid.Row="1" x:Name="cnsApolo">
                <Label x:Name="lblTipoInterfaz" Canvas.Left="20" Canvas.Top="10" 
                       Content="Tipo de Interfaz:" Padding="0"/>
                <Label x:Name="txtTipoInterface" Canvas.Left="200" 
                       Canvas.Top="10" Width="280" 
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <CheckBox x:Name="chkIdTerceroStr" Content="Id Tercero de ancho fijo" 
                              Canvas.Left="20"  Canvas.Top="40" Padding="55,0,0,0" TabIndex="3"
                              FlowDirection="RightToLeft"/>
                <Label x:Name="lblFechaDesde" Canvas.Left="20" Canvas.Top="70" 
                       Content="Fecha desde:" Padding="0"/>
                <DatePicker x:Name="dtpFechaDesde" Canvas.Left="200" Canvas.Top="70" 
                            Width="130" Padding="0" TabIndex="4"/>
                <Label x:Name="lblFechaHasta" Canvas.Left="20" Canvas.Top="100" 
                       Content="Fecha hasta:" Padding="0"/>
                <DatePicker x:Name="dtpFechaHasta" Canvas.Left="200" Canvas.Top="100" 
                            Width="130" Padding="0" TabIndex="5"/>
                <Label x:Name="lblIdComInicial" Canvas.Left="20" Canvas.Top="130" 
                       Content="Número Comprobante Inicial:" Padding="0"/>
                <TextBox x:Name="txtNroComprobanteInicial" Canvas.Left="200" 
                         Canvas.Top="130" Width="80" Background="Transparent"
                         HorizontalContentAlignment="Right" Padding="0,0,2,0" TabIndex="6"/>
            </Canvas>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
