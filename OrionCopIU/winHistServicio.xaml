<Window x:Class="WinHistServicio"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Histórico del Servicio" Height="600" Width="640" Loaded="Window_Loaded" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition MaxHeight="40"/>
            <RowDefinition MinHeight="100"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <Canvas Grid.Row="0">
            <Label Canvas.Left="20" Canvas.Top="10" Padding="0" Content="Histórico del Servicio ..."
                   Background="Transparent" Foreground="White" FontSize="18" FontStyle="Italic"
                   TabIndex="0"/>
        </Canvas>
        <Grid Grid.Row="1" x:Name="grdHistServicio">
            <Grid.RowDefinitions>
                <RowDefinition MaxHeight="90"/>
                <RowDefinition Height="210"/>
                <RowDefinition MinHeight="160"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderThickness="2" BorderBrush="Gray">
                <Canvas Grid.Row="0" x:Name="cnvEncabezado">
                    <Label x:Name="lblCarpeta" Content="Carpeta" Canvas.Left="20" Canvas.Top="10" 
					Padding="0" TabIndex="2"/>
                    <Label x:Name="txtCarpeta" Canvas.Left="130" Canvas.Top="10" Width="180"
					Style="{StaticResource RecTxtSoloLectura}" TabIndex="3"/>
                    <Label x:Name="lblCentroUtilidad" Content="Copropiedad" Canvas.Left="20" 
					Canvas.Top="35" Padding="0" TabIndex="4"/>
                    <Label x:Name="txtCentroUtilidad" Canvas.Left="130" Canvas.Top="35" Width="300" 
					Style="{StaticResource RecTxtSoloLectura}" TabIndex="5"/>
                    <Label x:Name="lblIdServicio" Content="Id. del Servicio" Canvas.Left="20" Canvas.Top="60" 
					Padding="0" TabIndex="6"/>
                    <Label x:Name="txtIdServicio" Canvas.Left="130" Canvas.Top="60" Width="60" 
					Style="{StaticResource RecTxtSoloLectura}" TabIndex="7"/>
                </Canvas>
            </Border>
            <Canvas x:Name="cnvServicios" Grid.Row="1">
                <Label Canvas.Top="10" Canvas.Left="10" Padding="0" Content="Histórico del servicio"/>
                <DataGrid x:Name="dgrHisServicios" Canvas.Left="10" Canvas.Top="30" Height="180"
                          IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                          ItemsSource="{Binding}" SelectionMode="Extended" SelectionUnit="FullRow"
                          IsReadOnly="True" IsTabStop="True" Background="Transparent" 
                          ScrollViewer.VerticalScrollBarVisibility="Visible" TabIndex="11">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="LightGray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="No." Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Center" Text="{Binding Ordinal}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Nombre del Servicio" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             Text="{Binding Nombre}" IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Fecha Cálculo" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             Text="{Binding FechaCreacion, StringFormat={}{0:dd/MM/yyyy hh:mm:ss tt}}" IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Per.Ini." Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" 
                                             Text="{Binding PeriodoInicio}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Cant.Perio." Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Right" 
                                             Text="{Binding CantidadPeriodos}" 
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Canvas>
            <Canvas Grid.Row="2" x:Name="cnvModulos">
                <Label Canvas.Top="10" Canvas.Left="30" Padding="0" 
                       Content="Modulos Contribuyentes al Servicio seleccionado"/>
                <Label Canvas.Top="7" Canvas.Left="320" Padding="0" 
                       Content="Valor Total"/>
                <Label x:Name="txtVlrTotal" Canvas.Top="7" Canvas.Left="400" 
                         Width="150" Background="Transparent" Style="{StaticResource RecTxtSoloLectura}"
                         IsTabStop="False" HorizontalContentAlignment="Right"/>
                <DataGrid x:Name="dgrHisModulosServicio" Canvas.Left="30" Canvas.Top="30" Height="160"
                          IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                          ItemsSource="{Binding}" SelectionMode="Extended" SelectionUnit="FullRow"
                          IsReadOnly="True" IsTabStop="True" Background="Transparent" 
                          ScrollViewer.VerticalScrollBarVisibility="Visible" TabIndex="11">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="LightGray"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Id. Modulo" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Center" 
                                             Text="{Binding IdModuloContribucion}"
                                             IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Nombre del Modulo Contribuyente" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             Text="{Binding Nombre}" IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Valor" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             Text="{Binding Valor, StringFormat={}{0:c}}"
                                             HorizontalContentAlignment="Right" IsReadOnly="True"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Canvas>
        </Grid>
        <Canvas Grid.Row="2">
            <Button Name="bttCerrar" Content="_Cerrar" Style="{StaticResource RecBttAceCan}"
                    Canvas.Right="30" Canvas.Bottom="5" TabIndex="200" />
        </Canvas>
    </Grid>
</Window>
