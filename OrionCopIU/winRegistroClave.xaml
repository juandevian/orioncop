<src:ClsFormInterface x:Class="WinRegistroClave"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="Registro Clave Complementaria" Height="420" Width="400" WindowStyle="SingleBorderWindow" 
            WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png">
    <Grid Name="grdPpal" Control.LostFocus="OnPierdeFoco"
          Control.GotFocus="OnCogerFoco">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"  Name="rwdControl"/>
            <RowDefinition MinHeight="100" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel x:Name="PanelControl" Grid.Row="0" Margin="0,10,0,0">
            <!--Label Relleno-->
            <Label Height="10" DockPanel.Dock="Top"/>
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
        </DockPanel>
        <Canvas Grid.Row="1">
            <Label x:Name="lblAviso" Canvas.Left="30" Canvas.Top="20" Padding="5"
                    BorderBrush="Gray" BorderThickness="2"/>
            <Label x:Name="lblLicencia" Canvas.Left="30" Canvas.Top="100" 
                Content="Licencia de Uso" Padding="0"/>
            <Label x:Name="txtPrefijoApp" Canvas.Left="170" Canvas.Top="100" 
                Width="40" Style="{StaticResource RecTxtSoloLectura}"/>
            <Label x:Name="txtPrefijoEdi" Canvas.Left="220" Canvas.Top="100" 
                Width="40" Style="{StaticResource RecTxtSoloLectura}"/>
            <TextBox x:Name="txtIdLicencia" Canvas.Left="270" Canvas.Top="100" Width="80"
                    Background="Transparent" TabIndex="1"/>
            <Label x:Name="lblClaveIns" Canvas.Left="30" Canvas.Top="140" 
                Content="Clave de Instalación" Padding="0"/>
            <Label x:Name="txtClaveIns" Canvas.Left="170" Canvas.Top="140" 
                Width="180" Style="{StaticResource RecTxtSoloLectura}"/>
            <Label x:Name="lblClaveCom" Canvas.Left="30" Canvas.Top="180" 
                Content="Clave Complementaria" Padding="0"/>
            <TextBox x:Name="txtClaveCom" Canvas.Left="170" Canvas.Top="180" Width="180"
                    Background="Transparent" TabIndex="1"/>
            <Label x:Name="lblIdTitular" Canvas.Left="30" Canvas.Top="220" 
                Content="Id. Titular de la Licencia" Padding="0"/>
            <TextBox x:Name="txtIdTitular" Canvas.Left="170" Canvas.Top="220" Width="180"
                    Background="Transparent" TabIndex="1"/>
            <Label x:Name="lblNombreTit" Canvas.Left="30" Canvas.Top="260" 
                Content="Nombre del Titular" Padding="0"/>
            <Label x:Name="txtNombreTit" Canvas.Left="170" Canvas.Top="260" 
                Width="180" Style="{StaticResource RecTxtSoloLectura}"/>
        </Canvas>
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
        </Grid>
    </Grid>
</src:ClsFormInterface>
