<src:ClsFormInterface x:Class="WinInformeCont"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
        Title="Informe de Contingencia" Height="450" Width="760"
        WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid Name="grdPpal">
        <Grid.RowDefinitions>
            <RowDefinition Height="95"  Name="rwdControl"/>
            <RowDefinition MinHeight="200" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel Name="PanelControl" Grid.Row="0" >
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
                  VerticalAlignment="Center"/>
        </DockPanel>
        <Canvas Grid.Row="1"  TextBox.LostFocus="OnPierdeFoco" TextBox.GotFocus="OnCogerFoco">
            <TextBox x:Name="txtIdInformeCont" Canvas.Left="195" Canvas.Top="10" Width="60" Text="12"
                     HorizontalContentAlignment="Right" TabIndex="1" Height="18"/>
            <Label Canvas.Left="45" Canvas.Top="11" Content="Número del Documento" Padding="0"/>
            <Label Canvas.Left="296" Canvas.Top="11" Content="Nombre del Documento" Padding="0" Height="16" Width="142"/>
            <Label x:Name="txtNomDoc" Canvas.Left="446" Canvas.Top="10" Width="231"
                   HorizontalContentAlignment="Left" Style="{StaticResource RecTxtSoloLectura}"/>
            <Label x:Name="lblFecIniCon" Canvas.Left="45" Canvas.Top="45" 
                   Content="Fecha Inicio Contingencia" Padding="0"/>
            <DatePicker x:Name="dtpFechaIni" Canvas.Left="195" Canvas.Top="40" Grid.Row="1" Width="100"
                        TabIndex="2"/>
            <Label Canvas.Left="315" Canvas.Top="45" Content="Hora" Padding="0"/>
            <TextBox x:Name="txtHoraIni" Canvas.Left="355" Canvas.Top="44" Width="30" Text="12"
                     HorizontalContentAlignment="Center" TabIndex="3" Height="18"/>
            <Label Canvas.Left="405" Canvas.Top="45" Content="Minutos" Padding="0"/>
            <TextBox x:Name="txtMinutosIni" Canvas.Left="460" Canvas.Top="44" Width="30" Text="58"
                     HorizontalContentAlignment="Center" TabIndex="4" Height="18"/>
            <Label x:Name="lblFecFinCon" Canvas.Left="45" Canvas.Top="75" 
                   Content="Fecha Fin Contingencia" Padding="0"/>
            <DatePicker x:Name="dtpFechaFin" Canvas.Left="195" Canvas.Top="70" Grid.Row="1" Width="100"
                        TabIndex="5"/>
            <Label Canvas.Left="315" Canvas.Top="75" Content="Hora" Padding="0"/>
            <TextBox x:Name="txtHoraFin" Canvas.Left="355" Canvas.Top="74" Width="30" Text="12"
                     HorizontalContentAlignment="Center" TabIndex="6" Height="18"/>
            <Label Canvas.Left="405" Canvas.Top="75" Content="Minutos" Padding="0"/>
            <TextBox x:Name="txtMinutosFin" Canvas.Left="460" Canvas.Top="74" Width="30" Text="58"
                     HorizontalContentAlignment="Center" TabIndex="7" Height="18"/>
            <Label x:Name="lblFecRadCon" Canvas.Left="45" Canvas.Top="105" 
                   Content="Fecha Radicación" Padding="0"/>
            <DatePicker x:Name="dtpFechaRad"  Canvas.Left="195" Canvas.Top="100" Grid.Row="1" Width="100" 
                        TabIndex="8"/>
            <Label Canvas.Left="315" Canvas.Top="105" Content="Hora" Padding="0"/>
            <TextBox x:Name="txtHoraRad" Canvas.Left="355" Canvas.Top="104" Width="30" Text="12"
                     HorizontalContentAlignment="Center" TabIndex="9" Height="18"/>
            <Label Canvas.Left="405" Canvas.Top="105" Content="Minutos" Padding="0"/>
            <TextBox x:Name="txtMinutosRad" Canvas.Left="460" Canvas.Top="104" Width="30" Text="58"
                     HorizontalContentAlignment="Center" TabIndex="10" Height="18"/>
            <Label x:Name="lblFacIniCon" Canvas.Left="45" Canvas.Top="136" 
                   Content="Nro. Inicial Factura Contingencia" Padding="0"/>
            <Label x:Name="txtPrefFacIni" Canvas.Left="247" Canvas.Top="135" Width="48"
                   HorizontalContentAlignment="Right" Style="{StaticResource RecTxtSoloLectura}"/>
            <TextBox x:Name="txtIdFacIniCon" Canvas.Left="300" Canvas.Top="135" Width="80" Text="1236569"
                     HorizontalContentAlignment="Right" TabIndex="11" Height="18"/>
            <Label x:Name="lblFacFinCon" Canvas.Left="45" Canvas.Top="166" 
                   Content="Nro. Final Factura Contingencia" Padding="0"/>
            <Label x:Name="txtPrefFacFin" Canvas.Left="247" Canvas.Top="165" Width="48"
                   HorizontalContentAlignment="Right" Style="{StaticResource RecTxtSoloLectura}"/>
            <TextBox x:Name="txtIdFacFinCon" Canvas.Left="300" Canvas.Top="165" Width="80" Text="1236569"
                     HorizontalContentAlignment="Right" TabIndex="12" Height="18"/>
            <Label x:Name="lblComentario" Canvas.Left="45" Canvas.Top="196" 
                   Content="Comentario" Padding="0"/>
            <TextBox x:Name="txtComentario" Canvas.Left="195" Canvas.Top="195" Width="482"
                     HorizontalContentAlignment="Left" TabIndex="12" Height="49" TextWrapping="Wrap"/>
        </Canvas>

        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
