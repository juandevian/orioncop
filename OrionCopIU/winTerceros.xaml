<src:ClsFormInterface x:Class="WinTerceros"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" 
    Title="Ventana Terceros" Height="520" Width="790"
    WindowStyle="SingleBorderWindow" WindowStartupLocation="CenterScreen" 
    Icon="RecImagenes/OrionLogo24.png">
    <Window.Resources>
        <MenuItem Header="Opciones de _Fotografía" x:Name="MnuOpcionesFotos" x:Key="RecMnuOpcFoto"
                  Style="{StaticResource RecMnuItemPri}">
            <Separator/>
        </MenuItem>
    </Window.Resources>
    <Grid x:Name="grdPpal" MenuItem.Click="OnMenuClic" LostFocus="OnPierdeFoco"
		GotFocus="OnCogerFoco" Selector.SelectionChanged="OnCboCambio">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="rwdControl" Height="95"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel x:Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan"/>
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
                  VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="1" Button.Click="OnBotonClic">
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="500*"/>
            </Grid.RowDefinitions>
            <GridSplitter Grid.Row="1"  Background="Gray" HorizontalAlignment="Stretch" 
				IsTabStop="False" VerticalAlignment="Top"
				Height="2" Opacity=".5"/>
            <Canvas x:Name="Encabezado" Grid.Row="0">
                <Label x:Name="lblNroDoc" Content="Número Identificación" Canvas.Left="30" 
                       Canvas.Top="3" Padding="0"/>
                <TextBox x:Name="txtNroDoc" Canvas.Left="30" Canvas.Top="20" Width="120" 
					TabIndex="1"/>
                <Label x:Name="lblTipoDoc" Content="Tipo Identificación" Canvas.Left="170" Canvas.Top="3" 
					Padding="0"/>
                <ComboBox x:Name="cboTipoDoc" Canvas.Left="170" Canvas.Top="20" Width="170"  
                          Padding="6,1,1,1" TabIndex="2" />
                <Label x:Name="lblDigitoVerificacion" Content="D.V." Canvas.Left="360" 
                       Canvas.Top="3" Padding="0"/>
                <TextBox x:Name="txtDigVer" Canvas.Left="360" Canvas.Top="20" 
                         Width="15" TabIndex="3"/>
                <Label x:Name="lblTipoTercero" Content="Tipo Tercero" 
                               Canvas.Left="400" Canvas.Top="3" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                <ComboBox x:Name="cboTipoTercero" Canvas.Left="400" 
                                          Canvas.Top="20" Width="170" TabIndex="4" 
                                          Padding="6,1,1,1" />
                <Label x:Name="lblNomCompleto" Content="Nombre Completo" Canvas.Left="30" 
                       Canvas.Top="46" 
					    Padding="0"/>
                <Label x:Name="lblNombreCompleto" Canvas.Left="170" Canvas.Top="45"
                       Width="460" Style="{StaticResource RecTxtSoloLectura}"/>
            </Canvas>
            <TabControl x:Name="tbcTerceros" Grid.Row="1" Style="{StaticResource RecTabCtrl}"
                        TabIndex="6">
                <TabItem x:Name="tbiId" Header="Nombre" 
                         Style="{StaticResource RecTabItem}" Width="200" TabIndex="7">
                    <Canvas x:Name="cnvId" Grid.Row="1">
                        <GroupBox x:Name="grbDatosPersonas" Header="Conformación Nombre" Width="440" 
                                  Height="160" Canvas.Left="30" Canvas.Top="30" 
                                  IsTabStop="True" Style="{StaticResource RecFuenteNormal}" d:IsHidden="True">
                            <Canvas>
                                <Label x:Name="lblApellido1" Content="Primer Apellido" 
                                       Canvas.Left="20" Canvas.Top="16" Padding="0"/>
                                <TextBox x:Name="txtApellido1" Canvas.Left="180" 
                                         Width="220" Canvas.Top="15" TabIndex="15" />
                                <Label x:Name="lblApellido2" Content="Segundo Apellido" 
                                       Canvas.Left="20" Canvas.Top="47" Padding="0"/>
                                <TextBox x:Name="txtApellido2" Canvas.Left="180" 
                                         Width="220" Canvas.Top="45" TabIndex="16"/>
                                <Label x:Name="lblNombre1" Content="Primer Nombre" 
                                       Canvas.Left="20" Canvas.Top="76" Padding="0"/>
                                <TextBox x:Name="txtNombre1" Canvas.Left="180" 
                                         Canvas.Top="75" Width="220" TabIndex="17" />
                                <Label x:Name="lblNombre2" Content="Segundo Nombre" 
                                       Canvas.Left="20" Canvas.Top="107" Padding="0"/>
                                <TextBox x:Name="txtNombre2" Canvas.Left="180" 
                                         Canvas.Top="105" Width="220" TabIndex="18" />
                            </Canvas>
                        </GroupBox>
                        <GroupBox x:Name="grbDatosEmpresas" Header="Datos Empresa" 
                                  Width="440" Height="130" Canvas.Left="30" 
                                  Canvas.Top="30" IsTabStop="False" 
                                  Style="{StaticResource RecFuenteNormal}">
                            <Canvas>
                                <Label x:Name="lblRazonSocial" Content="Razón Social" 
                                       Canvas.Left="20" Canvas.Top="15" Padding="0"/>
                                <TextBox x:Name="txtRazonSocial" Canvas.Left="20" 
                                         Canvas.Top="35" Width="395" Height="48" 
                                         HorizontalAlignment="Left" TextAlignment="Justify" 
                                         TextWrapping="Wrap" TabIndex="15"/>
                            </Canvas>
                        </GroupBox>
                        <Label x:Name="lblFechaIngreso" Content="Fecha de Ingreso" 
                               Canvas.Left="30" Canvas.Top="220" 
                               Style="{StaticResource RecFuenteNormal}" Padding="0"/>
                        <Label x:Name="txtFechaIngreso" Canvas.Left="157" 
                                       Canvas.Top="220" Width="150" 
                                       Style="{StaticResource RecTxtSoloLectura}" />
                        <GridSplitter Background="Gray" VerticalAlignment="Top" 
                                      IsTabStop="False" HorizontalAlignment="Stretch"  
                                      Height="2" Opacity=".5" Canvas.Top="491" Width="973"/>
                        <CheckBox x:Name="chkMostrarFoto" Content="Mostrar Fotografía" 
                                  Canvas.Top="20" Canvas.Left="536" TabIndex="19"
                                  Style="{StaticResource RecFuenteNormal}"/>
                        <Border Canvas.Left="536" Canvas.Top="40" BorderBrush="Gray" 
                                BorderThickness="2" >
                            <Border.ContextMenu>
                                <ContextMenu x:Name="MnuOpcionesFotosC">
                                    <MenuItem Header="A_sociar Fotografía" x:Name="MnuAsociarFotoC" 
                                              Style="{StaticResource RecMnuItemSec}"
                                              ToolTip="Asocia una nueva Foto al tercero." />
                                    <MenuItem Header="S_uprimir Fotografía" x:Name="MnuSuprimirFotoC" 
                                              Style="{StaticResource RecMnuItemSec}"
                                              ToolTip="Suprime la Foto actual."/>
                                    <Separator/>
                                    <MenuItem Header="_Rotar Fotografía" x:Name="MnuRotarFotoC" 
                                              Style="{StaticResource RecMnuItemSec}"
                                              ToolTip="Muestra rotativamente las Fotos asociadas."/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Image x:Name="imgFoto" Height="135" Width="135" Stretch="Uniform"/>
                        </Border>
                        <Label x:Name="lblFechaFoto" Content="Fecha Foto: " Canvas.Left="536"
                               Canvas.Top="185" Style="{StaticResource RecFuenteNormal}" 
                               Padding="0"/>
                    </Canvas>
                </TabItem>
                <TabItem x:Name="tbiLocaliza" Header="Localización" 
                         Style="{StaticResource RecTabItem}" Width="200" TabIndex="30">
                    <Canvas x:Name="cnvLocaliza" Grid.Row="1">
                        <Label x:Name="lblDireccion1" Content="Dirección 1" Canvas.Left="50" 
                               Canvas.Top="13" Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtDireccion1" Canvas.Left="160" Canvas.Top="10" 
                                 Width="490" TabIndex="31"/>
                        <Label x:Name="lblDireccion2" Content="Dirección 2" Canvas.Left="50" 
                               Canvas.Top="37" Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtDireccion2" Canvas.Left="160" Canvas.Top="40
                                 " Width="490" 
                                 TabIndex="32"/>
                        <Label x:Name="lblPaisDir" Content="País" Canvas.Left="50" Canvas.Top="73" 
                               Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                        <ComboBox x:Name="cboPaisDir" Canvas.Left="160" Canvas.Top="70" Width="200"
                                  Padding="6,1,1,1" TabIndex="33"/>
                        <TextBox x:Name="txtPaisDir" Canvas.Left="160" 
                                         Width="200" Canvas.Top="70" Height="21"/>
                        <Label x:Name="lblDptoDir" Content="Departamento" Canvas.Left="50" 
                               Canvas.Top="103" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                        <ComboBox x:Name="cboDptoDir" Canvas.Left="160" Canvas.Top="100" 
                                  Width="200" Padding="6,1,1,1" TabIndex="35"/>
                        <TextBox x:Name="txtDptoDir" Canvas.Left="160" Canvas.Top="100" 
                                 Width="200" TabIndex="35"/>
                        <Label x:Name="lblCiudadDir" Content="Ciudad" Canvas.Left="50" 
                               Canvas.Top="133" Padding="0" 
                               Style="{StaticResource RecFuenteNormal}"/>
                        <ComboBox x:Name="cboCiudadDir" Canvas.Left="160" Canvas.Top="130" 
                                  Width="200" Padding="6,1,1,1" TabIndex="36"/>
                        <TextBox x:Name="txtCiudadDir" Canvas.Left="160" Canvas.Top="130" 
                                 Width="200" TabIndex="36"/>
                        <Label x:Name="lblCodPostal" Content="Código Postal" Canvas.Left="50" 
                               Canvas.Top="163" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtCodPostal" Canvas.Left="160" Canvas.Top="160" 
                                 Width="200" TabIndex="36"/>
                        <Label x:Name="lblMovil" Content="Telefono Celular 1" Canvas.Left="420" 
                               Canvas.Top="73" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtMovil" Canvas.Left="540" Canvas.Top="70" Width="110"  
                                 TabIndex="38"/>
                        <Label x:Name="lblMovil2" Content="Telefono Celular 2" Canvas.Left="420" 
                               Canvas.Top="103" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtMovil2" Canvas.Left="540" Canvas.Top="100" Width="110"  
                                 TabIndex="39"/>
                        <Label x:Name="lblTelefono1" Content="Telefono Fijo 1" 
                               Canvas.Left="420" Canvas.Top="133" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtTelefono1" Canvas.Left="540" Canvas.Top="130" 
                                 Width="110"  TabIndex="40"/>
                        <Label x:Name="lblTelefono2" Content="Telefono Fijo 2" 
                               Canvas.Left="420" Canvas.Top="163" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtTelefono2" Canvas.Left="540" Canvas.Top="160" 
                                 Width="110" TabIndex="41"/>
                        <Label x:Name="lblPaginaWeb" Content="Página Web" Canvas.Left="50" 
                               Canvas.Top="193" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtPaginaWeb" Canvas.Left="160" Canvas.Top="190" 
                                 Width="490" TabIndex="42"/>
                        <Label x:Name="lblEmail" Content="Cuenta eMail" Canvas.Left="50" 
                               Canvas.Top="223" Padding="0"
                               Style="{StaticResource RecFuenteNormal}"/>
                        <TextBox x:Name="txtEmail" Canvas.Left="160" Canvas.Top="220" 
                                 Width="490" TabIndex="43"/>
                    </Canvas>
                </TabItem>
            </TabControl>
        </Grid>
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
        </Grid>
    </Grid>
</src:ClsFormInterface>
