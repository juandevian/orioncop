<src:ClsFormInterface x:Class="WinAutorizaDscto"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="Autorización de Descuento" Height="300" Width="400" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid Name="grdPpal" Control.LostFocus="OnPierdeFoco"
          Control.GotFocus="OnCogerFoco">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" Name="rwdControl"/>
            <RowDefinition MinHeight="100"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel Name="PanelControl" Grid.Row="0">
            <!--Label Relleno-->
            <Label Height="10" DockPanel.Dock="Top"/>
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Canvas x:Name="CnvUno" Grid.Row="0" Grid.Column="0">
                <Label x:Name="lblCarpeta" Content="Carpeta de Trabajo actual" Canvas.Left="25" 
                       Canvas.Top="10" Padding="0" />
                <Label x:Name="txtCarpetaActual" Canvas.Left="180"
                       Canvas.Top="10" Width="180" 
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblCenUtilidad" Content="Copropiedad actual" Canvas.Left="25" 
                       Canvas.Top="45" Padding="0" />
                <Label x:Name="txtCenUtilActual" Canvas.Left="180"
                       Canvas.Top="45" Width="180" 
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblIdUsuario" Content="Usuario" Canvas.Left="105" 
                       Canvas.Top="80" Padding="0"/>
                <TextBox x:Name="txtUsuario" Canvas.Left="180" Canvas.Top="80" 
                         Width="180"  TabIndex="2" />
                <Label x:Name="lblContrasena" Content="Contraseña" Canvas.Left="105" 
                       Canvas.Top="115" Padding="0"/>
                <PasswordBox x:Name="pwbContrasena" Canvas.Left="180" Canvas.Top="115" 
                             Width="180"  TabIndex="3"/>
                <Image Source="RecImagenes/LogOn.png" Height="70" Width="70" 
                       Canvas.Left="20" Canvas.Top="80"/>
            </Canvas>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
