<Application x:Class="Application"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MWOrionCop.xaml" Startup="Application_Startup" ShutdownMode="OnExplicitShutdown">
    <!--<Application.Resources>
        <ResourceDictionary Source="pack://application:,,,/OriWin;component/dicPanRecursos.xaml"/>
    </Application.Resources>-->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OriWin;component/dicPanRecursos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Aquí ya puedes agregar tu estilo global -->
            <Style TargetType="Control">
                <Setter Property="FontSize" Value="12"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>