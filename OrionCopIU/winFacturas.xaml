<src:ClsFormInterface x:Class="WinFacturas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    Title="Cuenta de Cobro" Height="585" Width="955" WindowStyle="SingleBorderWindow"
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid x:Name="grdPpal" LostFocus="OnPierdeFoco" Button.Click="OnBotonClic"
          MenuItem.Click="OnMenuClic" GotFocus="OnCogerFoco"
          ComboBox.SelectionChanged="OnCboCambio">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" x:Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel x:Name="PanelControl" Grid.Row="0" d:IsHidden="True">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
                  VerticalAlignment="Center"/>
        </DockPanel>
        <Canvas x:Name="cnvFacturas" Grid.Row="1" Visibility="Visible">
            <Label x:Name="lblLista" Canvas.Left="280" FontWeight="Bold" FontSize="16"
                   Content="Lista Cuentas de Cobro"/>
            <DataGrid x:Name="dgrFacturas" Canvas.Top="30" Canvas.Left="90" Height="370"
                      AutoGenerateColumns="False" 
                      ToolTip="Doble clic o clic contrario abre el documento seleccionado!"
                      VerticalScrollBarVisibility="Visible" IsReadOnly="False"
                      IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding}"
                      Background="Transparent" IsTabStop="False"
                      Style="{StaticResource RecFuenteNormal}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Fecha" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding FechaFactura , StringFormat='dd/MM/yyyy'}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Pref." Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding Prefijo}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Número" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding IdFactura}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Pred. Agr." Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding IdPredioAgrupador}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Id. Cliente" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding IdTerceroCliente}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Nombre Cliente" Width="270">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding NombreCompleto}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Valor" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Right"
                                         Padding="0,0,5,0" IsReadOnly="True"
                                         Text="{Binding ValorFactura, StringFormat=\{0:c\}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Canvas>
        <Canvas Grid.Row="1" x:Name="cnvConsulta" Visibility="Hidden" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="rwdGralCons" Height="100"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>
                <Canvas x:Name="cnvGenerales" Grid.Row="0" Background="Transparent">
                    <Label x:Name="lblIdFactura" Content="Id." Padding="0"
                		Canvas.Left="10" Canvas.Top="11"/>
                    <Border Canvas.Left="30" Canvas.Top="7" BorderBrush="Gray" BorderThickness="1" 
                            CornerRadius="0" Width="230" Height="28">
                        <Canvas>
                            <Label x:Name="lblPref" Content="Pref." Padding="0"
                                   Canvas.Left="2" Canvas.Top="3" />
                            <ComboBox x:Name="cboPref" Canvas.Left="30" Canvas.Top="3" Width="58"
                                     TabIndex="1" Height="19"/>
                            <Label x:Name="lblIdRecibo" Content="Número" Padding="0"
                                   Canvas.Left="100" Canvas.Top="3" />
                            <TextBox x:Name="txtIdFactura" Canvas.Left="160" Canvas.Top="2" 
                                     Width="60" HorizontalContentAlignment="Right" TabIndex="2" />
                        </Canvas>
                    </Border>
                    <Label x:Name="lblIdCliente" Content="Cliente" Padding="0"
                           Canvas.Left="280" Canvas.Top="10"/>
                    <Label x:Name="txtIdCliente" Canvas.Left="327" Canvas.Top="10" Width="80"
                           Style="{StaticResource RecTxtSoloLectura}" Padding="0"/>
                    <Label x:Name="txtNombreCliente" Canvas.Left="410" Canvas.Top="10" Width="310"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label x:Name="lblEstado" Canvas.Left="525" Canvas.Top="40"
                           Content="Estado" Padding="0" />
                    <Label x:Name="txtEstado" Canvas.Left="610" Canvas.Top="40" Width="110"
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                       HorizontalContentAlignment="Center"/>
                    <Label Canvas.Left="737" Canvas.Top="10" Content="Fecha" 
                       FontWeight="Bold" Padding="0"/>
                    <Label x:Name="txtFechaFacturaP" Canvas.Left="780" Canvas.Top="10"
                       Width="100" FontWeight="Bold" HorizontalContentAlignment="Right"
                       Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label Canvas.Left="737" Canvas.Top="40" Content="Valor" Padding="0"
                       FontWeight="Bold"/>
                    <Label x:Name="txtValorF" Canvas.Left="780" Canvas.Top="40"
                       Width="100" Style="{StaticResource RecTxtSoloLectura}" 
                       HorizontalContentAlignment="Right" FontWeight="Bold"/>
                    <Label x:Name="lblIdPredioAgru" Canvas.Left="10" Canvas.Top="40"
                       Content="Predio Agrupador" Padding="0"/>
                    <Label x:Name="txtIdPredioAgru" Canvas.Left="125" Canvas.Top="40" Width="119"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label x:Name="lblModoFacturacion" Content="Modo de generación" Padding="0"
                           Canvas.Left="270" Canvas.Top="40"/>
                    <Label x:Name="txtModoFacturacion" Canvas.Left="400" Canvas.Top="40" Width="100"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label x:Name="lblRefPago" Content="Referencia de Pago" Canvas.Left="10" 
                           Canvas.Top="70" Padding="0" Visibility="Collapsed"/>
                    <Label x:Name="txtRefPago" Canvas.Left="134" Canvas.Top="70" Width="110"
                           Style="{StaticResource RecTxtSoloLectura}" Visibility="Collapsed"/>
                    <Label x:Name="lblFormaPagoCons" Content="Forma de Pago" 
                               Canvas.Left="270" Canvas.Top="70" Padding="0"/>
                    <Label x:Name="txtFormaPago" Canvas.Left="400" Canvas.Top="70" Width="100"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                    <Label x:Name="lblMedPagoCons" Content="Medio Pago" 
                               Canvas.Left="525" Canvas.Top="70" Padding="0"/>
                    <Label x:Name="txtIdMedPag" Canvas.Left="600" Canvas.Top="70" Width="120"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                </Canvas>
                <GridSplitter Grid.Row="1" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5" d:IsHidden="True"/>
                <Grid Grid.Row="1">
                    <TabControl x:Name="tbcFacturas" Style="{StaticResource RecTabCtrl}" 
                            TabItem.MouseUp="OnRatonUp" Margin="0,5,0,0" Background="Transparent">
                        <TabItem x:Name="tbiFactura" Header="Datos del Cobro" TabIndex="3"
                             Style="{StaticResource RecTabItem}" Width="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="90"/>
                                    <RowDefinition MinHeight="100"/>
                                </Grid.RowDefinitions>
                                <Canvas x:Name="cnvDatosFactura" Grid.Row="0" Grid.ColumnSpan="3">
                                    <Label x:Name="lblFechaFactura" Canvas.Left="85" Canvas.Top="11"
                                           Content="Fecha Documento" Padding="0"
                                           Style="{StaticResource RecFuenteNormal}"/>
                                    <Label x:Name="txtFechaFactura" Canvas.Left="245" Canvas.Top="10"
                                           Width="85" Style="{StaticResource RecTxtSoloLectura}"/>
                                    <Label x:Name="lblFechaVencimiento" Canvas.Left="85" Canvas.Top="36" 
                                           Content="Fecha Vencimiento" Padding="0"
                                           Style="{StaticResource RecFuenteNormal}"/>
                                    <Label x:Name="txtFechaVencimiento" Canvas.Left="245" Canvas.Top="35" 
                                           Width="85" Style="{StaticResource RecTxtSoloLectura}"/>
                                    <Label x:Name="lblFechaEstadoFac" Canvas.Left="85" Canvas.Top="61"
                                           Content="Fecha Estado Fac." Padding="0"
                                           Style="{StaticResource RecFuenteNormal}"/>
                                    <Label x:Name="txtFechaEstadoFac" Canvas.Left="245" Canvas.Top="60" 
                                           Width="85" Style="{StaticResource RecTxtSoloLectura}" />
                                    <Label x:Name="lblValorFactura" Canvas.Left="415" Canvas.Top="11" 
                                       Content="Valor Documento" Padding="0"
                                       Style="{StaticResource RecFuenteNormal}"/>
                                    <Label x:Name="txtValorFactura" Canvas.Left="515" Canvas.Top="10" 
                                           Width="100" Style="{StaticResource RecTxtSoloLectura}" 
                                           HorizontalContentAlignment="Right"/>
                                    <Label x:Name="lblDebitos" Canvas.Left="415" Canvas.Top="36" 
                                           Content="Débitos" Padding="0"
                                           Style="{StaticResource RecFuenteNormal}"/>
                                    <Label x:Name="txtDebitos" Canvas.Left="515" Canvas.Top="35" 
                                           Width="100" Style="{StaticResource RecTxtSoloLectura}" 
                                           HorizontalContentAlignment="Right"/>
                                    <Label x:Name="lblCreditos" Canvas.Left="415" Canvas.Top="61" 
                                           Content="Créditos" Padding="0"
                                           Style="{StaticResource RecFuenteNormal}"/>
                                    <Label x:Name="txtCreditos" Canvas.Left="515" Canvas.Top="60" 
                                           Width="100" Style="{StaticResource RecTxtSoloLectura}" 
                                           HorizontalContentAlignment="Right"/>
                                    <Label Canvas.Left="687" Canvas.Top="11" 
                                           Style="{StaticResource RecFuenteNormal}"
                                           Content="Deuda Capital" Padding="0"/>
                                    <Label x:Name="txtSaldoCap" Canvas.Left="780" 
                                           Canvas.Top="10" Width="100" 
                                           Style="{StaticResource RecTxtSoloLectura}"  
                                           HorizontalContentAlignment="Right"/>
                                    <Label Canvas.Left="687" Canvas.Top="36" 
                                           Style="{StaticResource RecFuenteNormal}"
                                           Content="Deuda Int.Mora" Padding="0"
                                           ToolTip="Deuda por intereses de mora causados a esta cuenta de cobro"/>
                                    <Label x:Name="txtSaldoMora" Canvas.Left="780" Canvas.Top="35" Width="100" 
                                           Style="{StaticResource RecTxtSoloLectura}" 
                                           ToolTip="Deuda por intereses de mora causados a esta cuenta de cobro"
                                           HorizontalContentAlignment="Right"/>
                                    <Label Canvas.Left="687" Canvas.Top="61" 
                                           Style="{StaticResource RecFuenteNormal}"
                                           Content="Total Deuda" FontWeight="Bold" Padding="0"/>
                                    <Label x:Name="txtSaldo" Canvas.Left="780" Canvas.Top="60" Width="100" 
                                           Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold" 
                                           HorizontalContentAlignment="Right"/>
                                </Canvas>
                                <DataGrid x:Name="dgrItemsFactura" Grid.Row="1"
                                          IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                                          ItemsSource="{Binding}" SelectionMode="Extended" 
                                          SelectionUnit="FullRow" Background="Transparent"
                                          IsReadOnly="True" TabIndex="5" Margin="5,0,4,5"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource RecFuenteNormal}" Grid.ColumnSpan="3">
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="LightGray"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Id." Width="30">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" 
                                                             HorizontalAlignment="Left" 
                                                             Text="{Binding IdItemFactura}"
                                                             IsReadOnly="True"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Detalle" Width="310">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" 
                                                             HorizontalAlignment="Left" 
                                                             Text="{Binding Detalle}" IsReadOnly="True"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Fec. Vence" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" 
                                                             HorizontalAlignment="Left" 
                                                             Text="{Binding FechaVencimiento, StringFormat={}{0:dd/MM/yyyy}}"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Fec. Gracia" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" 
                                                             HorizontalAlignment="Left" 
                                                             Text="{Binding FechaPagoSinMora, StringFormat={}{0:dd/MM/yyyy}}"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Valor" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" 
                                                             Text="{Binding Valor, StringFormat={}{0:c}}" 
                                                             HorizontalAlignment="Right" IsReadOnly="True"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Débitos" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" HorizontalAlignment="Right" 
                                                             Text="{Binding Debitos, StringFormat={}{0:c}}"
                                                             IsReadOnly="True" 
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Créditos" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" HorizontalAlignment="Right" 
                                                             Text="{Binding Creditos, StringFormat={}{0:c}}"
                                                             IsReadOnly="True"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Valor IVA" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" HorizontalAlignment="Right" 
                                                             Text="{Binding VlrIva, StringFormat={}{0:c}}"
                                                             IsReadOnly="True" 
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="% IVA" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" HorizontalAlignment="Right" 
                                                             Text="{Binding TarifaIva, StringFormat={}{0:p}}"
                                                             IsReadOnly="True" 
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="tbiMovimiento" Header="Movimiento Contable" 
                             Style="{StaticResource RecTabItem}" Width="200">
                            <DataGrid x:Name="dgrNovedades" Margin="10,5,5,0"
                                          IsSynchronizedWithCurrentItem="True"
                                          AutoGenerateColumns="False" ItemsSource="{Binding}" 
                                          SelectionMode="Extended" SelectionUnit="FullRow"
                                          IsReadOnly="True" Background="Transparent" TabIndex="7" 
                                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                                          Style="{StaticResource RecFuenteNormal}">
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="LightGray"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Id" Width="30">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" HorizontalAlignment="Left" 
                                                             IsReadOnly="True" Text="{Binding IdNovedad}"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Fecha" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" 
                                                             HorizontalAlignment="Left" IsReadOnly="True"
                                                             Text="{Binding FechaNovedad, StringFormat={}{0:dd/MM/yyyy}}"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Detalle" Width="290">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" HorizontalAlignment="Left" 
                                                             Text="{Binding ConceptoNovedad}"
                                                             IsReadOnly="True"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Cuenta Db" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" Text="{Binding IdCuentaDb}" 
                                                             IsReadOnly="True"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Cuenta Cr" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" Text="{Binding IdCuentaCr}" 
                                                             IsReadOnly="True"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Valor" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0"
                                                         IsTabStop="False" 
                                                         Text="{Binding Valor, StringFormat={}{0:c}}" 
                                                         HorizontalContentAlignment="Right" 
                                                         IsReadOnly="True"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Doc. Ori." Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" Text="{Binding DocOrigen}" 
                                                             IsReadOnly="True"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Pref.Doc." Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" Text="{Binding PrefijoDocOrigen}" 
                                                             IsReadOnly="True"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Número.Doc." Width="96">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Background="Transparent" BorderThickness="0"
                                                         IsTabStop="False" Text="{Binding IdDocOrigen}"
                                                         IsReadOnly="True" 
                                                         HorizontalContentAlignment="Right"
                                                         Style="{StaticResource RecFuenteNormal}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem x:Name="tbiEstadoCuenta" Header="Estado de la Cuenta"
                             ToolTip="Muestra el Estado de la Cuenta al momento de generarse el Documento"
                             Style="{StaticResource RecTabItem}" Width="200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22*"/>
                                    <ColumnDefinition Width="89*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100"/>
                                    <RowDefinition MinHeight="100"/>
                                </Grid.RowDefinitions>
                                <Canvas x:Name="cnvEstadoCuenta" Grid.Row="0" Grid.ColumnSpan="2">
                                    <Label Content="ESTADO DE LA CUENTA AL MOMENTO DEL DOCUMENTO" 
                                       Canvas.Top="5" Canvas.Left="5" FontWeight="Bold" FontSize="12"/>
                                    <Label x:Name="lblFechaEstado" Canvas.Top="36" Canvas.Left="30"
                                       Padding="0" Content="Fecha del Estado"
                                       Style="{StaticResource RecFuenteNormal}"/>
                                    <Label x:Name="txtFechaEstado" Canvas.Left="140" Canvas.Top="35"
                                       Width="100" Style="{StaticResource RecTxtSoloLectura}"/>
                                    <Label Canvas.Top="36" Canvas.Left="265" 
                                       Padding="0" Content="Anticipos por aplicar"
                                       Style="{StaticResource RecFuenteNormal}"/>
                                    <Label x:Name="txtAntPorApl" Canvas.Left="390" Canvas.Top="35"
                                       Width="100" HorizontalContentAlignment="Right" 
                                       Style="{StaticResource RecTxtSoloLectura}"/>
                                    <Label x:Name="lblDeudaCaiptal" Canvas.Top="66" Canvas.Left="30" 
                                       Padding="0" Content="Deuda de Capital"
                                       Style="{StaticResource RecFuenteNormal}"/>
                                    <Label x:Name="txtDeudaCaiptal" Canvas.Left="140" Canvas.Top="65"
