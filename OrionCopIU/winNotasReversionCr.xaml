<src:ClsFormInterface
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="WinNotasReversionCr"
    Title="Nota Reversión Crédito: " Height="480" Width="880" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid x:Name="grdPpal" LostFocus="OnPierdeFoco" Selector.SelectionChanged="OnCboCambio"
          GotFocus="OnCogerFoco" ButtonBase.Click="OnBotonClic" MenuItem.Click="OnMenuClic" >
        <Grid.RowDefinitions>
            <RowDefinition Height="95" x:Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel x:Name="PanelControl" Grid.Row="0" >
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
                  VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="160"/>
                <RowDefinition MinHeight="100"/>
            </Grid.RowDefinitions>
            <Canvas Grid.Row="0" x:Name="cnvEncabezado">
                <Label x:Name="lblIdNotaRCr" Content="Id." Padding="0"
                		Canvas.Left="15" Canvas.Top="11"/>
                <Border Canvas.Left="40" Canvas.Top="7" BorderBrush="Gray" BorderThickness="1" 
                            CornerRadius="0" Width="214" Height="24">
                    <Canvas>
                        <Label x:Name="lblPref" Content="Pref." Padding="0"
                                   Canvas.Left="2" Canvas.Top="3" />
                        <ComboBox x:Name="cboPref" Canvas.Left="30" Canvas.Top="1" Width="58"
                                     TabIndex="1" Height="19"/>
                        <Label x:Name="lblIdNota" Content="Número" Padding="0"
                               Canvas.Left="100" Canvas.Top="3" />
                        <TextBox x:Name="txtIdNota" Canvas.Left="150" Canvas.Top="1" 
                                 Width="60" HorizontalContentAlignment="Right" TabIndex="2" />
                    </Canvas>
                </Border>
                <DatePicker x:Name="dtpFechaNotaRRC" Canvas.Left="745" Canvas.Top="7" 
                            Width="110"  HorizontalContentAlignment="Right" 
                            FontWeight="Bold" TabIndex="3"/>
                <Label x:Name="lblIdCliente" Content="Cliente" Padding="0"
                       Canvas.Left="15" Canvas.Top="41"/>
                <Button x:Name="bttEncontrarCliente" Canvas.Left="60" Canvas.Top="40"
                        Style="{StaticResource RecEstiloBttEnc}"
                        Visibility="Visible" TabIndex="4"
                        ToolTip="Clic aqui para buscar El Cliente."/>
                <TextBox x:Name="txtIdCliente" Canvas.Left="75" Canvas.Top="40" Width="80"
                         ToolTip="Digite el signo de interrogación (?) para buscar el Cliente!"
                         HorizontalContentAlignment="Right" TabIndex="5"/>
                <Label x:Name="txtNombreCliente" Canvas.Left="160" Canvas.Top="40" 
                       Width="340" Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblFechaNota" Content="Fecha Nota" Padding="0"
                       Canvas.Left="670" Canvas.Top="11" FontWeight="Bold"/>
                <Label x:Name="lblPredioAgru" Content="Predio Agrupador" Padding="0"
                       Canvas.Left="15" Canvas.Top="71"/>
                <ComboBox x:Name="cboPredioAgru" Width="120" Canvas.Left="150" Canvas.Top="70" 
                          Padding="3,1,1,1"  Visibility="Hidden" TabIndex="6"/>
                <Label x:Name="txtPredioAgr" Canvas.Left="150" Canvas.Top="70" Width="120"
                       Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblEstado" Canvas.Left="340" Canvas.Top="11"
                       Content="Estado" Padding="0" />
                <Label x:Name="txtEstado" Canvas.Left="400" Canvas.Top="10" Width="100"
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                       HorizontalContentAlignment="Center"/>
                <Label x:Name="lblValorNota" Content="Valor Nota" Canvas.Left="670" 
                       Canvas.Top="40" Padding="0" FontWeight="Bold"/>
                <Label x:Name="txtValorNota" Canvas.Left="745" Canvas.Top="40" Width="110"
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                       HorizontalContentAlignment="Right"/>
                <Label x:Name="lblDocRev" Content="Documento a Reversar" Padding="0"
                       Canvas.Left="15" Canvas.Top="101"/>
                <ComboBox x:Name="cboDocRev" Width="120" Canvas.Left="150" Canvas.Top="100" 
                          Padding="6,1,1,1" ItemsSource="{Binding}" TabIndex="7"/>
                <Label x:Name="lblNroDoc" Content="Número Doc." Padding="0"
                       Canvas.Left="295" Canvas.Top="101"/>
                <ComboBox x:Name="cboNroDoc" Width="100" Canvas.Left="380" Canvas.Top="100"
                          Padding="3,1,1,1"  TabIndex="8" Visibility="Hidden"
                          HorizontalContentAlignment="Right"/>
                <Label x:Name="txtNroDoc" Width="100" Canvas.Left="380" Canvas.Top="100"
                       Style="{StaticResource RecTxtSoloLectura}" HorizontalContentAlignment="Right"/>
                <Label Content="Fecha Doc." Canvas.Left="510" Canvas.Top="101"
                        Padding="0" />
                <Label x:Name="txtFechaDocRev" Canvas.Left="580" Canvas.Top="100" Width="85"
                       Style="{StaticResource RecTxtSoloLectura}"
                       HorizontalAlignment="Right"/>
                <Label x:Name="lblDetalle" Content="Detalle Reversión" Canvas.Left="15" Canvas.Top="131"
                        Padding="0" />
                <TextBox x:Name="txtDetalle" Canvas.Left="150" Canvas.Top="130" Width="515"
                         TabIndex="9"/>
            </Canvas>
            <DataGrid Grid.Row="1" x:Name="dgrMovimiento"  AutoGenerateColumns="False"
                      VerticalScrollBarVisibility="Visible" IsEnabled="True"
                      HorizontalScrollBarVisibility="Auto" IsReadOnly="True" IsTabStop="True"
                      IsSynchronizedWithCurrentItem="True"
                      SelectionMode="Single"  SelectionUnit="FullRow"
                      Background="Transparent" ItemsSource="{Binding}">
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Fecha creación" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" IsReadOnly="True"
                                             Text="{Binding FechaCreacion, StringFormat=\{0:dd/MM/yyyy hh:mm:ss\}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Detalle" Width="290">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" Text="{Binding Detalle}"
                                             IsReadOnly="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Cuenta Db" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" Text="{Binding IdCuentaDb}"
                                             IsReadOnly="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Cuenta Cr" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" Text="{Binding IdCuentaCr}"
                                             IsReadOnly="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Nro. Fact." Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                             HorizontalAlignment="Left" Text="{Binding NroFac}"
                                             IsReadOnly="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Valor" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                             Text="{Binding Valor, StringFormat=\{0:c\}}" 
                                             HorizontalAlignment="Right"  
                                             IsReadOnly="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvBotones" Grid.Row="0">
                <Label x:Name="lblUsuarioGenero" Content="Usuario generó Nota" 
                           Canvas.Top="8" Canvas.Left="20"
                           Padding="0"/>
                <Label x:Name="txtUsuarioGenero" Canvas.Left="160" Canvas.Top="7" Width="120"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblUsuarioAnulo" Content="Usuario anuló Nota" 
                           Canvas.Top="8" Canvas.Left="310"
                           Padding="0"/>
                <Label x:Name="txtUsuarioAnulo" Canvas.Left="440" Canvas.Top="7" Width="120"
                           Style="{StaticResource RecTxtSoloLectura}"/>
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
