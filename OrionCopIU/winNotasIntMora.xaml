<src:ClsFormInterface x:Class="WinNotasIntMora"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" 
    Title="Nota por Intereses de Mora" Height="520" Width="810" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid x:Name="grdPpal" ComboBox.SelectionChanged="OnCboCambio"
          MenuItem.Click="OnMenuClic" GotFocus="OnCogerFoco">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" x:Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel x:Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  VerticalAlignment="Center" 
				TabIndex="1"/>
        </DockPanel>
        <Canvas x:Name="cnvNotas" Grid.Row="1" Visibility="Visible">
            <Label x:Name="lblLista" Canvas.Left="280" FontWeight="Bold" FontSize="16"
                   Content="Lista Notas (últimos dos meses)"/>
            <DataGrid x:Name="dgrNotas" Canvas.Top="30" Canvas.Left="10"  Height="290"
                      AutoGenerateColumns="False" 
                      ToolTip="Doble clic o clic contrario abre la nota seleccionada!"
                      VerticalScrollBarVisibility="Visible" IsReadOnly="False"
                      IsSynchronizedWithCurrentItem="True" ItemsSource="{Binding}"
                      Background="Transparent" IsTabStop="False"
                      Style="{StaticResource RecFuenteNormal}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Fecha" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding FechaNota , StringFormat='dd/MM/yyyy'}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Pref." Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding PrefijoNotaDb}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Número" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding IdNotaDb}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Pred. Agr." Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding IdPredioAgrupador}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Id. Cliente" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding IdTerceroCliente}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Nombre Cliente" Width="270">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         Padding="5,0,0,0" IsReadOnly="True"
                                         Text="{Binding NombreCompleto}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Valor" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Right"
                                         Padding="0,0,5,0" IsReadOnly="True"
                                         Text="{Binding Valor, StringFormat=\{0:c\}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Canvas>
        <!--Contenido especifico de la Ventana-->
        <Grid x:Name="grdNotas" Grid.Row="1" Visibility="Hidden"  >
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="400*"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvGenerales" Grid.Row="0">
                <Label x:Name="lblIdNotaDb" Content="Id." Padding="0"
                		Canvas.Left="15" Canvas.Top="11"/>
                <Border Canvas.Left="40" Canvas.Top="7" BorderBrush="Gray" BorderThickness="1" 
                            CornerRadius="0" Width="214" Height="24">
                    <Canvas>
                        <Label x:Name="lblPref" Content="Pref." Padding="0"
                                   Canvas.Left="2" Canvas.Top="3" />
                        <ComboBox x:Name="cboPref" Canvas.Left="30" Canvas.Top="1" Width="58"
                                     TabIndex="1" Height="19"/>
                        <Label x:Name="lblIdNota" Content="Número" Padding="0"
                               Canvas.Left="100" Canvas.Top="3" />
                        <TextBox x:Name="txtIdNota" Canvas.Left="150" Canvas.Top="1" 
                                 Width="60" HorizontalContentAlignment="Right" TabIndex="2" />
                    </Canvas>
                </Border>
                <Label x:Name="lblIdCliente" Content="Cliente" Padding="0"
					Canvas.Left="15" Canvas.Top="41"/>
                <Label x:Name="txtIdCliente" Canvas.Left="60" Canvas.Top="40" Width="80"
					Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="txtNombreCliente" Canvas.Left="145" Canvas.Top="40" Width="320"
					Style="{StaticResource RecTxtSoloLectura}"/>
                <Label Canvas.Left="630" Canvas.Top="11" Content="Fecha"
                       Padding="0" FontWeight="Bold"/>
                <Label x:Name="txtFechaNotaDb" Canvas.Left="670" Canvas.Top="10" Width="100"
                       Style="{StaticResource RecTxtSoloLectura}"  FontWeight="Bold"
                       HorizontalContentAlignment="Right"/>
                <Label Canvas.Left="633" Canvas.Top="41" Content="Valor" 
                       FontWeight="Bold" Padding="0" />
                <Label x:Name="txtValorNotaDb" Canvas.Left="670" Canvas.Top="40" Width="100"
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                       HorizontalContentAlignment="Right"/>
                <Label x:Name="lblIva" Canvas.Left="561" Canvas.Top="71" Content="Valor IVA incluido"
                       FontWeight="Bold" Padding="0" />
                <Label x:Name="txtValorIva" Canvas.Left="670" Canvas.Top="70" Width="100"
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                       HorizontalContentAlignment="Right"/>
                <Label x:Name="lblIdPredioAgru" Canvas.Left="15" Canvas.Top="71"
					Content="Predio Agrupador" Padding="0"/>
                <Label x:Name="txtIdPredioAgru" Canvas.Left="145" Canvas.Top="70" Width="120"
					Style="{StaticResource RecTxtSoloLectura}"/>
                <Label Canvas.Left="320" Canvas.Top="71" Content="Origen" Padding="0"/>
                <Label x:Name="txtOrigen" Canvas.Left="365" Canvas.Top="70" Width="100"
					Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblEstado" Canvas.Left="320" Canvas.Top="11"
                       Content="Estado" Padding="0"/>
                <Label x:Name="txtEstado" Canvas.Left="365" Canvas.Top="10" Width="100"
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                       HorizontalContentAlignment="Center"/>
            </Canvas>
            <GridSplitter Grid.Row="1" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
            <TabControl Grid.Row="1"  Style="{StaticResource RecTabCtrl}"
                        TabItem.MouseUp="OnRatonUp" Margin="0,5,0,0">
                <TabItem x:Name="tbiDetalles" Header="Detalles" 
                         Style="{StaticResource RecTabItem}" Width="200">
                    <Grid x:Name="cnvDetalles">
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="50"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgrItemsNotaDb" Grid.Row="0" Style="{StaticResource RecFuenteNormal}" 
                                  IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                                  ItemsSource="{Binding}" SelectionMode="Extended" SelectionUnit="FullRow"
                                  IsReadOnly="True" Background="Transparent" TabIndex="5"
                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  Margin="40,5,40,5">
                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="LightGray"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Ordinal" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" 
                                                     Padding="5,0,0,0" IsReadOnly="True" 
                                                     Text="{Binding IdItemNotaDb}"
                                                     HorizontalContentAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Fecha Causo Mora" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                                    HorizontalAlignment="Left" IsReadOnly="True"
                                                    Text="{Binding FechaCausoMora, StringFormat=\{0:dd/MM/yyyy\}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Nro.Factura" Width="110" x:Name="dgtNroFac">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" 
                                                     Padding="5,0,0,0" IsReadOnly="True" 
                                                     Text="{Binding NroFact}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Item Fra." Width="65" x:Name="dgtItemFac">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" 
                                                     Padding="5,0,0,0" IsReadOnly="True" 
                                                     Text="{Binding IdItemFactura}"
                                                     HorizontalContentAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Base" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                                     Text="{Binding Base, StringFormat=\{0:c\}}" 
                                                     HorizontalAlignment="Right"  
                                                     IsReadOnly="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tasa" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                                     HorizontalAlignment="Right" 
                                                     Text="{Binding TasaMora,  StringFormat={}{0:#0.000%}}"
                                                     IsReadOnly="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Días Mora" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" 
                                                     Padding="5,0,0,0" IsReadOnly="True" 
                                                     Text="{Binding DiasMora}"
                                                     HorizontalContentAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Valor" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                                     HorizontalAlignment="Right" 
                                                     Text="{Binding Valor, StringFormat=\{0:c\}}"
                                                     IsReadOnly="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Canvas  x:Name="cnvDatosNotaDb" Grid.Row="1">
                            <Label x:Name="lblUsuarioGenero" Content="Usuario generó Nota" 
                                   Canvas.Top="11" Canvas.Left="20"
                                   Style="{StaticResource RecFuenteNormal}" Padding="0"/>
                            <Label x:Name="txtUsuarioGenero" Canvas.Left="170" Canvas.Top="10" 
                                   Width="120" Style="{StaticResource RecTxtSoloLectura}"/>
                            <Label x:Name="lblUsuarioAnulo" Content="Usuario anuló Nota" 
                                   Canvas.Top="11" Canvas.Left="516"
                                   Style="{StaticResource RecFuenteNormal}" Padding="0"/>
                            <Label x:Name="txtUsuarioAnulo" Canvas.Left="656" Canvas.Top="10" Width="120"
                                   Style="{StaticResource RecTxtSoloLectura}"/>
                        </Canvas>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tbiNovedades" Header="Movimiento Contable" 
                         Style="{StaticResource RecTabItem}" Width="200">
                    <DataGrid x:Name="dgrNovedades" Style="{StaticResource RecFuenteNormal}"
                                IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                                ItemsSource="{Binding}" SelectionMode="Extended" SelectionUnit="FullRow"
                                IsReadOnly="True" Background="Transparent" TabIndex="7" 
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Margin="60,10,62,0">
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="LightGray"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Número Factura" Width="120" x:Name="dgtNroFacNov">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                                    HorizontalAlignment="Left" Text="{Binding NroFac}"
                                                    IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Id. Novedad" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                                    HorizontalAlignment="Right" IsReadOnly="True"
                                                    Text="{Binding IdNovedad}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Fecha" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                                    HorizontalAlignment="Left" IsReadOnly="True"
                                                    Text="{Binding FechaNovedad, StringFormat=\{0:dd/MM/yyyy\}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cuenta Db" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                                    Text="{Binding IdCuentaDb}" IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cuenta Cr" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                                    Text="{Binding IdCuentaCr}" IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Valor" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
                                                    Text="{Binding Valor, StringFormat=\{0:c\}}" 
                                                    HorizontalAlignment="Right"  
                                                    IsReadOnly="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
			IsTabStop="False" HorizontalAlignment="Stretch"  
			Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
