<src:ClsFormInterface x:Class="WinCuentasBanco"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="Cuentas Bancarias de la Copropiedad" Height="470" Width="650" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/CtaBanco.png" FontSize="12">
    <Window.Resources>
        <MenuItem Header="Opciones de _Código QR" x:Name="MnuOpcionesQR" x:Key="RecMnuOpcQR"
                  Style="{StaticResource RecMnuItemPri}">
            <Separator/>
        </MenuItem>
    </Window.Resources>
    <Grid Name="grdPpal" Control.LostFocus="OnPierdeFoco" Button.Click="OnBotonClic" 
              Control.GotFocus="OnCogerFoco" MenuItem.Click="OnMenuClic">
        <Grid.RowDefinitions>
            <RowDefinition Height="95"  Name="rwdControl"/>
            <RowDefinition MinHeight="200" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel Name="PanelControl" Grid.Row="0" >
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  
                  VerticalAlignment="Center"/>
        </DockPanel>
        <Canvas Grid.Row="1" x:Name="cnvCuentasBanco">
            <Label x:Name="lblIdCuentabanco" Content="Id. Cuenta" Canvas.Left="40" 
                    Canvas.Top="10" Padding="0"/>
            <Label x:Name="txtIdCuenta" Canvas.Left="120" Canvas.Top="10" 
                   Width="40" Style="{StaticResource RecTxtSoloLectura}" 
                   Content="{Binding IdCuentaBanco}"/>
            <CheckBox x:Name="chkActiva" Canvas.Left="240" Canvas.Top="10" 
                      FlowDirection="RightToLeft" TabIndex="1"
                      Content="? Está Activa" Background="Transparent" IsChecked="{Binding EstaActiva}"
                      Padding="20,0,0,0"  />
            <Label x:Name="lblNombreBanco" Content="Nombre del Banco" Canvas.Left="40" 
                    Canvas.Top="41" Padding="0"/>
            <TextBox x:Name="txtNombreBanco" Canvas.Left="240" Canvas.Top="40" Width="240"
                     IsTabStop="False" Text="{Binding Path=NombreBanco}" 
                     Background="Transparent"/>
            <TextBox x:Name="txtNombreBancoNuevo" Canvas.Left="240" Canvas.Top="40" Width="240" 
                     Visibility="Hidden" TabIndex="2"/>
            <Label x:Name="lblNumeroCuenta" Content="Número de la Cuenta Bancária" Canvas.Left="40" 
                    Canvas.Top="72" Padding="0"/>
            <TextBox x:Name="txtNumeroCuenta" Canvas.Left="240" Canvas.Top="70" Width="240"
                        Background="Transparent" HorizontalContentAlignment="Left" IsTabStop="False" 
                        Text="{Binding Path=NumeroCuenta}" Height="19"/>
            <TextBox x:Name="txtNumeroCuentaNuevo" Canvas.Left="240" Canvas.Top="70" Width="240"
                        Visibility="Hidden" TabIndex="4"/>
            <Label x:Name="lblIdCtaContab" Content="Código Cuenta Contabilidad" Canvas.Left="40" 
					Canvas.Top="101" Padding="0"/>
            <Button x:Name="bttEncontrarCtaBnco" Canvas.Left="220" Canvas.Top="100"
                            Style="{StaticResource RecEstiloBttEnc}"
                            Visibility="Visible" TabIndex="5"
                            ToolTip="Clic aqui para buscar la Cuenta Contable del Banco."/>
            <TextBox x:Name="txtIdCtaContab" Canvas.Left="240" Canvas.Top="100" Width="60"
					 Background="Transparent" IsTabStop="False" 
                     Text="{Binding Path=IdCtaContabilidad}"/>
            <TextBox x:Name="txtIdCtaContabNueva" Canvas.Left="240" Canvas.Top="100" Width="60"
                        Visibility="Hidden" TabIndex="6"/>
            <Label x:Name="txtNomCtaContab" Canvas.Left="310" Canvas.Top="100" Width="170" 
					Style="{StaticResource RecTxtSoloLectura}"/>
            <Label Canvas.Left="509" Canvas.Top="5" Content="Código QR del Banco" 
                   ToolTip="Codigo QR para transferencias bancarias" Padding="0"/>
            <Border Canvas.Left="509" Canvas.Top="20" BorderBrush="Gray" 
                                BorderThickness="2" >
                <Border.ContextMenu>
                    <ContextMenu x:Name="MnuOpcionesFotosC">
                        <MenuItem Header="A_sociar Código QR" x:Name="MnuAsociarQRC" 
                                              Style="{StaticResource RecMnuItemSec}"
                                              ToolTip="Asocia una nueva Foto al tercero." />
                        <MenuItem Header="S_uprimir Código QR" x:Name="MnuSuprimirQRC" 
                                              Style="{StaticResource RecMnuItemSec}"
                                              ToolTip="Suprime la Foto actual."/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Image x:Name="imgCodigoQR" Height="100" Width="100" Stretch="Uniform"/>
            </Border>
            <DataGrid x:Name="dgrCuentasBanco" Canvas.Left="20" Canvas.Top="135" Height="140"
                        IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                        ItemsSource="{Binding}" SelectionMode="Extended" SelectionUnit="FullRow"
                        IsReadOnly="True" IsTabStop="False" Background="Transparent" 
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Id." Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                         HorizontalContentAlignment="Left" Text="{Binding IdCuentaBanco}"
                                         IsReadOnly="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Nombre Del Banco" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                         Text="{Binding NombreBanco}" ToolTip="{Binding NombreBanco}" IsReadOnly="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Nombre de la Sucursal" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                            HorizontalContentAlignment="Left"
                                            Text="{Binding Sucursal}"
                                            IsReadOnly="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Número de la Cuenta" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
                                            HorizontalContentAlignment="Left" 
                                            Text="{Binding NumeroCuenta}"
                                            IsReadOnly="True"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Activa ?" IsReadOnly="True"
                                            IsThreeState="False" Width="50" 
                                            Binding="{Binding EstaActiva}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Canvas>
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
