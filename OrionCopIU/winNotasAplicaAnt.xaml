<src:ClsFormInterface x:Class="WinNotasAplicaAnt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" 
    Title="Notas Anticipos Aplicados" Height="460" Width="810" WindowStyle="SingleBorderWindow" 
    WindowStartupLocation="CenterScreen" Icon="RecImagenes/OrionLogo24.png" FontSize="12">
    <Grid x:Name="grdPpal" ComboBox.SelectionChanged="OnCboCambio"
          MenuItem.Click="OnMenuClic" GotFocus="OnCogerFoco">
        <Grid.RowDefinitions>
            <RowDefinition Height="95" x:Name="rwdControl"/>
            <RowDefinition MinHeight="200"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--Barra de Herramientas y Menu-->
        <DockPanel x:Name="PanelControl" Grid.Row="0">
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan" />
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Height="25" Background="Gray"  VerticalAlignment="Center" 
				TabIndex="1"/>
        </DockPanel>
        <!--Contenido especifico de la Ventana-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="400*"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvGenerales" Grid.Row="0">
                <Label x:Name="lblIdNotaCon" Content="Id." Padding="0"
                		Canvas.Left="15" Canvas.Top="10"/>
                <Border Canvas.Left="40" Canvas.Top="7" BorderBrush="Gray" BorderThickness="1" 
                            CornerRadius="0" Width="220" Height="26">
                    <Canvas>
                        <Label x:Name="lblPref" Content="Pref." Padding="0"
                                   Canvas.Left="2" Canvas.Top="3" />
                        <ComboBox x:Name="cboPref" Canvas.Left="34" Canvas.Top="2" Width="58"
                                     TabIndex="1" Height="20"/>
                        <Label x:Name="lblIdNota" Content="Número" Padding="0"
                               Canvas.Left="100" Canvas.Top="3" />
                        <TextBox x:Name="txtIdNota" Canvas.Left="155" Canvas.Top="1" 
                                 Width="60" HorizontalContentAlignment="Right" TabIndex="2" />
                    </Canvas>
                </Border>
                <Label x:Name="lblIdCliente" Content="Cliente" Padding="0"
					Canvas.Left="15" Canvas.Top="40"/>
                <Label x:Name="txtIdCliente" Canvas.Left="70" Canvas.Top="40" Width="80"
					Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="txtNombreCliente" Canvas.Left="155" Canvas.Top="40" Width="320"
					Style="{StaticResource RecTxtSoloLectura}"/>
                <Label Canvas.Left="570" Canvas.Top="10" Content="Fecha Nota" Padding="0"
                       FontWeight="Bold"/>
                <Label x:Name="txtFechaNotaConP" Canvas.Left="650" Canvas.Top="10" Width="85"
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
                       HorizontalContentAlignment="Right"/>
                <Label x:Name="lblIdPredioAgru" Canvas.Left="15" Canvas.Top="71"
					Content="Predio Agrupador" Padding="0"/>
                <Label x:Name="txtIdPredioAgru" Canvas.Left="145" Canvas.Top="70" Width="120"
					Style="{StaticResource RecTxtSoloLectura}"/>
                <Label x:Name="lblEstado" Canvas.Left="285" Canvas.Top="10"
					Content="Estado Nota" Padding="0"/>
                <Label x:Name="txtEstado" Canvas.Left="365" Canvas.Top="10" Width="100"
					Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold"
					HorizontalContentAlignment="Center"/>
                <Label Canvas.Left="570" Canvas.Top="40" Content="Valor Nota" 
                       Padding="0" FontWeight="Bold"/>
                <Label x:Name="txtValorNotaP" Canvas.Left="650" Canvas.Top="40" Width="85"
                       Style="{StaticResource RecTxtSoloLectura}" FontWeight="Bold" 
                       HorizontalContentAlignment="Right"/>
            </Canvas>
            <GridSplitter Grid.Row="1" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
            <TabControl x:Name="tbcNotaCon"  Grid.Row="1"  Style="{StaticResource RecTabCtrl}"
                        Margin="0,5,0,0"  TabItem.MouseUp="OnRatonUp">
                <TabItem x:Name="tbiDetalles" Header="Detalles" 
                              Style="{StaticResource RecTabItem}" Width="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition MinHeight="50"/>
                        </Grid.RowDefinitions>
                        <Canvas x:Name="cnvDatosNotaCon" Grid.Row="0">
                            <Label x:Name="lblIdAnticipo" Canvas.Left="30" Canvas.Top="16" 
                                       Content="Id. del Anticipo" Padding="0"
                                       Style="{StaticResource RecFuenteNormal}"/>
                            <Label x:Name="txtIdAnticipo" Canvas.Left="140" Canvas.Top="15" Width="60"
                                       Style="{StaticResource RecTxtSoloLectura}"/>
                            <Label Content="Nro. Nota Reversión" Padding="0" Canvas.Top="16" Canvas.Left="280"
                                       Style="{StaticResource RecFuenteNormal}"/>
                            <Label x:Name="txtNroNotaRCr" Width="60" HorizontalContentAlignment="Right"
                                   Style="{StaticResource RecTxtSoloLectura}" Canvas.Top="15" 
                                   Canvas.Left="400"/>
                            <Label x:Name="lblUsuarioGenero" Content="Usuario generó Nota" 
                                       Canvas.Top="16" Canvas.Left="520"
                                       Padding="0" Style="{StaticResource RecFuenteNormal}"/>
                            <Label x:Name="txtUsuarioGenero" Canvas.Left="650" Canvas.Top="15" Width="120"
                                       Style="{StaticResource RecTxtSoloLectura}"/>
                        </Canvas>
                        <DataGrid x:Name="dgrItemsNotaCon" Grid.Row="1"
                                      Style="{StaticResource RecFuenteNormal}"
                                      IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                                      ItemsSource="{Binding}" SelectionMode="Extended" SelectionUnit="FullRow"
                                      IsReadOnly="True" Background="Transparent"
                                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                                      Margin="73,5,72,5">
                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="LightGray"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Ordinal" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" 
											Padding="5,0,0,0" IsReadOnly="True" 
											Text="{Binding IdItemNotaCon}"
											HorizontalContentAlignment="Right"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Número Factura" Width="100" x:Name="dgtNroFac">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" 
											Padding="5,0,0,0" IsReadOnly="True" 
											Text="{Binding NroFact}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="It.Fac." Width="70" x:Name="dgtItFac">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" HorizontalAlignment="Left" 
                                                             IsReadOnly="True" Text="{Binding IdItemFactura}"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Detalle" Width="290">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" 
											Padding="5,0,0,0" IsReadOnly="True" 
											Text="{Binding Detalle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Valor" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											HorizontalAlignment="Right" 
											Text="{Binding Valor, StringFormat=\{0:c\}}"
											IsReadOnly="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tbiNovedades" Header="Movimiento Contable" 
                               Style="{StaticResource RecTabItem}" Width="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="30"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgrNovedades" Grid.Row="1" 
                                Style="{StaticResource RecFuenteNormal}"
                                IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                                ItemsSource="{Binding}" SelectionMode="Extended" SelectionUnit="FullRow"
                                IsReadOnly="True" Background="Transparent" TabIndex="7" 
                                ScrollViewer.VerticalScrollBarVisibility="Visible"
                                Margin="5,15,5,0">
                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="LightGray"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Nro. Factura" Width="100" x:Name="dgrNroFacNov" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											HorizontalAlignment="Left" Text="{Binding NroFac}"
											IsReadOnly="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="It.Fac." Width="70" x:Name="dgtItFacNov">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" 
                                                     IsTabStop="False" HorizontalAlignment="Left" 
                                                     IsReadOnly="True" Text="{Binding IdItemFactura}"
                                                     Style="{StaticResource RecFuenteNormal}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Fecha" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False" 
											HorizontalAlignment="Left" IsReadOnly="True"
											Text="{Binding FechaNovedad, StringFormat=\{0:dd/MM/yyyy\}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Detalle" Width="250">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" 
                                                             IsTabStop="False" HorizontalAlignment="Left" 
                                                             Text="{Binding Detalle}"
                                                             IsReadOnly="True"
                                                             Style="{StaticResource RecFuenteNormal}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Cuenta Db" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
											Text="{Binding IdCuentaDb}" IsReadOnly="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Cuenta Cr" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
											Text="{Binding IdCuentaCr}" IsReadOnly="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Valor" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Background="Transparent" BorderThickness="0" IsTabStop="False"
											Text="{Binding Valor, StringFormat=\{0:c\}}" 
											HorizontalAlignment="Right"  
											IsReadOnly="True"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        <!--Area inferior de la ventana-->
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
			IsTabStop="False" HorizontalAlignment="Stretch"  
			Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
