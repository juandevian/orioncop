<src:ClsFormInterface x:Class="WinPropietario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" Icon="RecImagenes/terceros.png"
        Title="Propietario" Height="270" Width="480" GotFocus="OnCogerFoco" 
        LostFocus="OnPierdeFoco" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition MinHeight="20"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <DockPanel x:Name="PanelControl" Grid.Row="0">
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
        </DockPanel>
        <Canvas Grid.Row="1" LostFocus="OnPierdeFoco">
            <Label x:Name="lblIdPropietario" Canvas.Left="25" Canvas.Top="31"
                   Content="Id. Propietario" Padding="0"/>
            <Button x:Name="bttEncontrarProp" Canvas.Left="135" Canvas.Top="30" 
                    Style="{StaticResource RecEstiloBttEnc}" Visibility="Visible" TabIndex="1"
                    ToolTip="Clic aqui para buscar El Propietario."/>
            <TextBox x:Name="txtIdPropietario" Canvas.Left="150" Canvas.Top="30" 
                     Width="110" TabIndex="2"/>
            <Label x:Name="lblNombrePropietario" Canvas.Left="25" Canvas.Top="61" 
                   Content="Nombre Propietario" Padding="0"/>
            <Label x:Name="txtNombrePropietario" Canvas.Left="150" Canvas.Top="60" Width="290"
                   Style="{StaticResource RecTxtSoloLectura}"/>
            <Label x:Name="lblPorcientoProp" Canvas.Left="25" Canvas.Top="91" 
                   Content="Porcentaje propiedad" Padding="0"/>
            <TextBox x:Name="txtPorcientoProp" Canvas.Left="150" Canvas.Top="90" Width="60" 
                     TabIndex="2" HorizontalContentAlignment="Right" />
            <Label Canvas.Left="215" Canvas.Top="91" Content="%" Padding="0"/>
        </Canvas>
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
			IsTabStop="False" HorizontalAlignment="Stretch"  
			Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Canvas Name="cnvBotones" Grid.Row="0">
                <StaticResource ResourceKey="RecCnvAceCan"/>
            </Canvas>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>
