<src:ClsFormInterface x:Class="WinParametrizacion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:src="clr-namespace:OPT.OrionP.OriWin;assembly=OriWin"
    Title="Parametrización" Height="800" Width="1215" WindowStyle="SingleBorderWindow" 
    WindowState="Maximized" WindowStartupLocation="CenterScreen" 
    Icon="RecImagenes/OrionLogo24.png" KeyDown="clsFormInterface_KeyDown" 
    Closing="ClsFormInterface_Closing" FontSize="12">
    <Window.Resources>
        <!--Menues Contextuales-->
        <ContextMenu x:Key="RecMnuCarpetaMC">
            <MenuItem Name="MnuAbrirCtaConC" Header="Abrir Cuentas Contabilidad" Click="MnuContextual_Click"
                  Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/CuentasContabilidad.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="RecMnuCentroUtilMC">
            <MenuItem x:Name="MnuOpcionesCentroUtilC" 
                      Header="Abrir Opciones de la Copropiedad" 
                      Click="MnuContextual_Click"
                      Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/config.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="MnuCrearAnoC" Header="Crear Añ_o" Click="MnuContextual_Click"
                  Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/ano.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="RecMnuTasasMoraMC">
            <MenuItem Name="MnuAbrirTasaMoraC"  Header="Abrir Tasas de Mora" Click="MnuContextual_Click"
                  Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/CondicionesMora.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="RecMnuBancosMC">
            <MenuItem Name="MnuAbrirBancosC"  Header="Abrir Cuentas Bancarias" Click="MnuContextual_Click"
                  Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/CtaBanco.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="RecMnuDocumentosMC">
            <MenuItem Name="MnuAbrirDocumentosC"  Header="Abrir Documentos" Click="MnuContextual_Click"
                  Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/Documentos.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="RecMnuAgrupadorServMC">
            <MenuItem Name="MnuAbrirAgrupServiciosC"  Header="Abrir Concepto Facturación" Click="MnuContextual_Click"
                  Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/AgruServicios.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="RecMnuServicioPerMC">
            <MenuItem Name="MnuAbrirServicioPerC"  Header="Abrir Servicio Permanente" Click="MnuContextual_Click"
                  Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/Servicios.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="RecMnuServicioAnoMC">
            <MenuItem Name="MnuAbrirServicioAnoC"  Header="Abrir Servicio Anual" Click="MnuContextual_Click"
                  Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/Servicios.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="RecMnuAnoMC">
            <MenuItem Name="MnuAbrirAnoC" Header="Abrir Año" Click="MnuContextual_Click"
                  Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/ano.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Name="MnuSuprimirAnoC" Header="Suprimir Año" Click="MnuContextual_Click"
                  Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/ano.png"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Name="MnuAbrirServicioAnoCN" Header="Abrir Servicio Anual" 
                  Click="MnuContextual_Click" Style="{StaticResource RecMnuItemSec}">
                <MenuItem.Icon>
                    <Image Source="RecImagenes/Servicios.png"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <Grid Name="grdPpal"  MenuItem.Click="OnMenuClic" Control.GotFocus="OnCogerFoco">
        <Grid.RowDefinitions>
            <RowDefinition Name="rwdControl" Height="120"/>
            <RowDefinition MinHeight="100" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <StaticResource ResourceKey="RecImgCabeza" />
        <StaticResource ResourceKey="RecImgCuerpo" />
        <!--ToolBar y Menu-->
        <DockPanel x:Name="PanelControl" Grid.Row="0" >
            <!--ToolBar-->
            <StaticResource ResourceKey="RecToolBarPan"/>
            <!--Label Notificaciones-->
            <StaticResource ResourceKey="RecNotifica"/>
            <!--Menu-->
            <Menu x:Name="MenuVen"  DockPanel.Dock="Bottom" Background="Gray" Height="25"
                  VerticalAlignment="Center">
                <MenuItem Header="_Acciones" x:Name="MnuAcciones" Style="{StaticResource RecMnuItemPri}">
                    <MenuItem Header="Expandir Todo" x:Name="MnuExpandirTodo" Style="{StaticResource RecMnuItemSec}"
        				InputGestureText="Ctrl+E"/>
                    <MenuItem Header="Expandir Rama" x:Name="MnuExpandirRama" Style="{StaticResource RecMnuItemSec}"/>
                    <MenuItem Header="Contraer Todo" x:Name="MnuContraerTodo" Style="{StaticResource RecMnuItemSec}"
        				InputGestureText="Ctrl+C"/>
                    <MenuItem Header="Contraer Rama" x:Name="MnuContraerRama" Style="{StaticResource RecMnuItemSec}"/>
                    <Separator />
                    <MenuItem Header="_Refrescar" x:Name="MnuRefrescar" ToolTip="Lee de nuevo la información de la Base de Datos" 
        				Tag ="256" Style="{StaticResource RecMnuItemSec}">
                        <MenuItem.Icon>
                            <Image Source="RecImagenes/refrescar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="_Cerrar" x:Name="MnuCerrar" ToolTip="Cerrar la Ventana" 
        				Style="{StaticResource RecMnuItemSec}">
                        <MenuItem.Icon>
                            <Image Source="RecImagenes/cerrar.png"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <!--<MenuItem Header="_Tablas Auxiliares" x:Name="MnuTablasAuxiliares" 
                          Style="{StaticResource RecMnuItemPri}">
                    <MenuItem Header="Sec_tores" x:Name="MnuSectores" 
                              Style="{StaticResource RecMnuItemSec}" />
                    <MenuItem Header="_Módulos de Contribución" x:Name="MnuModulos" 
                              Style="{StaticResource RecMnuItemSec}"/>
                    <Separator/>
                    <MenuItem Header="_Terceros" x:Name="MnuTerceros" 
                              Style="{StaticResource RecMnuItemSec}">
                        <MenuItem.Icon>
                            <Image Source="RecImagenes/terceros.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Ubicaciones" x:Name="MnuUbicaciones" 
                              Style="{StaticResource RecMnuItemSec}" />
                    <Separator/>
                    <MenuItem Header="_Opciones Copias de Seguridad"  x:Name="MnuOpcionesBK" 
                              Style="{StaticResource RecMnuItemSec}" />
                </MenuItem>-->
            </Menu>
        </DockPanel>
        <Grid Grid.Row="1" ButtonBase.Click="OnBotonClic">
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition MinHeight="200"/>
            </Grid.RowDefinitions>
            <DockPanel Height="26" Grid.Row="0">
                <Border BorderBrush="Gray" BorderThickness="1">
                    <Canvas>
                        <!--txtTrayectoria-->
                        <TextBox x:Name="txtTrayectoria" Canvas.Left="20" Canvas.Top="2"
                                 Width="800" HorizontalContentAlignment="Left" BorderThickness="0"
                                 VerticalContentAlignment="Center" Background="Transparent" 
                                 Foreground="Black" IsTabStop="False"/>
                        <Button x:Name="bttAbrirWinAyuda" Canvas.Right="100" Canvas.Top="1" 
                                    Padding="0" Margin="0" Width="180" Height="20" TabIndex="50">
                            <DockPanel Width="170">
                                <Image Source="RecImagenes/ayuda.png" Width="18" Height="18"
                                           HorizontalAlignment="Left" DockPanel.Dock="Left" 
                                           Margin="3,0,0,0"/>
                                <Label Content="Abrir ventana ayuda" Background="Transparent" 
                                           Padding="0" DockPanel.Dock="Right" Margin="5,0,0,0"
                                           VerticalContentAlignment="Center" IsTabStop="False"/>
                            </DockPanel>
                        </Button>
                    </Canvas>
                </Border>
            </DockPanel>
            <Grid Grid.Row="1"  TreeView.SelectedItemChanged="OnCambioSeleccion" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" x:Name="cldTreeView" />
                    <ColumnDefinition Width="619*" x:Name="cldList"/>
                    <ColumnDefinition Width="23*"/>
                    <ColumnDefinition Width="14*"/>
                    <ColumnDefinition Width="95*"/>
                    <ColumnDefinition Width="107*"/>
                </Grid.ColumnDefinitions>
                <!--TreeView-->
                <TreeView x:Name="trvOrionCop" Grid.Column="0" BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" 
                          TabIndex="3" Margin="0,0,0,-0.333">
                </TreeView>
                <!--ListView-->
                <ListView x:Name="lvOrionCop" Grid.Column="1" 
                          BorderThickness="0" ItemsSource="{Binding}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" 
                          Background="Transparent" TabIndex="4" Grid.ColumnSpan="5" Margin="0,0,0,-0.333">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="gvcPropiedad" Header="Propiedad" Width="300"
                                    DisplayMemberBinding="{Binding Path=StrPropiedad}"/>
                            <GridViewColumn x:Name="gvcValor" Header="Valor" Width="500"
                                    DisplayMemberBinding="{Binding Path=StrValor}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <GridSplitter Grid.Column="0" Background="Gray" HorizontalAlignment="Right" 
                              VerticalAlignment="Stretch" IsTabStop="False" 
                              ShowsPreview="True" Width="2" Opacity=".5"
                              MouseEnter="GridSplitter_MouseEnter" 
                              MouseLeave="GridSplitter_MouseLeave" Margin="0,0,0,-0.333"/>
            </Grid>
        </Grid>
        <GridSplitter Grid.Row="2" Background="Gray" VerticalAlignment="Top" 
				IsTabStop="False" HorizontalAlignment="Stretch"  
				Height="2" Opacity=".5"/>
        <Grid Grid.Row="2" x:Name="grdPieVentana">
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <StaticResource ResourceKey="RecDcpPiePaginaGral"/>
        </Grid>
    </Grid>
</src:ClsFormInterface>